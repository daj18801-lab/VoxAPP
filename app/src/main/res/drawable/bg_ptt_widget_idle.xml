<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle outer shadow ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#3300D4FF" />
        </shape>
    </item>
    <!-- Main dark walkie-talkie badge -->
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:endColor="#0A1628"
                android:startColor="#172A4A"
                android:type="linear" />
            <stroke
                android:width="2.5dp"
                android:color="#00C4FF" />
        </shape>
    </item>
</layer-list>
