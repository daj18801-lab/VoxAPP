<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ptt_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/ptt_widget_button"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_ptt_widget_idle"
        android:clickable="true"
        android:contentDescription="@string/ptt_widget_toggle_desc"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <ImageView
            android:id="@+id/ptt_widget_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/ptt_widget_toggle_desc"
            android:src="@drawable/ic_ptt_widget_mic" />

        <TextView
            android:id="@+id/ptt_widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/ptt_widget_idle_label"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/ptt_widget_peer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="#AA0A1628"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="6dp"
        android:paddingTop="1dp"
        android:paddingEnd="6dp"
        android:paddingBottom="1dp"
        android:text="@string/ptt_widget_ready_label"
        android:textColor="#E2F1FF"
        android:textSize="9sp"
        android:textStyle="bold" />

</LinearLayout>
