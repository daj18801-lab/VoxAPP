rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL PRIMITIVE HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isStr(v, minL, maxL) {
      return v is string && v.size() >= minL && v.size() <= maxL;
    }

    function isNonNeg(v) {
      return v is int && v >= 0;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBoundedStringList(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || arr[0] is string);
    }

    function isValidHexColor(c) {
      return c is string && c.size() == 7 && c.matches('^#[0-9A-Fa-f]{6}$');
    }

    function isValidDayKey(s) {
      return s is string && (s == '' || (s.size() == 10 && s.matches('^20[2-9][0-9]-[0-1][0-9]-[0-3][0-9]$')));
    }

    function isValidReferralCode(s) {
      return s is string && (s == '' || (s.size() >= 4 && s.size() <= 24 && s.matches('^[A-Z0-9\\-]+$')));
    }

    // Bootstrapped primary administrator (strictly requires verified email)
    function isBootstrappedAdmin() {
      return isSignedIn() &&
             request.auth.token.get('email', '') == 'daj18801@gmail.com' &&
             request.auth.token.get('email_verified', false) == true;
    }

    function hasVerifiedEmail() {
      return isSignedIn() && request.auth.token.get('email_verified', false) == true;
    }

    function hasStaffRoleDoc(uid) {
      return exists(/databases/$(database)/documents/staffRoles/$(uid));
    }

    function staffRoleData(uid) {
      return get(/databases/$(database)/documents/staffRoles/$(uid)).data;
    }

    function isAdmin() {
      return isBootstrappedAdmin() ||
             (isSignedIn() &&
              hasStaffRoleDoc(request.auth.uid) &&
              staffRoleData(request.auth.uid).staffTier == 'ADMIN');
    }

    function isSupport() {
      return isSignedIn() &&
             hasStaffRoleDoc(request.auth.uid) &&
             staffRoleData(request.auth.uid).staffTier == 'SUPPORT';
    }

    function isAdminOrSupport() {
      return isBootstrappedAdmin() ||
             (isSignedIn() &&
              hasStaffRoleDoc(request.auth.uid) &&
              staffRoleData(request.auth.uid).staffTier in ['ADMIN', 'SUPPORT']);
    }

    function isTargetAdmin(uid) {
      return hasStaffRoleDoc(uid) && staffRoleData(uid).staffTier == 'ADMIN';
    }

    // Admin always allowed invisible mode; Support allowed ONLY if Admin granted canEnterInvisible == true
    function canUseInvisibleMode() {
      return isBootstrappedAdmin() ||
             (isSignedIn() && hasStaffRoleDoc(request.auth.uid) && (
               staffRoleData(request.auth.uid).staffTier == 'ADMIN' ||
               (staffRoleData(request.auth.uid).staffTier == 'SUPPORT' &&
                ('canEnterInvisible' in staffRoleData(request.auth.uid)) &&
                staffRoleData(request.auth.uid).canEnterInvisible == true)
             ));
    }

    function isAllowedStaffTierClaim(tier) {
      return tier == 'USER' ||
             (tier == 'SUPPORT' && isAdminOrSupport()) ||
             (tier == 'ADMIN' && isAdmin());
    }

    // --- CALLER PROFILE RESTRICTION & SUSPENSION ENFORCEMENT ---
    function callerProfileExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSubAccountProfile(p) {
      return ('companySubAccount' in p) && p.companySubAccount == true;
    }

    function isCallerSubAccount() {
      return callerProfileExists() && isSubAccountProfile(callerProfile());
    }

    function isProfileAllowed(p, checkCreate, checkEnter, checkMic, checkVideo) {
      return (!('globallyBanned' in p) || p.globallyBanned == false) &&
             (!('suspendedUntilMillis' in p) || p.suspendedUntilMillis <= request.time.toMillis()) &&
             (!checkCreate || ((!('disableCreateRoom' in p) || p.disableCreateRoom == false) && !isSubAccountProfile(p))) &&
             (!checkEnter || ((!('disableEnterRoom' in p) || p.disableEnterRoom == false) && !isSubAccountProfile(p))) &&
             (!checkMic || !('disableMic' in p) || p.disableMic == false) &&
             (!checkVideo || !('disableVideo' in p) || p.disableVideo == false);
    }

    function isModFileSuspended(uid) {
      let path = /databases/$(database)/documents/userModerationFiles/$(uid);
      return exists(path) && (
        (('suspendedUntilInvestigationResolved' in get(path).data) &&
         get(path).data.suspendedUntilInvestigationResolved == true) ||
        (('suspendedUntilMillis' in get(path).data) &&
         get(path).data.suspendedUntilMillis > request.time.toMillis())
      );
    }

    function callerPassesProfileChecks(checkCreate, checkEnter, checkMic, checkVideo) {
      return isAdmin() || (
        (!callerProfileExists() ||
         isProfileAllowed(callerProfile(), checkCreate, checkEnter, checkMic, checkVideo)) &&
        !isModFileSuspended(request.auth.uid)
      );
    }

    function callerCanSendMessage() {
      return isAdmin() || (
        (!callerProfileExists() ||
         (isProfileAllowed(callerProfile(), false, false, false, false) &&
          (!('disableMessaging' in callerProfile()) || callerProfile().disableMessaging == false))) &&
        !isModFileSuspended(request.auth.uid)
      );
    }

    function isCallerGloballyBanned() {
      return callerProfileExists() &&
             ('globallyBanned' in callerProfile()) &&
             callerProfile().globallyBanned == true;
    }

    function isAdultVerifiedProfile(p) {
      return ('adultVerified' in p) &&
             p.adultVerified == true &&
             ('birthYear' in p) &&
             p.birthYear is int &&
             p.birthYear >= 1900 &&
             p.birthYear <= request.time.year() - 18;
    }

    function isAge13VerifiedProfile(p) {
      let by = p.get('birthYear', 0);
      let ag = p.get('age', 0);
      return (p.get('age13Verified', false) == true && (by == 0 || (by >= 1900 && by <= request.time.year() - 13))) ||
             (by >= 1900 && by <= request.time.year() - 13) ||
             (ag >= 13 && ag <= 120);
    }

    function isAdultVerifiedCaller() {
      return callerProfileExists() && isAdultVerifiedProfile(callerProfile());
    }

    function roomDoc(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId));
    }

    function roomExists(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId));
    }

    function isRoomHostOrMod(roomId) {
      let room = roomDoc(roomId).data;
      return room.hostId == request.auth.uid ||
             request.auth.uid in room.moderatorIds ||
             isAdminOrSupport();
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---
    function existingInt(doc, field) {
      return (field in doc && doc[field] is int) ? doc[field] : 0;
    }

    function isBouncedFromRoom(roomData, uid) {
      return ('bouncedUntilByUserId' in roomData) &&
             (roomData.bouncedUntilByUserId is map) &&
             (uid in roomData.bouncedUntilByUserId) &&
             (roomData.bouncedUntilByUserId[uid] is int) &&
             (roomData.bouncedUntilByUserId[uid] > request.time.toMillis());
    }

    function isValidPictureTimestampList(arr) {
      return arr is list &&
             arr.size() <= 10 &&
             (arr.size() == 0 || (arr[0] is int && arr[0] > 0 && arr[0] <= request.time.toMillis() + 60000)) &&
             (arr.size() < 2 || (arr[arr.size() - 1] is int && arr[arr.size() - 1] >= arr[0] && arr[arr.size() - 1] <= request.time.toMillis() + 60000));
    }

    function canUpdatePictureUploadTimestamps(newData, oldData, diffKeys) {
      return !('pictureUploadTimestamps' in diffKeys) ||
             !('pictureUploadTimestamps' in oldData) ||
             oldData.pictureUploadTimestamps.size() == 0 ||
             oldData.pictureUploadTimestamps[0] <= request.time.toMillis() - 600000 ||
             (newData.pictureUploadTimestamps.size() >= oldData.pictureUploadTimestamps.size() &&
              newData.pictureUploadTimestamps[0] == oldData.pictureUploadTimestamps[0]);
    }

    function callerUnderPictureUploadLimit() {
      return !callerProfileExists() || isUnderPicLimit(callerProfile());
    }

    function isUnderPicLimit(p) {
      return !('pictureUploadTimestamps' in p) ||
             p.pictureUploadTimestamps.size() < 10 ||
             p.pictureUploadTimestamps[0] <= request.time.toMillis() - 600000;
    }

    function isValidDiscoveryPhotoTimestampList(arr) {
      return arr is list &&
             arr.size() <= 2 &&
             (arr.size() == 0 || (arr[0] is int && arr[0] > 0 && arr[0] <= request.time.toMillis() + 60000)) &&
             (arr.size() < 2 || (arr[arr.size() - 1] is int && arr[arr.size() - 1] >= arr[0] && arr[arr.size() - 1] <= request.time.toMillis() + 60000));
    }

    function canUpdateDiscoveryPhotoTimestamps(newData, oldData, diffKeys) {
      return !('discoveryPhotoTimestamps' in diffKeys) ||
             !('discoveryPhotoTimestamps' in oldData) ||
             oldData.discoveryPhotoTimestamps.size() == 0 ||
             oldData.discoveryPhotoTimestamps[0] <= request.time.toMillis() - 604800000 ||
             (newData.discoveryPhotoTimestamps.size() >= oldData.discoveryPhotoTimestamps.size() &&
              newData.discoveryPhotoTimestamps[0] == oldData.discoveryPhotoTimestamps[0]);
    }

    function isProProfileData(p) {
      return !isSubAccountProfile(p) && (
        (('proLifetime' in p) && p.proLifetime == true) ||
        (('proMember' in p) && p.proMember == true &&
         existingInt(p, 'proExpiresAtMillis') > request.time.toMillis())
      );
    }

    function isVipProOrAdminCaller() {
      return isAdmin() || (callerProfileExists() && effectiveProTier(callerProfile()) in ['VIP_PRO', 'ELITE_PRO']);
    }

    function effectiveProTier(p) {
      return !isProProfileData(p) ? 'FREE'
        : (('proTier' in p) && p.proTier in ['PRO', 'VIP_PRO', 'ELITE_PRO'] ? p.proTier : 'PRO');
    }

    function tierMaxMembers(t) {
      return t == 'ELITE_PRO' ? 50 : (t == 'VIP_PRO' ? 25 : (t == 'PRO' ? 15 : 7));
    }

    function tierMaxPrivateRoom(t) {
      return t == 'ELITE_PRO' ? 100 : (t == 'VIP_PRO' ? 75 : (t == 'PRO' ? 50 : 25));
    }

    function groupMaxMembersForUid(uid) {
      return isTargetAdmin(uid) ? 50
        : (exists(/databases/$(database)/documents/users/$(uid))
            ? tierMaxMembers(effectiveProTier(get(/databases/$(database)/documents/users/$(uid)).data))
            : 7);
    }

    function privateRoomCapForHost(uid) {
      return isTargetAdmin(uid) ? 100
        : (exists(/databases/$(database)/documents/users/$(uid))
            ? tierMaxPrivateRoom(effectiveProTier(get(/databases/$(database)/documents/users/$(uid)).data))
            : 25);
    }

    function isProCaller() {
      return isAdminOrSupport() ||
             (callerProfileExists() && isProProfileData(callerProfile()));
    }

    function isAllowedProDirectoryClaim(data) {
      let uPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let afterOk = existsAfter(uPath);
      let claimTier = ('proTier' in data) ? data.proTier : 'FREE';
      return (!('proMember' in data) ||
              data.proMember == false ||
              isProCaller() ||
              (afterOk && isProProfileData(getAfter(uPath).data))) &&
             (!('proLifetime' in data) ||
              data.proLifetime == false ||
              isAdmin() ||
              (callerProfileExists() && ('proLifetime' in callerProfile()) && callerProfile().proLifetime == true)) &&
             (claimTier == 'FREE' ||
              isAdmin() ||
              (callerProfileExists() && effectiveProTier(callerProfile()) == claimTier) ||
              (afterOk && effectiveProTier(getAfter(uPath).data) == claimTier));
    }

    function isAllowedBoostedProfileDirectoryClaim(data) {
      let claimed = existingInt(data, 'profileBoostedUntilMillis');
      return claimed == 0 ||
             isAdmin() ||
             (callerProfileExists() && existingInt(callerProfile(), 'profileBoostedUntilMillis') >= claimed) ||
             (existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              existingInt(getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data, 'profileBoostedUntilMillis') >= claimed);
    }

    function isAllowedSpotlightFrameDirectoryClaim(data) {
      let claimed = existingInt(data, 'spotlightFrameUntilMillis');
      return claimed == 0 ||
             isAdmin() ||
             (callerProfileExists() && existingInt(callerProfile(), 'spotlightFrameUntilMillis') >= claimed) ||
             (existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              existingInt(getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data, 'spotlightFrameUntilMillis') >= claimed);
    }

    function isPaidProfileData(p) {
      return existingInt(p, 'totalSpentCents') > 0 ||
             existingInt(p, 'pointsBalance') > 0 ||
             isProProfileData(p);
    }

    function isUnderWeeklyDiscoveryPhotoLimit(p) {
      return !('discoveryPhotoTimestamps' in p) ||
             p.discoveryPhotoTimestamps.size() < 2 ||
             p.discoveryPhotoTimestamps[0] <= request.time.toMillis() - 604800000;
    }

    function callerCanUploadPostImage() {
      return !callerProfileExists() ||
             callerProfilePassesImageLimits(callerProfile());
    }

    function callerProfilePassesImageLimits(p) {
      return isUnderPicLimit(p) &&
             (isPaidProfileData(p) || isUnderWeeklyDiscoveryPhotoLimit(p) || isAdminOrSupport());
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
               'userId', 'displayName', 'handle', 'bio', 'avatarColorHex',
               'pushToTalkPreferred', 'darkThemePreferred', 'blockedUserIds',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'displayName', 'handle', 'bio', 'avatarColorHex', 'photoBase64',
               'pushToTalkPreferred', 'darkThemePreferred', 'nightModeEnabled', 'invisibleModePreferred',
               'globallyBanned', 'disableCreateRoom', 'disableEnterRoom',
               'disableMic', 'disableVideo', 'disableMessaging', 'lastDeviceId',
               'addPeopleTimestamps', 'spamViolationTimestamps',
               'suspendedUntilMillis', 'suspensionReason',
               'pointsBalance', 'halfPointsBalance', 'creatorEarnedPoints', 'creatorEarningsCents', 'totalSpentCents',
               'proMember', 'proExpiresAtMillis', 'proLifetime', 'proTier',
               'customDisplayName', 'customNameColorHex', 'customMembershipTier',
               'companySubAccount', 'parentCompanyOwnerId', 'companyName', 'companyThreadId', 'subAccountId', 'doNotDisturb',
               'profileViewersUnlockedUntilMillis', 'priorityChirpOptIn', 'profileBoostedUntilMillis',
               'spotlightFrameUntilMillis', 'spotlightFrameColorHex',
               'loginStreakDays', 'lastLoginDayKey', 'lastStreakRewardDayKey',
               'referralCode', 'referredByUserId', 'referralBonusClaimed', 'referralEarnedPoints',
               'ownedPttThemes', 'selectedPttTheme', 'ownedPttChirps', 'selectedPttChirp',
               'dmPolicy',
               'age13Verified', 'adultVerified', 'birthYear', 'sex', 'age', 'totalTimeSpentSec', 'appearanceStatus',
               'blockedUserIds', 'pictureUploadTimestamps', 'discoveryPhotoTimestamps', 'createdAt', 'updatedAt'
             ]) &&
             isStr(data.userId, 1, 128) && isStr(data.displayName, 1, 40) &&
             isStr(data.handle, 2, 30) && isStr(data.bio, 0, 200) &&
             isValidHexColor(data.avatarColorHex) &&
             (!('photoBase64' in data) || isStr(data.photoBase64, 0, 140000)) &&
             data.pushToTalkPreferred is bool && data.darkThemePreferred is bool &&
             (!('nightModeEnabled' in data) || data.nightModeEnabled is bool) &&
             (!('invisibleModePreferred' in data) || data.invisibleModePreferred is bool) &&
             (!('disableMessaging' in data) || data.disableMessaging is bool) &&
             (!('lastDeviceId' in data) || isStr(data.lastDeviceId, 0, 128)) &&
             (!('addPeopleTimestamps' in data) || (data.addPeopleTimestamps is list && data.addPeopleTimestamps.size() <= 30)) &&
             (!('spamViolationTimestamps' in data) || (data.spamViolationTimestamps is list && data.spamViolationTimestamps.size() <= 20)) &&
             (!('priorityChirpOptIn' in data) || data.priorityChirpOptIn is bool) &&
             (!('spotlightFrameColorHex' in data) || isValidHexColor(data.spotlightFrameColorHex)) &&
             (!('referralCode' in data) || isValidReferralCode(data.referralCode)) &&
             (!('dmPolicy' in data) || data.dmPolicy in ['OPEN', 'PAID', 'DISABLED']) &&
             (!('age13Verified' in data) || (data.age13Verified is bool && (!data.age13Verified || isAge13VerifiedProfile(data)))) &&
             (!('adultVerified' in data) || (data.adultVerified is bool && (!data.adultVerified || isAdultVerifiedProfile(data)))) &&
             (!('birthYear' in data) || (data.birthYear is int && (data.birthYear == 0 || (data.birthYear >= 1900 && data.birthYear <= request.time.year())))) &&
             (!('sex' in data) || data.sex in ['UNSPECIFIED', 'MALE', 'FEMALE']) &&
             (!('age' in data) || (data.age is int && (data.age == 0 || (data.age >= 13 && data.age <= 120)))) &&
             (!('appearanceStatus' in data) || data.appearanceStatus in ['ONLINE', 'IDLE', 'OFFLINE']) &&
             (!('proTier' in data) || data.proTier in ['FREE', 'PRO', 'VIP_PRO', 'ELITE_PRO']) &&
             (!('customDisplayName' in data) || isStr(data.customDisplayName, 0, 40)) &&
             (!('customNameColorHex' in data) || data.customNameColorHex == '' || isValidHexColor(data.customNameColorHex)) &&
             (!('customMembershipTier' in data) || data.customMembershipTier in ['', 'FREE', 'PRO', 'VIP_PRO', 'ELITE_PRO', 'SUPPORT', 'ADMIN']) &&
             (!('companySubAccount' in data) || data.companySubAccount is bool) &&
             (!('parentCompanyOwnerId' in data) || isStr(data.parentCompanyOwnerId, 0, 128)) &&
             (!('companyName' in data) || isStr(data.companyName, 0, 60)) &&
             (!('companyThreadId' in data) || isStr(data.companyThreadId, 0, 260)) &&
             (!('subAccountId' in data) || isStr(data.subAccountId, 0, 128)) &&
             (!('doNotDisturb' in data) || data.doNotDisturb is bool) &&
             isBoundedStringList(data.blockedUserIds, 100) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function hasNoSelfRestrictionOverrides(data) {
      return (!('globallyBanned' in data) || data.globallyBanned == false) &&
             (!('disableCreateRoom' in data) || data.disableCreateRoom == false) &&
             (!('disableEnterRoom' in data) || data.disableEnterRoom == false) &&
             (!('disableMic' in data) || data.disableMic == false) &&
             (!('disableVideo' in data) || data.disableVideo == false) &&
             (!('disableMessaging' in data) || data.disableMessaging == false) &&
             (!('companySubAccount' in data) || data.companySubAccount == false) &&
             (!('suspendedUntilMillis' in data) || data.suspendedUntilMillis == 0) &&
             (!('suspensionReason' in data) || data.suspensionReason == '') &&
             (!('pointsBalance' in data) || data.pointsBalance == 0) &&
             (!('halfPointsBalance' in data) || data.halfPointsBalance == 0) &&
             (!('creatorEarnedPoints' in data) || data.creatorEarnedPoints == 0) &&
             (!('creatorEarningsCents' in data) || data.creatorEarningsCents == 0) &&
             (!('totalSpentCents' in data) || data.totalSpentCents == 0) &&
             (!('proMember' in data) || data.proMember == false) &&
             (!('proExpiresAtMillis' in data) || data.proExpiresAtMillis == 0) &&
             (!('proLifetime' in data) || data.proLifetime == false) &&
             (!('proTier' in data) || data.proTier == 'FREE') &&
             (!('profileViewersUnlockedUntilMillis' in data) || data.profileViewersUnlockedUntilMillis == 0) &&
             (!('profileBoostedUntilMillis' in data) || data.profileBoostedUntilMillis == 0) &&
             (!('spotlightFrameUntilMillis' in data) || data.spotlightFrameUntilMillis == 0) &&
             (!('loginStreakDays' in data) || data.loginStreakDays == 0) &&
             (!('lastLoginDayKey' in data) || data.lastLoginDayKey == '') &&
             (!('lastStreakRewardDayKey' in data) || data.lastStreakRewardDayKey == '') &&
             (!('referredByUserId' in data) || data.referredByUserId == '') &&
             (!('referralBonusClaimed' in data) || data.referralBonusClaimed == false) &&
             (!('referralEarnedPoints' in data) || data.referralEarnedPoints == 0) &&
             (!('ownedPttThemes' in data) || data.ownedPttThemes.size() == 0) &&
             (!('selectedPttTheme' in data) || data.selectedPttTheme == 'CLASSIC') &&
             (!('ownedPttChirps' in data) || data.ownedPttChirps.size() == 0) &&
             (!('selectedPttChirp' in data) || data.selectedPttChirp == 'STANDARD') &&
             (!('pictureUploadTimestamps' in data) || data.pictureUploadTimestamps.size() == 0) &&
             (!('discoveryPhotoTimestamps' in data) || data.discoveryPhotoTimestamps.size() == 0) &&
             (!('totalTimeSpentSec' in data) || data.totalTimeSpentSec == 0);
    }

    function isValidStaffRole(data) {
      return data.keys().hasAll(['userId', 'email', 'displayName', 'staffTier', 'addedByUid', 'addedByName', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['userId', 'email', 'displayName', 'staffTier', 'canEnterInvisible', 'addedByUid', 'addedByName', 'inviteId', 'createdAt', 'updatedAt']) &&
             isStr(data.userId, 1, 128) && isStr(data.email, 0, 120) && isStr(data.displayName, 1, 40) &&
             data.staffTier in ['ADMIN', 'SUPPORT'] &&
             (!('canEnterInvisible' in data) || data.canEnterInvisible is bool) &&
             isStr(data.addedByUid, 1, 128) && isStr(data.addedByName, 1, 40) &&
             (!('inviteId' in data) || isStr(data.inviteId, 0, 128)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidStaffInvite(data) {
      return data.keys().hasAll(['email', 'displayName', 'staffTier', 'addedByUid', 'addedByName', 'createdAt']) &&
             data.keys().hasOnly(['email', 'displayName', 'staffTier', 'canEnterInvisible', 'addedByUid', 'addedByName', 'createdAt']) &&
             isStr(data.email, 3, 120) && isStr(data.displayName, 1, 40) &&
             data.staffTier in ['ADMIN', 'SUPPORT'] &&
             (!('canEnterInvisible' in data) || data.canEnterInvisible is bool) &&
             isStr(data.addedByUid, 1, 128) && isStr(data.addedByName, 1, 40) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidUserAlert(data) {
      let k = [
        'targetUserId', 'targetName', 'senderId', 'senderName', 'senderTier',
        'roomId', 'title', 'message', 'severity', 'acknowledged',
        'createdAt', 'updatedAt'
      ];
      return data.keys().hasAll(k) && data.keys().hasOnly(k) &&
             isStr(data.targetUserId, 1, 128) && isStr(data.targetName, 1, 40) &&
             isStr(data.senderId, 1, 128) && isStr(data.senderName, 1, 40) &&
             data.senderTier in ['ADMIN', 'SUPPORT'] &&
             isStr(data.roomId, 0, 128) && isStr(data.title, 1, 60) && isStr(data.message, 1, 300) &&
             data.severity in ['INFO', 'WARNING', 'URGENT'] &&
             data.acknowledged is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidRoom(data) {
      return data.keys().hasAll([
               'hostId', 'hostName', 'title', 'topic', 'category', 'coverKey',
               'visibility', 'status', 'videoEnabled', 'autoModEnabled',
               'autoModBlockMode', 'linksBlocked', 'roomLocked', 'stageMicLocked',
               'slowModeSeconds', 'maxSpeakers', 'participantCount',
               'moderatorIds', 'bannedUserIds', 'mutedUserIds', 'blockedWords',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'hostId', 'hostName', 'hostTier', 'title', 'topic', 'category', 'coverKey',
               'visibility', 'status', 'videoEnabled', 'autoModEnabled',
               'autoModBlockMode', 'linksBlocked', 'roomLocked', 'stageMicLocked',
               'adminMicPriorityActive', 'slowModeSeconds', 'maxSpeakers', 'participantCount',
               'moderatorIds', 'bannedUserIds', 'bannedNamesByUserId', 'bouncedUntilByUserId',
               'bouncedNamesByUserId', 'pinLocked', 'roomPinCode', 'mutedUserIds', 'blockedWords',
               'createdAt', 'updatedAt'
             ]) &&
             isStr(data.hostId, 1, 128) && isStr(data.hostName, 1, 40) &&
             (!('hostTier' in data) || data.hostTier in ['USER', 'SUPPORT', 'ADMIN']) &&
             isStr(data.title, 0, 60) && isStr(data.topic, 0, 160) &&
             data.category in ['VOICE_VIDEO', 'MUSIC', 'TECH', 'LOUNGE', 'GAMING', 'LANGUAGE', 'SAFE_SPACE'] &&
             data.coverKey in ['HERO', 'MUSIC', 'TECH', 'DEBATE'] &&
             data.visibility in ['PUBLIC', 'PRIVATE'] &&
             data.status in ['LIVE', 'CLOSED'] &&
             data.videoEnabled is bool &&
             data.autoModEnabled is bool &&
             data.autoModBlockMode is bool &&
             data.linksBlocked is bool &&
             data.roomLocked is bool &&
             data.stageMicLocked is bool &&
             (!('adminMicPriorityActive' in data) || data.adminMicPriorityActive is bool) &&
             data.slowModeSeconds is int && data.slowModeSeconds in [0, 3, 10, 30] &&
             data.maxSpeakers is int && data.maxSpeakers >= 2 && data.maxSpeakers <= 12 &&
             data.participantCount is int && data.participantCount >= 0 && data.participantCount <= 1000 &&
             isBoundedStringList(data.moderatorIds, 20) &&
             data.hostId in data.moderatorIds &&
             isBoundedStringList(data.bannedUserIds, 100) &&
             (!('bannedNamesByUserId' in data) || (data.bannedNamesByUserId is map && data.bannedNamesByUserId.size() <= 100)) &&
             (!('bouncedUntilByUserId' in data) || (data.bouncedUntilByUserId is map && data.bouncedUntilByUserId.size() <= 100)) &&
             (!('bouncedNamesByUserId' in data) || (data.bouncedNamesByUserId is map && data.bouncedNamesByUserId.size() <= 100)) &&
             (!('pinLocked' in data) || data.pinLocked is bool) &&
             (!('roomPinCode' in data) || (data.roomPinCode is string && (data.roomPinCode == '' || (data.roomPinCode.size() == 4 && data.roomPinCode.matches('^[0-9]{4}$'))))) &&
             (!('pinLocked' in data) || !data.pinLocked || (('roomPinCode' in data) && data.roomPinCode is string && data.roomPinCode.size() == 4)) &&
             isBoundedStringList(data.mutedUserIds, 100) &&
             isBoundedStringList(data.blockedWords, 50) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidParticipant(data) {
      return data.keys().hasAll([
               'userId', 'roomId', 'displayName', 'avatarColorHex', 'role',
               'micActive', 'camActive', 'handRaised', 'mutedByMod',
               'speakingLevel', 'joinedAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'roomId', 'displayName', 'avatarColorHex', 'role',
               'staffTier', 'invisible', 'enteredPin', 'micActive', 'camActive', 'handRaised',
               'mutedByMod', 'speakingLevel', 'joinedAt', 'updatedAt'
             ]) &&
             isStr(data.userId, 1, 128) && isStr(data.roomId, 1, 128) && isStr(data.displayName, 1, 40) &&
             isValidHexColor(data.avatarColorHex) &&
             data.role in ['HOST', 'MODERATOR', 'SPEAKER', 'LISTENER'] &&
             (!('staffTier' in data) || data.staffTier in ['USER', 'SUPPORT', 'ADMIN']) &&
             (!('invisible' in data) || data.invisible is bool) &&
             (!('enteredPin' in data) || (data.enteredPin is string && (data.enteredPin == '' || data.enteredPin.matches('^[0-9]{4}$')))) &&
             data.micActive is bool &&
             data.camActive is bool &&
             data.handRaised is bool &&
             data.mutedByMod is bool &&
             (data.speakingLevel is number) && data.speakingLevel >= 0.0 && data.speakingLevel <= 1.0 &&
             data.joinedAt is timestamp && data.joinedAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMessage(data) {
      return data.keys().hasAll([
               'roomId', 'senderId', 'senderName', 'senderRole', 'text',
               'messageType', 'flaggedByAutoMod', 'deletedByMod',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'roomId', 'senderId', 'senderName', 'senderRole', 'senderTier',
               'text', 'messageType', 'flaggedByAutoMod', 'deletedByMod',
               'reactionsByEmoji', 'createdAt', 'updatedAt'
             ]) &&
             isStr(data.roomId, 1, 128) && isStr(data.senderId, 1, 128) && isStr(data.senderName, 1, 40) &&
             data.senderRole in ['HOST', 'MODERATOR', 'SPEAKER', 'LISTENER', 'SYSTEM'] &&
             (!('senderTier' in data) || data.senderTier in ['USER', 'SUPPORT', 'ADMIN']) &&
             isStr(data.text, 1, 500) &&
             data.messageType in ['TEXT', 'REACTION', 'MOD_NOTICE', 'JOIN_LEAVE'] &&
             data.flaggedByAutoMod is bool &&
             data.deletedByMod is bool &&
             (!('reactionsByEmoji' in data) ||
              (data.reactionsByEmoji is map &&
               data.reactionsByEmoji.size() <= 8 &&
               data.reactionsByEmoji.keys().hasOnly(['❤️', '😂', '🔥', '👏', '😮', '👍', '🎉', '🙌']))) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidModLog(data) {
      let k = ['roomId', 'actorId', 'actorName', 'targetUserId', 'targetName', 'actionType', 'reason', 'createdAt'];
      return data.keys().hasAll(k) && data.keys().hasOnly(k) &&
             isStr(data.roomId, 1, 128) && isStr(data.actorId, 1, 128) && isStr(data.actorName, 1, 40) &&
             isStr(data.targetUserId, 0, 128) && isStr(data.targetName, 0, 40) &&
             data.actionType in [
               'MUTE', 'UNMUTE', 'BOUNCE', 'UNBOUNCE', 'KICK', 'SUSPEND', 'BAN', 'UNBAN',
               'DELETE_MSG', 'AUTO_MOD', 'LOCK_ROOM', 'PIN_LOCK', 'STAGE_MUTE',
               'PROMOTE_MOD', 'DEMOTE_MOD', 'SEND_ALERT', 'STAFF_ROLE',
               'EDIT_USER', 'EDIT_ROOM', 'CLOSE_ROOM', 'SETTINGS'
             ] &&
             isStr(data.reason, 0, 200) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidSafetyReport(data) {
      let k = [
        'reporterId', 'reporterName', 'roomId', 'roomTitle', 'roomHostId',
        'targetUserId', 'targetName', 'category', 'details', 'status',
        'resolutionNote', 'createdAt', 'updatedAt'
      ];
      return data.keys().hasAll(k) && data.keys().hasOnly(k) &&
             isStr(data.reporterId, 1, 128) && isStr(data.reporterName, 1, 40) &&
             isStr(data.roomId, 1, 260) && isStr(data.roomTitle, 1, 60) && isStr(data.roomHostId, 1, 128) &&
             isStr(data.targetUserId, 1, 128) && isStr(data.targetName, 1, 40) &&
             data.category in ['HARASSMENT', 'HATE_SPEECH', 'SPAM_SCAM', 'INAPPROPRIATE_MEDIA', 'IMPERSONATION', 'OTHER'] &&
             isStr(data.details, 1, 400) &&
             data.status in ['OPEN', 'RESOLVED', 'DISMISSED'] &&
             isStr(data.resolutionNote, 0, 200) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidDirectoryEntry(data) {
      return data.keys().hasAll(['userId', 'displayName', 'handle', 'avatarColorHex', 'staffTier', 'updatedAt']) &&
             data.keys().hasOnly([
               'userId', 'displayName', 'handle', 'bio', 'avatarColorHex', 'photoBase64',
               'staffTier', 'proMember', 'proExpiresAtMillis', 'proLifetime', 'proTier',
               'customDisplayName', 'customNameColorHex', 'customMembershipTier',
               'companySubAccount', 'parentCompanyOwnerId', 'doNotDisturb',
               'priorityChirpOptIn', 'profileBoostedUntilMillis',
               'spotlightFrameUntilMillis', 'spotlightFrameColorHex', 'referralCode',
               'postCount', 'dmPolicy', 'disableMessaging', 'sex', 'age', 'online', 'appearanceStatus',
               'totalTimeSpentSec', 'lastActiveAt', 'acceptedFriendIds', 'updatedAt'
             ]) &&
             isStr(data.userId, 1, 128) && isStr(data.displayName, 1, 40) && isStr(data.handle, 2, 30) &&
             (!('bio' in data) || isStr(data.bio, 0, 200)) &&
             isValidHexColor(data.avatarColorHex) &&
             (!('photoBase64' in data) || isStr(data.photoBase64, 0, 140000)) &&
             data.staffTier in ['USER', 'SUPPORT', 'ADMIN'] &&
             (!('disableMessaging' in data) || data.disableMessaging is bool) &&
             (!('proMember' in data) || data.proMember is bool) &&
             (!('proExpiresAtMillis' in data) || isNonNeg(data.proExpiresAtMillis)) &&
             (!('proLifetime' in data) || data.proLifetime is bool) &&
             (!('proTier' in data) || data.proTier in ['FREE', 'PRO', 'VIP_PRO', 'ELITE_PRO']) &&
             (!data.keys().hasAny(['customDisplayName', 'customNameColorHex', 'customMembershipTier']) ||
              (isStr(data.get('customDisplayName', ''), 0, 40) &&
               (data.get('customNameColorHex', '') == '' || isValidHexColor(data.customNameColorHex)) &&
               data.get('customMembershipTier', '') in ['', 'FREE', 'PRO', 'VIP_PRO', 'ELITE_PRO', 'SUPPORT', 'ADMIN'] &&
               ((data.get('customDisplayName', '') == '' && data.get('customNameColorHex', '') == '' && data.get('customMembershipTier', '') == '') || isAdmin()))) &&
             (!('companySubAccount' in data) || data.companySubAccount is bool) &&
             (!('parentCompanyOwnerId' in data) || isStr(data.parentCompanyOwnerId, 0, 128)) &&
             (!('doNotDisturb' in data) || data.doNotDisturb is bool) &&
             (!('priorityChirpOptIn' in data) || data.priorityChirpOptIn is bool) &&
             (!('profileBoostedUntilMillis' in data) || isNonNeg(data.profileBoostedUntilMillis)) &&
             (!('spotlightFrameUntilMillis' in data) || isNonNeg(data.spotlightFrameUntilMillis)) &&
             (!('spotlightFrameColorHex' in data) || isValidHexColor(data.spotlightFrameColorHex)) &&
             (!('referralCode' in data) || isValidReferralCode(data.referralCode)) &&
             (!('postCount' in data) || (isNonNeg(data.postCount) && data.postCount <= 100000)) &&
             (!('acceptedFriendIds' in data) || isBoundedStringList(data.acceptedFriendIds, 200)) &&
             (!('dmPolicy' in data) || data.dmPolicy in ['OPEN', 'PAID', 'DISABLED']) &&
             (!('sex' in data) || data.sex in ['UNSPECIFIED', 'MALE', 'FEMALE']) &&
             (!('age' in data) || (data.age is int && (data.age == 0 || (data.age >= 13 && data.age <= 120)))) &&
             (!('online' in data) || data.online is bool) &&
             (!('appearanceStatus' in data) || data.appearanceStatus in ['ONLINE', 'IDLE', 'OFFLINE']) &&
             (!('totalTimeSpentSec' in data) || (isNonNeg(data.totalTimeSpentSec) && data.totalTimeSpentSec <= 100000000)) &&
             (!('lastActiveAt' in data) || (data.lastActiveAt is timestamp && data.lastActiveAt <= request.time)) &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidProfilePost(data) {
      return data.keys().hasAll([
               'authorId', 'authorName', 'authorHandle', 'authorColorHex', 'authorTier',
               'text', 'imageBase64', 'likedByUserIds', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'authorId', 'authorName', 'authorHandle', 'authorColorHex', 'authorPhotoBase64',
               'authorTier', 'text', 'imageBase64', 'locked', 'unlockPricePoints', 'unlockedByUserIds',
               'boostedAtMillis', 'boostedUntilMillis', 'likedByUserIds',
               'commentCount', 'shareCount',
               'sharedFromPostId', 'sharedFromAuthorId', 'sharedFromAuthorName', 'sharedFromAuthorHandle',
               'createdAt', 'updatedAt'
             ]) &&
             isStr(data.authorId, 1, 128) && isStr(data.authorName, 1, 40) && isStr(data.authorHandle, 2, 30) &&
             isValidHexColor(data.authorColorHex) &&
             (!('authorPhotoBase64' in data) || isStr(data.authorPhotoBase64, 0, 140000)) &&
             data.authorTier in ['USER', 'SUPPORT', 'ADMIN'] &&
             isStr(data.text, 0, 1000) && isStr(data.imageBase64, 0, 460000) &&
             (data.text.size() >= 1 || data.imageBase64.size() >= 1) &&
             (!('locked' in data) || (data.locked is bool && (!data.locked || data.imageBase64.size() >= 1))) &&
             (!('unlockPricePoints' in data) || data.unlockPricePoints == 2) &&
             (!('unlockedByUserIds' in data) || isBoundedStringList(data.unlockedByUserIds, 500)) &&
             (!('boostedAtMillis' in data) || isNonNeg(data.boostedAtMillis)) &&
             (!('boostedUntilMillis' in data) || isNonNeg(data.boostedUntilMillis)) &&
             (!('commentCount' in data) || (isNonNeg(data.commentCount) && data.commentCount <= 100000)) &&
             (!('shareCount' in data) || (isNonNeg(data.shareCount) && data.shareCount <= 100000)) &&
             (!('sharedFromPostId' in data) || isStr(data.sharedFromPostId, 0, 128)) &&
             (!('sharedFromAuthorId' in data) || isStr(data.sharedFromAuthorId, 0, 128)) &&
             (!('sharedFromAuthorName' in data) || isStr(data.sharedFromAuthorName, 0, 40)) &&
             (!('sharedFromAuthorHandle' in data) || isStr(data.sharedFromAuthorHandle, 0, 30)) &&
             isBoundedStringList(data.likedByUserIds, 500) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPostComment(data) {
      return data.keys().hasAll([
               'postId', 'authorId', 'authorName', 'authorHandle', 'authorColorHex',
               'authorTier', 'text', 'createdAt'
             ]) &&
             data.keys().hasOnly([
               'postId', 'authorId', 'authorName', 'authorHandle', 'authorColorHex',
               'authorPhotoBase64', 'authorTier', 'text', 'createdAt'
             ]) &&
             isStr(data.postId, 1, 128) && isStr(data.authorId, 1, 128) &&
             isStr(data.authorName, 1, 40) && isStr(data.authorHandle, 2, 30) &&
             isValidHexColor(data.authorColorHex) &&
             (!('authorPhotoBase64' in data) || isStr(data.authorPhotoBase64, 0, 140000)) &&
             data.authorTier in ['USER', 'SUPPORT', 'ADMIN'] &&
             isStr(data.text, 1, 500) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isOriginalPostShareable(origPostId) {
      return exists(/databases/$(database)/documents/profilePosts/$(origPostId)) &&
             !(('locked' in get(/databases/$(database)/documents/profilePosts/$(origPostId)).data) &&
               get(/databases/$(database)/documents/profilePosts/$(origPostId)).data.locked == true);
    }

    function isValidFriendship(data) {
      let keys = [
        'userIds', 'requesterId', 'requesterName', 'requesterHandle', 'requesterColorHex', 'requesterTier',
        'recipientId', 'recipientName', 'recipientHandle', 'recipientColorHex', 'recipientTier',
        'status', 'createdAt', 'updatedAt'
      ];
      return data.keys().hasAll(keys) && data.keys().hasOnly(keys) &&
             data.userIds is list && data.userIds.size() == 2 &&
             isStr(data.requesterId, 1, 128) && isStr(data.recipientId, 1, 128) &&
             data.requesterId != data.recipientId &&
             data.requesterId in data.userIds && data.recipientId in data.userIds &&
             isStr(data.requesterName, 1, 40) && isStr(data.requesterHandle, 2, 30) &&
             isValidHexColor(data.requesterColorHex) && data.requesterTier in ['USER', 'SUPPORT', 'ADMIN'] &&
             isStr(data.recipientName, 1, 40) && isStr(data.recipientHandle, 2, 30) &&
             isValidHexColor(data.recipientColorHex) && data.recipientTier in ['USER', 'SUPPORT', 'ADMIN'] &&
             data.status in ['PENDING', 'ACCEPTED'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidDirectThread(data) {
      let isCo = ('companyOwnerId' in data) && data.companyOwnerId is string && data.companyOwnerId.size() >= 1;
      return data.keys().hasAll([
               'participantIds', 'userAId', 'userAName', 'userAColorHex', 'userATier',
               'userBId', 'userBName', 'userBColorHex', 'userBTier',
               'lastMessageText', 'lastMessageSenderId', 'unreadByUserIds',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'participantIds', 'isGroup', 'groupName', 'groupAdminId', 'groupAdminTalking',
               'groupSupportIds', 'companyOwnerId', 'groupSupervisorIds', 'pttAllowedUserIds', 'participantNamesById',
               'kickedUserIds', 'mutedUserIds', 'bouncedUntilByUserId', 'bouncedNamesByUserId',
               'bannedUserIds', 'bannedNamesByUserId',
               'blockedByUserIds', 'pttEnabledUserIds', 'disappearingDurationSec',
               'readReceiptsDisabledByUserIds', 'readTimestampsByUserId',
               'talkStreakCount', 'talkStreakLastMutualDay', 'lastMessageDayByUserId',
               'userAId', 'userAName', 'userAColorHex', 'userATier',
               'userBId', 'userBName', 'userBColorHex', 'userBTier',
               'lastMessageText', 'lastMessageSenderId', 'unreadByUserIds',
               'createdAt', 'updatedAt'
             ]) &&
             data.participantIds is list && data.participantIds.size() >= (isCo ? 1 : 2) && data.participantIds.size() <= 50 &&
             (!('isGroup' in data) || data.isGroup is bool) &&
             (!('groupName' in data) || isStr(data.groupName, 0, 60)) &&
             (!('groupAdminId' in data) || isStr(data.groupAdminId, 0, 128)) &&
             (!('groupSupportIds' in data) || (data.groupSupportIds is list && data.groupSupportIds.size() <= 50)) &&
             (!('companyOwnerId' in data) || isStr(data.companyOwnerId, 0, 128)) &&
             (!('groupSupervisorIds' in data) || (data.groupSupervisorIds is list && data.groupSupervisorIds.size() <= 50)) &&
             (!('participantNamesById' in data) || (data.participantNamesById is map && data.participantNamesById.size() <= 50)) &&
             (!data.keys().hasAny([
               'groupAdminTalking', 'pttAllowedUserIds', 'kickedUserIds', 'mutedUserIds',
               'bouncedUntilByUserId', 'bouncedNamesByUserId', 'bannedUserIds', 'bannedNamesByUserId',
               'blockedByUserIds', 'pttEnabledUserIds', 'disappearingDurationSec',
               'readReceiptsDisabledByUserIds', 'readTimestampsByUserId'
             ]) || (
               (!('groupAdminTalking' in data) || data.groupAdminTalking is bool) &&
               (!('pttAllowedUserIds' in data) || (data.pttAllowedUserIds is list && data.pttAllowedUserIds.size() <= 50)) &&
               (!('kickedUserIds' in data) || (data.kickedUserIds is list && data.kickedUserIds.size() <= 50)) &&
               (!('mutedUserIds' in data) || (data.mutedUserIds is list && data.mutedUserIds.size() <= 50)) &&
               (!('bouncedUntilByUserId' in data) || (data.bouncedUntilByUserId is map && data.bouncedUntilByUserId.size() <= 50)) &&
               (!('bouncedNamesByUserId' in data) || (data.bouncedNamesByUserId is map && data.bouncedNamesByUserId.size() <= 50)) &&
               (!('bannedUserIds' in data) || (data.bannedUserIds is list && data.bannedUserIds.size() <= 50)) &&
               (!('bannedNamesByUserId' in data) || (data.bannedNamesByUserId is map && data.bannedNamesByUserId.size() <= 50)) &&
               (!('blockedByUserIds' in data) || (data.blockedByUserIds is list && data.blockedByUserIds.size() <= 50)) &&
               (!('pttEnabledUserIds' in data) || (data.pttEnabledUserIds is list && data.pttEnabledUserIds.size() <= 50)) &&
               (!('disappearingDurationSec' in data) || data.disappearingDurationSec in [0, 30, 300, 3600, 86400]) &&
               (!('readReceiptsDisabledByUserIds' in data) || (data.readReceiptsDisabledByUserIds is list && data.readReceiptsDisabledByUserIds.size() <= 50)) &&
               (!('readTimestampsByUserId' in data) || (data.readTimestampsByUserId is map && data.readTimestampsByUserId.size() <= 50))
             )) &&
             (!data.keys().hasAny(['talkStreakCount', 'talkStreakLastMutualDay', 'lastMessageDayByUserId']) || (
               (!('talkStreakCount' in data) || (isNonNeg(data.talkStreakCount) && data.talkStreakCount <= 10000)) &&
               (!('talkStreakLastMutualDay' in data) || isValidDayKey(data.talkStreakLastMutualDay)) &&
               (!('lastMessageDayByUserId' in data) || (data.lastMessageDayByUserId is map && data.lastMessageDayByUserId.size() <= 50))
             )) &&
             isStr(data.userAId, 1, 128) && isStr(data.userBId, 1, 128) &&
             (isCo || data.userAId != data.userBId) &&
             data.userAId in data.participantIds && data.userBId in data.participantIds &&
             isStr(data.userAName, 1, 40) && isValidHexColor(data.userAColorHex) && data.userATier in ['USER', 'SUPPORT', 'ADMIN'] &&
             isStr(data.userBName, 1, 40) && isValidHexColor(data.userBColorHex) && data.userBTier in ['USER', 'SUPPORT', 'ADMIN'] &&
             isStr(data.lastMessageText, 0, 300) && isStr(data.lastMessageSenderId, 0, 128) &&
             data.unreadByUserIds is list && data.unreadByUserIds.size() <= 50 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isProfileAllowedToCreateThread(p) {
      return !isSubAccountProfile(p) &&
             (!('globallyBanned' in p) || p.globallyBanned == false) &&
             (!('suspendedUntilMillis' in p) || p.suspendedUntilMillis <= request.time.toMillis());
    }

    function canCreateCompanyGroupThread(d) {
      return isThreadGroup(d) &&
             d.companyOwnerId == request.auth.uid &&
             effectiveGroupAdminId(d) == request.auth.uid &&
             isVipProOrAdminCaller() &&
             request.auth.uid in d.participantIds &&
             (d.participantIds.size() <= 25 ||
              (d.participantIds.size() <= 50 && d.participantIds.size() <= groupMaxMembersForUid(request.auth.uid)));
    }

    function canCreateDirectThread(d) {
      return (isAdmin() ||
              ((!callerProfileExists() || isProfileAllowedToCreateThread(callerProfile())) &&
               !isModFileSuspended(request.auth.uid))) &&
             isValidDirectThread(d) &&
             (('companyOwnerId' in d) && d.companyOwnerId is string && d.companyOwnerId.size() >= 1
               ? canCreateCompanyGroupThread(d)
               : (isThreadGroup(d)
                   ? (request.auth.uid in d.participantIds &&
                      (d.participantIds.size() <= 7 ||
                       (d.participantIds.size() <= 50 && d.participantIds.size() <= groupMaxMembersForUid(effectiveGroupAdminId(d)))))
                   : ((request.auth.uid in d.participantIds &&
                       !isBlockedBetween(request.auth.uid, otherOneOnOneUid(d)) &&
                       canMessageUser(otherOneOnOneUid(d))) ||
                      isAdmin())));
    }

    function isValidDirectMessage(data) {
      return data.keys().hasAll([
               'threadId', 'participantIds', 'senderId', 'senderName', 'senderTier', 'text', 'createdAt'
             ]) &&
             data.keys().hasOnly([
               'threadId', 'participantIds', 'senderId', 'senderName', 'senderTier',
               'text', 'imageBase64', 'audioBase64', 'audioDurationSec', 'expiresAtMillis',
               'messageType', 'reactionsByUserId', 'hideSenderName', 'createdAt'
             ]) &&
             isStr(data.threadId, 1, 260) &&
             data.participantIds is list && data.participantIds.size() >= 1 && data.participantIds.size() <= 50 &&
             isStr(data.senderId, 1, 128) &&
             (data.senderId in data.participantIds ||
              (('messageType' in data) && data.messageType == 'SUPPORT_HANDOFF' && isAdmin())) &&
             isStr(data.senderName, 1, 40) &&
             data.senderTier in ['USER', 'SUPPORT', 'ADMIN'] &&
             isStr(data.text, 0, 500) &&
             (!('imageBase64' in data) || isStr(data.imageBase64, 0, 460000)) &&
             (!('audioBase64' in data) || isStr(data.audioBase64, 0, 360000)) &&
             (!('audioDurationSec' in data) || (isNonNeg(data.audioDurationSec) && data.audioDurationSec <= 60)) &&
             (!('expiresAtMillis' in data) || isNonNeg(data.expiresAtMillis)) &&
             (!('messageType' in data) || data.messageType in ['TEXT', 'SCREENSHOT', 'SUPPORT_HANDOFF', 'PRIORITY_CHIRP']) &&
             (!('reactionsByUserId' in data) || (data.reactionsByUserId is map && data.reactionsByUserId.size() <= 50)) &&
             (!('hideSenderName' in data) || data.hideSenderName is bool) &&
             (data.text.size() >= 1 ||
              ('imageBase64' in data && data.imageBase64.size() >= 1) ||
              ('audioBase64' in data && data.audioBase64.size() >= 1)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function canToggleDirectMessageReaction(newData, oldData) {
      let oldMap = ('reactionsByUserId' in oldData) ? oldData.reactionsByUserId : {};
      let newMap = ('reactionsByUserId' in newData) ? newData.reactionsByUserId : {};
      return newMap.diff(oldMap).affectedKeys().hasOnly([request.auth.uid]) &&
             (!(request.auth.uid in newMap) ||
              newMap[request.auth.uid] in ['❤️', '👍', '😂', '😮', '😢', '🔥']);
    }

    function isValidSupportTicket(data) {
      return data.keys().hasAll(['requesterId', 'requesterName', 'requesterTier', 'category', 'subject', 'message', 'status', 'staffResponse', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['requesterId', 'requesterName', 'requesterTier', 'assignedStaffId', 'assignedStaffName', 'category', 'subject', 'message', 'status', 'staffResponse', 'createdAt', 'updatedAt']) &&
             isStr(data.requesterId, 1, 128) && isStr(data.requesterName, 1, 40) &&
             data.requesterTier in ['USER', 'SUPPORT', 'ADMIN'] &&
             (!('assignedStaffId' in data) || isStr(data.assignedStaffId, 0, 128)) &&
             (!('assignedStaffName' in data) || isStr(data.assignedStaffName, 0, 40)) &&
             data.category in ['ACCOUNT', 'BILLING', 'SAFETY', 'BUG', 'OTHER'] &&
             isStr(data.subject, 2, 100) && isStr(data.message, 4, 600) &&
             data.status in ['OPEN', 'IN_PROGRESS', 'RESOLVED'] &&
             isStr(data.staffResponse, 0, 600) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidUserFollow(data) {
      let k = ['followerId', 'followingId', 'createdAt'];
      return data.keys().hasAll(k) && data.keys().hasOnly(k) &&
             isValidId(data.followerId) && isValidId(data.followingId) &&
             data.followerId != data.followingId &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidDmAccessPass(data) {
      let k = ['senderId', 'senderName', 'recipientId', 'recipientName', 'priceCents', 'creatorShareCents', 'platformShareCents', 'active', 'kicked', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(k) && data.keys().hasOnly(k) &&
             isStr(data.senderId, 1, 128) && isStr(data.senderName, 1, 40) &&
             isStr(data.recipientId, 1, 128) && isStr(data.recipientName, 1, 40) &&
             data.senderId != data.recipientId &&
             data.priceCents == 500 && data.creatorShareCents == 0 && data.platformShareCents == 500 &&
             data.active is bool && data.kicked is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function hasActiveDmPass(targetUid) {
      let passId = request.auth.uid + '_' + targetUid;
      return exists(/databases/$(database)/documents/dmAccessPasses/$(passId)) &&
             isPassActive(get(/databases/$(database)/documents/dmAccessPasses/$(passId)).data);
    }

    function isPassActive(passData) {
      return passData.active == true && passData.kicked == false;
    }

    function canMessageWithDirectory(dirData, targetUid) {
      let policy = ('dmPolicy' in dirData) ? dirData.dmPolicy : 'OPEN';
      return policy == 'OPEN' || (policy == 'PAID' && hasActiveDmPass(targetUid));
    }

    function hasBlockedUid(profileData, otherUid) {
      return ('blockedUserIds' in profileData) && (otherUid in profileData.blockedUserIds);
    }

    function isBlockedBetween(uidA, uidB) {
      return (exists(/databases/$(database)/documents/users/$(uidA)) &&
              hasBlockedUid(get(/databases/$(database)/documents/users/$(uidA)).data, uidB)) ||
             (exists(/databases/$(database)/documents/users/$(uidB)) &&
              hasBlockedUid(get(/databases/$(database)/documents/users/$(uidB)).data, uidA));
    }

    function canMessageUser(targetUid) {
      return isAdmin() ||
             targetUid == request.auth.uid ||
             !exists(/databases/$(database)/documents/userDirectory/$(targetUid)) ||
             canMessageWithDirectory(get(/databases/$(database)/documents/userDirectory/$(targetUid)).data, targetUid);
    }

    function otherOneOnOneUid(threadData) {
      return threadData.userAId == request.auth.uid ? threadData.userBId : threadData.userAId;
    }

    function isThreadGroup(threadData) {
      return ('isGroup' in threadData) && threadData.isGroup == true;
    }

    function isKickedFromThread(threadData, uid) {
      return ('kickedUserIds' in threadData) && (uid in threadData.kickedUserIds);
    }

    function hasAnyThreadBlock(threadData) {
      return ('blockedByUserIds' in threadData) && threadData.blockedByUserIds.size() > 0;
    }

    function effectiveGroupAdminId(threadData) {
      return ('groupAdminId' in threadData && threadData.groupAdminId is string && threadData.groupAdminId.size() > 0)
        ? threadData.groupAdminId
        : threadData.userAId;
    }

    function isGroupDmAdmin(threadData) {
      return isThreadGroup(threadData) && effectiveGroupAdminId(threadData) == request.auth.uid;
    }

    function isGroupDmSupport(threadData) {
      return isThreadGroup(threadData) && (
        (('groupSupportIds' in threadData) && (request.auth.uid in threadData.groupSupportIds)) ||
        (('groupSupervisorIds' in threadData) && (request.auth.uid in threadData.groupSupervisorIds))
      );
    }

    function canSubAccountJoinCompanyThread(threadId, oldData) {
      return isThreadGroup(oldData) &&
             ('companyOwnerId' in oldData) && oldData.companyOwnerId.size() >= 1 &&
             callerProfileExists() &&
             isSubAccountProfile(callerProfile()) &&
             ('companyThreadId' in callerProfile()) &&
             callerProfile().companyThreadId == threadId &&
             !isBannedFromGroupDm(oldData, request.auth.uid);
    }

    function canUseGroupPtt(threadData, uid) {
      return !isThreadGroup(threadData) ||
             threadData.participantIds.size() <= 15 ||
             effectiveGroupAdminId(threadData) == uid ||
             isTargetAdmin(uid) ||
             (('pttAllowedUserIds' in threadData) && (uid in threadData.pttAllowedUserIds));
    }

    function isMutedInGroupDm(threadData, uid) {
      return isThreadGroup(threadData) && ('mutedUserIds' in threadData) && (uid in threadData.mutedUserIds);
    }

    function isBannedFromGroupDm(threadData, uid) {
      return isThreadGroup(threadData) && ('bannedUserIds' in threadData) && (uid in threadData.bannedUserIds);
    }

    function isBouncedInGroupDm(threadData, uid) {
      return isThreadGroup(threadData) &&
             ('bouncedUntilByUserId' in threadData) &&
             (uid in threadData.bouncedUntilByUserId) &&
             threadData.bouncedUntilByUserId[uid] > request.time.toMillis();
    }

    function isSelfListToggle(newData, oldData, field) {
      let uid = request.auth.uid;
      let newList = newData[field];
      let hadField = field in oldData;
      return (uid in newList &&
              (!hadField
                ? newList.size() == 1
                : (!(uid in oldData[field]) &&
                   newList.size() == oldData[field].size() + 1 &&
                   newList.hasAll(oldData[field])))) ||
             (!(uid in newList) &&
              hadField &&
              (uid in oldData[field]) &&
              newList.size() == oldData[field].size() - 1 &&
              oldData[field].hasAll(newList));
    }

    function isValidCreatorSubscription(data) {
      return data.keys().hasAll(['subscriberId', 'creatorId', 'creatorName', 'priceCents', 'creatorShareCents', 'platformShareCents', 'active', 'expiresAtMillis', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['subscriberId', 'creatorId', 'creatorName', 'priceCents', 'creatorShareCents', 'platformShareCents', 'active', 'expiresAtMillis', 'refunded', 'createdAt', 'updatedAt']) &&
             isStr(data.subscriberId, 1, 128) && isStr(data.creatorId, 1, 128) &&
             data.subscriberId != data.creatorId && isStr(data.creatorName, 1, 40) &&
             data.priceCents == 1500 && data.creatorShareCents == 0 && data.platformShareCents == 1500 &&
             data.active is bool && (!('refunded' in data) || data.refunded is bool) &&
             data.expiresAtMillis is int &&
             ((data.active == true && data.expiresAtMillis > request.time.toMillis()) || (data.active == false && data.expiresAtMillis >= 0)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPointTransaction(data) {
      let noCreator = data.creatorId == '' && data.creatorName == '';
      let otherCreator = data.creatorId.size() >= 1 && data.creatorId != data.buyerId;
      let noPost = data.postId == '';
      let hasPost = data.postId.size() >= 1;
      let platAll = data.platformShareCents == data.grossCents;
      return data.keys().hasAll([
               'type', 'buyerId', 'buyerName', 'creatorId', 'creatorName', 'postId',
               'pointsDelta', 'grossCents', 'creatorShareCents', 'platformShareCents', 'createdAt'
             ]) &&
             data.keys().hasOnly([
               'type', 'buyerId', 'buyerName', 'creatorId', 'creatorName', 'postId',
               'pointsDelta', 'grossCents', 'creatorShareCents', 'platformShareCents',
               'playOrderId', 'playProductId',
               'refunded', 'refundedAtMillis', 'refundedById', 'refundedByName', 'refundReason',
               'createdAt'
             ]) &&
             isStr(data.buyerId, 1, 128) && isStr(data.buyerName, 1, 40) &&
             isStr(data.creatorId, 0, 128) && isStr(data.creatorName, 0, 40) &&
             isStr(data.postId, 0, 128) &&
             data.pointsDelta is int && data.grossCents is int &&
             data.creatorShareCents == 0 && data.platformShareCents is int &&
             (!('playOrderId' in data) || isStr(data.playOrderId, 0, 128)) &&
             (!('playProductId' in data) || isStr(data.playProductId, 0, 64)) &&
             (!('refunded' in data) || data.refunded is bool) &&
             (!('refundedAtMillis' in data) || isNonNeg(data.refundedAtMillis)) &&
             (!('refundedById' in data) || isStr(data.refundedById, 0, 128)) &&
             (!('refundedByName' in data) || isStr(data.refundedByName, 0, 40)) &&
             (!('refundReason' in data) || isStr(data.refundReason, 0, 300)) &&
             data.createdAt is timestamp && data.createdAt <= request.time && (
               (data.type == 'BUY_POINTS' && data.pointsDelta >= 2 && data.pointsDelta <= 500 && data.grossCents == data.pointsDelta * 100 && data.platformShareCents == 0 && data.creatorId == '' && noPost) ||
               (data.type == 'UNLOCK_PHOTO' && data.pointsDelta == -2 && data.grossCents == 200 && platAll && otherCreator && hasPost) ||
               (data.type == 'SUBSCRIBE_CREATOR' && data.pointsDelta == 0 && data.grossCents == 1500 && platAll && otherCreator && noPost) ||
               (data.type in ['BOOST_POST', 'BOOST_REEL'] && data.pointsDelta == -5 && data.grossCents == 500 && platAll && noCreator && hasPost) ||
               (data.type in ['BOOST_PROFILE', 'BUY_SPOTLIGHT_FRAME'] && data.pointsDelta == -5 && data.grossCents == 500 && platAll && noCreator && noPost) ||
               (data.type == 'BUY_PTT_ITEM' && data.pointsDelta in [-2, -3, -4] && data.grossCents == (-data.pointsDelta) * 100 && platAll && noCreator && hasPost) ||
               (data.type == 'DAILY_STREAK_BONUS' && data.pointsDelta in [0, 1] && data.grossCents == 0 && platAll && noCreator && noPost) ||
               (data.type == 'REFERRAL_BONUS' && data.pointsDelta == 2 && data.grossCents == 0 && platAll && otherCreator && noPost) ||
               (data.type == 'UNLOCK_DM' && data.pointsDelta == 0 && data.grossCents == 500 && platAll && otherCreator && noPost) ||
               (data.type == 'PRO_MEMBERSHIP' && data.pointsDelta in [0, -10] && data.grossCents == 999 && platAll && noCreator && noPost) ||
               (data.type == 'VIP_PRO_MEMBERSHIP' && data.pointsDelta == 0 && data.grossCents == 2999 && platAll && noCreator && noPost) ||
               (data.type == 'ELITE_PRO_MEMBERSHIP' && data.pointsDelta == 0 && data.grossCents == 5999 && platAll && noCreator && noPost) ||
               (data.type == 'UNLOCK_PROFILE_VIEWERS' && data.pointsDelta == -2 && data.grossCents == 200 && platAll && noCreator && noPost) ||
               (data.type == 'PRIORITY_CHIRP' && data.pointsDelta in [-1, -2] && data.grossCents == (-data.pointsDelta) * 100 && platAll && otherCreator && hasPost) ||
               (data.type == 'DM_SCROLLING_BANNER' && data.pointsDelta == -1 && data.grossCents == 100 && platAll && noCreator && hasPost)
             );
    }

    function isValidAppConfig(data) {
      let k = ['bannerTitle', 'bannerMessage', 'bannerEnabled', 'trialLoginsEnabled', 'updatedByName', 'updatedAt'];
      return data.keys().hasAll(k) && data.keys().hasOnly(k) &&
             isStr(data.bannerTitle, 0, 80) && isStr(data.bannerMessage, 0, 400) &&
             data.bannerEnabled is bool && data.trialLoginsEnabled is bool &&
             isStr(data.updatedByName, 0, 40) &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidRoomTransfer(data, targetUid) {
      return data.keys().hasAll(['userId', 'targetRoomId', 'targetRoomTitle', 'fromRoomId', 'movedByAdminId', 'movedByAdminName', 'reason', 'consumed', 'createdAt']) &&
             data.keys().hasOnly(['userId', 'targetRoomId', 'targetRoomTitle', 'fromRoomId', 'movedByAdminId', 'movedByAdminName', 'reason', 'consumed', 'transferType', 'targetThreadId', 'targetSupportUserId', 'targetSupportName', 'createdAt']) &&
             data.userId == targetUid && isStr(data.targetRoomId, 1, 260) && isStr(data.targetRoomTitle, 1, 60) &&
             isStr(data.fromRoomId, 0, 128) && isStr(data.movedByAdminId, 1, 128) && isStr(data.movedByAdminName, 1, 40) &&
             isStr(data.reason, 0, 200) &&
             (!('transferType' in data) || data.transferType in ['ROOM', 'SUPPORT_DM']) &&
             (!('targetThreadId' in data) || isStr(data.targetThreadId, 0, 260)) &&
             (!('targetSupportUserId' in data) || isStr(data.targetSupportUserId, 0, 128)) &&
             (!('targetSupportName' in data) || isStr(data.targetSupportName, 0, 40)) &&
             data.consumed is bool && data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidAppBroadcast(data) {
      let k = ['title', 'message', 'severity', 'senderId', 'senderName', 'createdAt'];
      return data.keys().hasAll(k) && data.keys().hasOnly(k) &&
             isStr(data.title, 1, 80) && isStr(data.message, 1, 500) &&
             data.severity in ['INFO', 'WARNING', 'URGENT'] &&
             isStr(data.senderId, 1, 128) && isStr(data.senderName, 1, 40) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidPttShopPurchase(newData, oldData, diffKeys) {
      let oldThemes = ('ownedPttThemes' in oldData) ? oldData.ownedPttThemes : [];
      let newThemes = ('ownedPttThemes' in newData) ? newData.ownedPttThemes : [];
      let oldChirps = ('ownedPttChirps' in oldData) ? oldData.ownedPttChirps : [];
      let newChirps = ('ownedPttChirps' in newData) ? newData.ownedPttChirps : [];
      return (newThemes.size() == oldThemes.size() + 1 &&
              newThemes.hasAll(oldThemes) &&
              newChirps == oldChirps &&
              (!('selectedPttTheme' in diffKeys) || newData.selectedPttTheme in newThemes)) ||
             (newChirps.size() == oldChirps.size() + 1 &&
              newChirps.hasAll(oldChirps) &&
              newThemes == oldThemes &&
              (!('selectedPttChirp' in diffKeys) || newData.selectedPttChirp in newChirps));
    }

    function isValidOwnerWalletUpdate(newData, oldData, diffKeys) {
      let newPts = existingInt(newData, 'pointsBalance');
      let ptsDelta = newPts - existingInt(oldData, 'pointsBalance');
      let oldSpent = existingInt(oldData, 'totalSpentCents');
      let newSpent = existingInt(newData, 'totalSpentCents');
      let touchingPro = ('proMember' in diffKeys) || ('proExpiresAtMillis' in diffKeys) || ('proTier' in diffKeys);
      let targetTier = ('proTier' in newData) ? newData.proTier : 'PRO';
      let touchingProfileBoost = 'profileBoostedUntilMillis' in diffKeys;
      let touchingPttShop = ('ownedPttThemes' in diffKeys) || ('ownedPttChirps' in diffKeys) ||
                            ('selectedPttTheme' in diffKeys) || ('selectedPttChirp' in diffKeys);
      return diffKeys.hasOnly([
               'pointsBalance', 'totalSpentCents', 'proMember', 'proExpiresAtMillis', 'proTier',
               'profileBoostedUntilMillis', 'ownedPttThemes', 'selectedPttTheme',
               'ownedPttChirps', 'selectedPttChirp',
               'pictureUploadTimestamps', 'discoveryPhotoTimestamps', 'updatedAt'
             ]) &&
             newPts >= 0 &&
             canUpdatePictureUploadTimestamps(newData, oldData, diffKeys) &&
             canUpdateDiscoveryPhotoTimestamps(newData, oldData, diffKeys) && (
        (!touchingPro && !touchingProfileBoost && !touchingPttShop && (
          (ptsDelta >= 2 && ptsDelta <= 500 && newSpent == oldSpent + (ptsDelta * 100) && (isAge13VerifiedProfile(oldData) || isAdmin())) ||
          (ptsDelta == -2 && newSpent == oldSpent) ||
          (ptsDelta == -5 && newSpent == oldSpent) ||
          (ptsDelta == 0 && (newSpent == oldSpent + 1500 || newSpent == oldSpent + 500))
        )) ||
        (touchingPro && !touchingProfileBoost && !touchingPttShop &&
         (isAge13VerifiedProfile(oldData) || isAdmin()) &&
         newData.proMember == true &&
         newData.proExpiresAtMillis > request.time.toMillis() &&
         newData.proExpiresAtMillis <= request.time.toMillis() + 2764800000 && (
           (targetTier == 'PRO' && ((ptsDelta == 0 && newSpent == oldSpent + 999) || (ptsDelta == -10 && newSpent == oldSpent))) ||
           (targetTier == 'VIP_PRO' && ptsDelta == 0 && newSpent == oldSpent + 2999) ||
           (targetTier == 'ELITE_PRO' && ptsDelta == 0 && newSpent == oldSpent + 5999)
         )) ||
        (touchingProfileBoost && !touchingPro && !touchingPttShop &&
         ptsDelta == -5 && newSpent == oldSpent &&
         newData.profileBoostedUntilMillis > request.time.toMillis() &&
         newData.profileBoostedUntilMillis <= request.time.toMillis() + 86700000) ||
        (touchingPttShop && !touchingPro && !touchingProfileBoost &&
         ptsDelta in [-2, -3, -4] && newSpent == oldSpent &&
         isValidPttShopPurchase(newData, oldData, diffKeys))
      );
    }

    function callerPaidPointsInBatch(cost) {
      let beforeProfile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let afterProfile = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let oldPts = existingInt(beforeProfile, 'pointsBalance');
      let newPts = existingInt(afterProfile, 'pointsBalance');
      return newPts >= 0 && newPts == oldPts - cost;
    }

    function callerPaidFivePointsInBatch() {
      return callerPaidPointsInBatch(5);
    }

    function isValidOwnerProfileViewersUnlock(newData, oldData, diffKeys) {
      let newPts = existingInt(newData, 'pointsBalance');
      let ptsDelta = newPts - existingInt(oldData, 'pointsBalance');
      return diffKeys.hasOnly(['pointsBalance', 'profileViewersUnlockedUntilMillis', 'updatedAt']) &&
             newPts >= 0 &&
             ptsDelta == -2 &&
             newData.profileViewersUnlockedUntilMillis > request.time.toMillis() &&
             newData.profileViewersUnlockedUntilMillis <= request.time.toMillis() + 86700000;
    }

    function isValidOwnerMicroPointSpend(newData, oldData, diffKeys) {
      let newPts = existingInt(newData, 'pointsBalance');
      let ptsDelta = newPts - existingInt(oldData, 'pointsBalance');
      return diffKeys.hasOnly(['pointsBalance', 'updatedAt']) &&
             newPts >= 0 &&
             ptsDelta in [-1, -2];
    }

    function isValidProfileView(data, viewId) {
      return data.keys().hasAll(['targetUserId', 'viewerId', 'viewerName', 'viewerHandle', 'viewerColorHex', 'viewerTier', 'viewedAtMillis', 'viewedDayKey', 'updatedAt']) &&
             data.keys().hasOnly(['targetUserId', 'viewerId', 'viewerName', 'viewerHandle', 'viewerColorHex', 'viewerPhotoBase64', 'viewerTier', 'viewerProMember', 'viewedAtMillis', 'viewedDayKey', 'updatedAt']) &&
             isValidId(data.targetUserId) && isValidId(data.viewerId) &&
             data.targetUserId != data.viewerId && viewId == data.targetUserId + '_' + data.viewerId &&
             isStr(data.viewerName, 1, 40) && isStr(data.viewerHandle, 2, 30) &&
             isValidHexColor(data.viewerColorHex) &&
             (!('viewerPhotoBase64' in data) || isStr(data.viewerPhotoBase64, 0, 140000)) &&
             data.viewerTier in ['USER', 'SUPPORT', 'ADMIN'] &&
             (!('viewerProMember' in data) || data.viewerProMember is bool) &&
             data.viewedAtMillis is int && data.viewedAtMillis > 0 &&
             isValidDayKey(data.viewedDayKey) && data.viewedDayKey.size() == 10 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidBoostWindow(data) {
      return ('boostedAtMillis' in data) && ('boostedUntilMillis' in data) &&
             data.boostedAtMillis is int && data.boostedAtMillis > 0 &&
             data.boostedUntilMillis is int &&
             data.boostedUntilMillis > request.time.toMillis() &&
             data.boostedUntilMillis <= request.time.toMillis() + 86700000;
    }

    function isValidCreatorEarningsCredit(newData, oldData, diffKeys) {
      let ptsDelta = existingInt(newData, 'pointsBalance') - existingInt(oldData, 'pointsBalance');
      let earnPtsDelta = existingInt(newData, 'creatorEarnedPoints') - existingInt(oldData, 'creatorEarnedPoints');
      return diffKeys.hasOnly(['pointsBalance', 'creatorEarnedPoints', 'updatedAt']) &&
             ptsDelta == earnPtsDelta &&
             ptsDelta in [1, 8];
    }

    function isValidOwnerSpotlightFramePurchase(newData, oldData, diffKeys) {
      let newPts = existingInt(newData, 'pointsBalance');
      let ptsDelta = newPts - existingInt(oldData, 'pointsBalance');
      return diffKeys.hasOnly(['pointsBalance', 'spotlightFrameUntilMillis', 'spotlightFrameColorHex', 'updatedAt']) &&
             newPts >= 0 &&
             ptsDelta == -5 &&
             newData.spotlightFrameUntilMillis > request.time.toMillis() &&
             newData.spotlightFrameUntilMillis <= request.time.toMillis() + 86700000;
    }

    function isValidOwnerDailyLoginStreakUpdate(newData, oldData, diffKeys) {
      let oldStreak = existingInt(oldData, 'loginStreakDays');
      let newStreak = existingInt(newData, 'loginStreakDays');
      let oldLastDay = ('lastLoginDayKey' in oldData) ? oldData.lastLoginDayKey : '';
      let oldRewardDay = ('lastStreakRewardDayKey' in oldData) ? oldData.lastStreakRewardDayKey : '';
      let oldHalf = existingInt(oldData, 'halfPointsBalance');
      let newHalf = existingInt(newData, 'halfPointsBalance');
      let ptsDelta = existingInt(newData, 'pointsBalance') - existingInt(oldData, 'pointsBalance');
      let claimingReward = ('halfPointsBalance' in diffKeys) || ('pointsBalance' in diffKeys) || ('lastStreakRewardDayKey' in diffKeys);
      return diffKeys.hasOnly([
               'loginStreakDays', 'lastLoginDayKey', 'lastStreakRewardDayKey',
               'halfPointsBalance', 'pointsBalance', 'updatedAt'
             ]) &&
             ('lastLoginDayKey' in diffKeys) &&
             newData.lastLoginDayKey != '' &&
             newData.lastLoginDayKey != oldLastDay &&
             (newStreak == 1 || newStreak == oldStreak + 1) && (
               !claimingReward ||
               (!isProProfileData(oldData) &&
                newStreak >= 7 &&
                (newStreak % 7) == 0 &&
                newData.lastStreakRewardDayKey == newData.lastLoginDayKey &&
                newData.lastStreakRewardDayKey != oldRewardDay &&
                ((oldHalf == 0 && newHalf == 1 && ptsDelta == 0) ||
                 (oldHalf == 1 && newHalf == 0 && ptsDelta == 1)))
             );
    }

    function isValidOwnerReferralUpdate(userId, newData, oldData, diffKeys) {
      let oldClaimed = ('referralBonusClaimed' in oldData) && oldData.referralBonusClaimed == true;
      let ptsDelta = existingInt(newData, 'pointsBalance') - existingInt(oldData, 'pointsBalance');
      return (diffKeys.hasOnly(['referralCode', 'referredByUserId', 'updatedAt']) &&
              (!('referralCode' in diffKeys) || !('referralCode' in oldData) || oldData.referralCode == '') &&
              (!('referredByUserId' in diffKeys) ||
               ((!('referredByUserId' in oldData) || oldData.referredByUserId == '') &&
                newData.referredByUserId != userId))) ||
             (diffKeys.hasOnly(['pointsBalance', 'referralBonusClaimed', 'referredByUserId', 'updatedAt']) &&
              hasVerifiedEmail() &&
              !oldClaimed &&
              newData.referralBonusClaimed == true &&
              ptsDelta == 2 &&
              exists(/databases/$(database)/documents/referrals/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.bonusClaimed == false &&
              getAfter(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.bonusClaimed == true);
    }

    function isValidInviterReferralCredit(inviterUid, newData, oldData, diffKeys) {
      let ptsDelta = existingInt(newData, 'pointsBalance') - existingInt(oldData, 'pointsBalance');
      let refDelta = existingInt(newData, 'referralEarnedPoints') - existingInt(oldData, 'referralEarnedPoints');
      return diffKeys.hasOnly(['pointsBalance', 'referralEarnedPoints', 'updatedAt']) &&
             hasVerifiedEmail() &&
             ptsDelta == 2 &&
             refDelta == 2 &&
             exists(/databases/$(database)/documents/referrals/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.inviterId == inviterUid &&
             get(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.bonusClaimed == false &&
             getAfter(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.bonusClaimed == true;
    }

    function isValidReferralRecord(data, inviteeId) {
      let k = ['inviteeId', 'inviteeName', 'inviterId', 'inviterName', 'referralCode', 'accountVerified', 'firstPttSent', 'bonusClaimed', 'bonusPointsEach', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(k) && data.keys().hasOnly(k) &&
             data.inviteeId == inviteeId && isStr(data.inviteeName, 1, 40) &&
             isStr(data.inviterId, 1, 128) && data.inviterId != data.inviteeId &&
             isStr(data.inviterName, 1, 40) && isValidReferralCode(data.referralCode) && data.referralCode.size() >= 4 &&
             data.accountVerified is bool && data.firstPttSent is bool && data.bonusClaimed is bool &&
             data.bonusPointsEach == 2 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidReel(data) {
      return data.keys().hasAll(['authorId', 'authorName', 'authorHandle', 'authorColorHex', 'authorTier', 'caption', 'thumbnailBase64', 'durationSec', 'chunkCount', 'mimeType', 'likedByUserIds', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['authorId', 'authorName', 'authorHandle', 'authorColorHex', 'authorPhotoBase64', 'authorTier', 'caption', 'thumbnailBase64', 'durationSec', 'chunkCount', 'mimeType', 'boostedAtMillis', 'boostedUntilMillis', 'likedByUserIds', 'commentCount', 'shareCount', 'createdAt', 'updatedAt']) &&
             isStr(data.authorId, 1, 128) && isStr(data.authorName, 1, 40) && isStr(data.authorHandle, 2, 30) &&
             isValidHexColor(data.authorColorHex) &&
             (!('authorPhotoBase64' in data) || isStr(data.authorPhotoBase64, 0, 140000)) &&
             data.authorTier in ['USER', 'SUPPORT', 'ADMIN'] &&
             isStr(data.caption, 0, 300) && isStr(data.thumbnailBase64, 0, 140000) &&
             data.durationSec is int && data.durationSec >= 1 && data.durationSec <= 30 &&
             data.chunkCount is int && data.chunkCount >= 1 && data.chunkCount <= 16 &&
             data.mimeType == 'video/mp4' &&
             (!('boostedAtMillis' in data) || isNonNeg(data.boostedAtMillis)) &&
             (!('boostedUntilMillis' in data) || isNonNeg(data.boostedUntilMillis)) &&
             isBoundedStringList(data.likedByUserIds, 500) &&
             (!('commentCount' in data) || (isNonNeg(data.commentCount) && data.commentCount <= 100000)) &&
             (!('shareCount' in data) || (isNonNeg(data.shareCount) && data.shareCount <= 100000)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidReelChunk(data, reelId) {
      let k = ['reelId', 'authorId', 'chunkIndex', 'dataBase64', 'createdAt'];
      return data.keys().hasAll(k) && data.keys().hasOnly(k) &&
             data.reelId == reelId && isStr(data.authorId, 1, 128) &&
             data.chunkIndex is int && data.chunkIndex >= 0 && data.chunkIndex <= 15 &&
             isStr(data.dataBase64, 1, 680000) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidReelComment(data, reelId) {
      let k = ['reelId', 'authorId', 'authorName', 'authorHandle', 'authorColorHex', 'authorTier', 'text', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(k) && data.keys().hasOnly(k) &&
             data.reelId == reelId && isStr(data.authorId, 1, 128) &&
             isStr(data.authorName, 1, 40) && isStr(data.authorHandle, 2, 30) &&
             isValidHexColor(data.authorColorHex) &&
             data.authorTier in ['USER', 'SUPPORT', 'ADMIN'] &&
             isStr(data.text, 1, 400) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function canUpdateReel(newData, oldData) {
      let diffKeys = newData.diff(oldData).affectedKeys();
      let isAuthor = oldData.authorId == request.auth.uid;
      return (isAuthor && diffKeys.hasOnly([
                'caption', 'authorName', 'authorHandle', 'authorColorHex', 'authorPhotoBase64', 'updatedAt'
              ])) ||
             (diffKeys.hasOnly(['likedByUserIds', 'updatedAt']) && (
               (request.auth.uid in newData.likedByUserIds &&
                !(request.auth.uid in oldData.likedByUserIds) &&
                newData.likedByUserIds.size() == oldData.likedByUserIds.size() + 1) ||
               (!(request.auth.uid in newData.likedByUserIds) &&
                request.auth.uid in oldData.likedByUserIds &&
                newData.likedByUserIds.size() == oldData.likedByUserIds.size() - 1)
             )) ||
             (isAuthor && diffKeys.hasOnly(['boostedAtMillis', 'boostedUntilMillis', 'updatedAt']) &&
              isValidBoostWindow(newData) && callerPaidFivePointsInBatch()) ||
             (diffKeys.hasOnly(['commentCount', 'updatedAt']) &&
              (newData.commentCount == existingInt(oldData, 'commentCount') + 1 ||
               (existingInt(oldData, 'commentCount') > 0 &&
                newData.commentCount == existingInt(oldData, 'commentCount') - 1))) ||
             (diffKeys.hasOnly(['shareCount', 'updatedAt']) &&
              newData.shareCount == existingInt(oldData, 'shareCount') + 1);
    }

    function canUpdateProfilePost(newData, oldData) {
      let diffKeys = newData.diff(oldData).affectedKeys();
      let isAuthor = oldData.authorId == request.auth.uid;
      let isLocked = ('locked' in oldData) && oldData.locked == true;
      let nextLocked = ('locked' in newData) && newData.locked == true;
      return (isAuthor &&
              (!nextLocked || isAdultVerifiedCaller()) &&
              diffKeys.hasOnly([
                'text', 'imageBase64', 'locked', 'authorName', 'authorHandle',
                'authorColorHex', 'authorPhotoBase64', 'updatedAt'
              ])) ||
             (diffKeys.hasOnly(['likedByUserIds', 'updatedAt']) && (
               (request.auth.uid in newData.likedByUserIds &&
                !(request.auth.uid in oldData.likedByUserIds) &&
                newData.likedByUserIds.size() == oldData.likedByUserIds.size() + 1) ||
               (!(request.auth.uid in newData.likedByUserIds) &&
                request.auth.uid in oldData.likedByUserIds &&
                newData.likedByUserIds.size() == oldData.likedByUserIds.size() - 1)
             )) ||
             (isAdmin() && diffKeys.hasOnly(['authorName', 'authorHandle', 'updatedAt'])) ||
             (!isAuthor && isLocked && isAdultVerifiedCaller() &&
              diffKeys.hasOnly(['unlockedByUserIds', 'updatedAt']) &&
              request.auth.uid in newData.unlockedByUserIds &&
              (!('unlockedByUserIds' in oldData)
                ? newData.unlockedByUserIds.size() == 1
                : (!(request.auth.uid in oldData.unlockedByUserIds) &&
                   newData.unlockedByUserIds.size() == oldData.unlockedByUserIds.size() + 1))) ||
             (isAuthor && diffKeys.hasOnly(['boostedAtMillis', 'boostedUntilMillis', 'updatedAt']) &&
              isValidBoostWindow(newData) && callerPaidFivePointsInBatch()) ||
             (diffKeys.hasOnly(['commentCount', 'updatedAt']) &&
              (newData.commentCount == existingInt(oldData, 'commentCount') + 1 ||
               (existingInt(oldData, 'commentCount') > 0 &&
                newData.commentCount == existingInt(oldData, 'commentCount') - 1))) ||
             (!isLocked && diffKeys.hasOnly(['shareCount', 'updatedAt']) &&
              newData.shareCount == existingInt(oldData, 'shareCount') + 1);
    }

    function canToggleMessageReaction(rId, newData, oldData) {
      let room = roomDoc(rId).data;
      return oldData.deletedByMod == false &&
             roomExists(rId) &&
             room.status == 'LIVE' &&
             callerPassesProfileChecks(false, false, false, false) &&
             (!(request.auth.uid in room.bannedUserIds) || isAdmin()) &&
             (!isBouncedFromRoom(room, request.auth.uid) || isAdmin()) &&
             newData.reactionsByEmoji is map &&
             newData.reactionsByEmoji.size() <= 8 &&
             newData.reactionsByEmoji.keys().hasOnly(['❤️', '😂', '🔥', '👏', '😮', '👍', '🎉', '🙌']) &&
             newData.diff(oldData).affectedKeys().hasOnly(['reactionsByEmoji', 'updatedAt']);
    }

    function isValidDirectThreadDiff(data) {
      return data.updatedAt is timestamp && data.updatedAt <= request.time &&
             data.participantIds is list && data.participantIds.size() >= 1 && data.participantIds.size() <= 50 &&
             isStr(data.lastMessageText, 0, 300) &&
             isStr(data.lastMessageSenderId, 0, 128) &&
             isBoundedStringList(data.unreadByUserIds, 50);
    }

    function canUpdateDirectThread(threadId, newData, oldData) {
      let diffKeys = newData.diff(oldData).affectedKeys();
      let wasGroup = isThreadGroup(oldData);
      let sameParticipants = newData.participantIds == oldData.participantIds;
      let isGroupModAction = wasGroup && (
        ('groupAdminTalking' in diffKeys) ||
        ('groupSupportIds' in diffKeys) ||
        ('groupSupervisorIds' in diffKeys) ||
        ('pttAllowedUserIds' in diffKeys) ||
        ('mutedUserIds' in diffKeys) ||
        ('bouncedUntilByUserId' in diffKeys) ||
        ('bouncedNamesByUserId' in diffKeys) ||
        ('bannedUserIds' in diffKeys) ||
        ('bannedNamesByUserId' in diffKeys)
      );
      return wasGroup == isThreadGroup(newData) && (
        isGroupModAction
          ? (sameParticipants &&
             newData.updatedAt is timestamp && newData.updatedAt <= request.time &&
             (!('mutedUserIds' in diffKeys) || isBoundedStringList(newData.mutedUserIds, 50)) &&
             (!('bouncedUntilByUserId' in diffKeys) || (newData.bouncedUntilByUserId is map && newData.bouncedUntilByUserId.size() <= 50)) &&
             (!('bouncedNamesByUserId' in diffKeys) || (newData.bouncedNamesByUserId is map && newData.bouncedNamesByUserId.size() <= 50)) &&
             (!('lastMessageText' in diffKeys) || isStr(newData.lastMessageText, 0, 300)) &&
             (!('lastMessageSenderId' in diffKeys) || isStr(newData.lastMessageSenderId, 0, 128)) && (
               ((isGroupDmAdmin(oldData) || isAdmin()) &&
                diffKeys.hasOnly([
                  'groupAdminTalking', 'groupSupportIds', 'groupSupervisorIds', 'pttAllowedUserIds', 'pttEnabledUserIds',
                  'mutedUserIds', 'bouncedUntilByUserId', 'bouncedNamesByUserId',
                  'bannedUserIds', 'bannedNamesByUserId',
                  'lastMessageText', 'lastMessageSenderId', 'updatedAt'
                ]) &&
                (!('groupAdminTalking' in diffKeys) || newData.groupAdminTalking is bool) &&
                (!('groupSupportIds' in diffKeys) || isBoundedStringList(newData.groupSupportIds, 50)) &&
                (!('groupSupervisorIds' in diffKeys) || isBoundedStringList(newData.groupSupervisorIds, 50)) &&
                (!('pttAllowedUserIds' in diffKeys) || isBoundedStringList(newData.pttAllowedUserIds, 50)) &&
                (!('pttEnabledUserIds' in diffKeys) || isBoundedStringList(newData.pttEnabledUserIds, 50)) &&
                (!('bannedUserIds' in diffKeys) || isBoundedStringList(newData.bannedUserIds, 50)) &&
                (!('bannedNamesByUserId' in diffKeys) || (newData.bannedNamesByUserId is map && newData.bannedNamesByUserId.size() <= 50))) ||
               (isGroupDmSupport(oldData) &&
                diffKeys.hasOnly([
                  'mutedUserIds', 'bouncedUntilByUserId', 'bouncedNamesByUserId',
                  'lastMessageText', 'lastMessageSenderId', 'updatedAt'
                ]) &&
                (!('mutedUserIds' in diffKeys) || !(effectiveGroupAdminId(oldData) in newData.mutedUserIds)) &&
                (!('bouncedUntilByUserId' in diffKeys) || !(effectiveGroupAdminId(oldData) in newData.bouncedUntilByUserId)))
             ))
          : canUpdateDirectThreadStandard(threadId, newData, oldData, diffKeys, wasGroup, sameParticipants)
      );
    }

    function canUpdateDirectThreadStandard(threadId, newData, oldData, diffKeys, wasGroup, sameParticipants) {
      let notBlocked = !hasAnyThreadBlock(oldData);
      let notKicked = !isKickedFromThread(oldData, request.auth.uid);
      return isValidDirectThreadDiff(newData) && (
        // Action 15: Purchase/set 24-hour Scrolling Banner in DM (1 point)
        (('bannerText' in diffKeys) &&
         diffKeys.hasOnly([
           'bannerText', 'bannerAuthorId', 'bannerAuthorName',
           'bannerColorHex', 'bannerExpiresAtMillis', 'updatedAt'
         ]) &&
         sameParticipants && notBlocked && notKicked &&
         newData.bannerText.size() >= 1 && newData.bannerText.size() <= 140 &&
         newData.bannerAuthorId == request.auth.uid &&
         isValidHexColor(newData.bannerColorHex) &&
         newData.bannerExpiresAtMillis > request.time.toMillis() &&
         newData.bannerExpiresAtMillis <= request.time.toMillis() + 86700000 &&
         callerPaidPointsInBatch(1)) ||
        // Action 13: Send 1-2 point Priority Break-In Chirp in 1-on-1 DM
        (('lastPriorityChirpAtMillis' in diffKeys) && !wasGroup &&
         diffKeys.hasOnly([
           'lastPriorityChirpAtMillis', 'lastPriorityChirpSenderId', 'lastPriorityChirpSenderName',
           'lastPriorityChirpMessage', 'lastPriorityChirpPoints', 'lastPriorityChirpAcknowledgedBy',
           'lastMessageText', 'lastMessageSenderId', 'unreadByUserIds', 'updatedAt'
         ]) &&
         sameParticipants && notBlocked && notKicked &&
         newData.lastPriorityChirpSenderId == request.auth.uid &&
         newData.lastPriorityChirpAtMillis > 0 &&
         newData.lastPriorityChirpPoints in [1, 2] &&
         callerPaidPointsInBatch(newData.lastPriorityChirpPoints)) ||
        // Action 12: Participant toggles own opt-in for Priority Break-In Chirps
        (('priorityChirpOptInUserIds' in diffKeys) && !wasGroup &&
         diffKeys.hasOnly(['priorityChirpOptInUserIds', 'updatedAt']) &&
         sameParticipants && notBlocked && notKicked &&
         isSelfListToggle(newData, oldData, 'priorityChirpOptInUserIds')) ||
        // Action 10: Participant pins or unpins a message in this private chat
        (('pinnedMessageId' in diffKeys) &&
         diffKeys.hasOnly([
           'pinnedMessageId', 'pinnedMessageText', 'pinnedMessageSenderName',
           'pinnedByUserId', 'pinnedByName', 'pinnedAtMillis', 'updatedAt'
         ]) &&
         sameParticipants && notBlocked && notKicked &&
         (
           (newData.pinnedMessageId == '' &&
            newData.pinnedMessageText == '' &&
            newData.pinnedMessageSenderName == '' &&
            newData.pinnedByUserId == '' &&
            newData.pinnedByName == '' &&
            newData.pinnedAtMillis == 0) ||
           (newData.pinnedMessageId.size() >= 1 &&
            newData.pinnedByUserId == request.auth.uid &&
            newData.pinnedAtMillis > 0)
         )) ||
        // Action 6: Participant toggles own UID in pttEnabledUserIds (Admins toggle for all; >15 group requires Group Admin selection)
        (('pttEnabledUserIds' in diffKeys) &&
         diffKeys.hasOnly(['pttEnabledUserIds', 'updatedAt']) &&
         sameParticipants && notBlocked && notKicked &&
         (
           (isSelfListToggle(newData, oldData, 'pttEnabledUserIds') &&
            (!(request.auth.uid in newData.pttEnabledUserIds) || canUseGroupPtt(oldData, request.auth.uid))) ||
           (isAdmin() &&
            ((newData.pttEnabledUserIds.size() == oldData.participantIds.size() &&
              newData.pttEnabledUserIds.hasAll(oldData.participantIds)) ||
             newData.pttEnabledUserIds.size() == 0))
         )) ||
        // Action 5: Friend Attention Alert (accepted friends, 5-min cooldown)
        (('lastAlertAtMillis' in diffKeys) && !wasGroup &&
         diffKeys.hasOnly(['lastAlertSenderId', 'lastAlertSenderName', 'lastAlertAtMillis', 'updatedAt']) &&
         sameParticipants && notBlocked && notKicked &&
         newData.lastAlertSenderId == request.auth.uid &&
         newData.lastAlertAtMillis > 0 &&
         newData.lastAlertAtMillis <= request.time.toMillis() + 60000 &&
         exists(/databases/$(database)/documents/friendships/$(threadId)) &&
         get(/databases/$(database)/documents/friendships/$(threadId)).data.status == 'ACCEPTED' &&
         (!('lastAlertAtMillis' in oldData) ||
          oldData.lastAlertAtMillis == 0 ||
          oldData.lastAlertSenderId != request.auth.uid ||
          (request.time.toMillis() - oldData.lastAlertAtMillis) >= 300000)) ||
        // Action 4: 1-on-1 participant blocks or unblocks contact in this chat
        (('blockedByUserIds' in diffKeys) && !wasGroup &&
         diffKeys.hasOnly(['blockedByUserIds', 'unreadByUserIds', 'updatedAt']) &&
         sameParticipants &&
         isSelfListToggle(newData, oldData, 'blockedByUserIds')) ||
        // Action 3: Recipient kicks a paid DM member
        (('kickedUserIds' in diffKeys) && !wasGroup &&
         diffKeys.hasOnly(['kickedUserIds', 'lastMessageText', 'lastMessageSenderId', 'updatedAt']) &&
         sameParticipants &&
         !isKickedFromThread(newData, request.auth.uid)) ||
        // Action 7: Disappearing messages timer
        (('disappearingDurationSec' in diffKeys) &&
         diffKeys.hasOnly(['disappearingDurationSec', 'updatedAt']) &&
         newData.disappearingDurationSec in [0, 30, 300, 3600, 86400] &&
         sameParticipants && notBlocked && notKicked) ||
        // Action 8: Toggle read receipts preference
        (('readReceiptsDisabledByUserIds' in diffKeys) &&
         diffKeys.hasOnly(['readReceiptsDisabledByUserIds', 'updatedAt']) &&
         sameParticipants && notBlocked && notKicked &&
         isSelfListToggle(newData, oldData, 'readReceiptsDisabledByUserIds')) ||
        // Action 2: Add new members or update group name in existing group chat (or self-join / owner-manage company thread)
        (wasGroup && (('participantIds' in diffKeys) || ('groupName' in diffKeys) || ('participantNamesById' in diffKeys)) &&
         diffKeys.hasOnly([
           'participantIds', 'participantNamesById', 'groupName',
           'lastMessageText', 'lastMessageSenderId', 'unreadByUserIds', 'updatedAt'
         ]) &&
         notKicked &&
         ((newData.participantIds.hasAll(oldData.participantIds) &&
           (!('participantIds' in diffKeys) ||
            (newData.participantIds.size() <= 50 &&
             newData.participantIds.size() <= groupMaxMembersForUid(effectiveGroupAdminId(oldData))))) ||
          (isGroupDmAdmin(oldData) && ('companyOwnerId' in oldData) && oldData.companyOwnerId == request.auth.uid &&
           request.auth.uid in newData.participantIds))) ||
        // Action 1: Normal messaging preview / unread / acknowledge priority chirp / talk streak updates
        (sameParticipants &&
         notKicked &&
         ((notBlocked &&
           diffKeys.hasOnly([
             'userAName', 'userAColorHex', 'userATier',
             'userBName', 'userBColorHex', 'userBTier',
             'lastMessageText', 'lastMessageSenderId',
             'unreadByUserIds', 'readTimestampsByUserId', 'lastPriorityChirpAcknowledgedBy',
             'talkStreakCount', 'talkStreakLastMutualDay', 'lastMessageDayByUserId',
             'updatedAt'
           ])) ||
          (!notBlocked &&
           diffKeys.hasOnly(['unreadByUserIds', 'lastPriorityChirpAcknowledgedBy', 'updatedAt'])))) ||
        // Action 9: Admin routes a user to a Support member's 1-on-1 private chat
        (!wasGroup &&
         diffKeys.hasOnly(['lastMessageText', 'lastMessageSenderId', 'unreadByUserIds', 'updatedAt']) &&
         sameParticipants &&
         isAdmin())
      );
    }

    function canSendMessageInThread(threadData, msgData) {
      let isGroup = isThreadGroup(threadData);
      return request.auth.uid in threadData.participantIds &&
             !isKickedFromThread(threadData, request.auth.uid) &&
             (!('hideSenderName' in msgData) || msgData.hideSenderName == false || isGroup) &&
             (isGroup
               ? (!isMutedInGroupDm(threadData, request.auth.uid) &&
                  !isBannedFromGroupDm(threadData, request.auth.uid) &&
                  !isBouncedInGroupDm(threadData, request.auth.uid) &&
                  (!('audioBase64' in msgData) || msgData.audioBase64.size() == 0 || canUseGroupPtt(threadData, request.auth.uid)))
               : (!hasAnyThreadBlock(threadData) && canMessageUser(otherOneOnOneUid(threadData))));
    }

    function isValidUserProfileDiff(data, diffKeys) {
      return isStr(data.displayName, 1, 40) &&
             isStr(data.handle, 2, 30) &&
             isStr(data.bio, 0, 200) &&
             isValidHexColor(data.avatarColorHex) &&
             (!('sex' in data) || data.sex in ['UNSPECIFIED', 'MALE', 'FEMALE']) &&
             (!('appearanceStatus' in data) || data.appearanceStatus in ['ONLINE', 'IDLE', 'OFFLINE']) &&
             (!('age' in data) || (data.age is int && (data.age == 0 || (data.age >= 13 && data.age <= 120)))) &&
             (!('age13Verified' in data) || !data.age13Verified || isAge13VerifiedProfile(data)) &&
             (!('adultVerified' in data) || !data.adultVerified || isAdultVerifiedProfile(data)) &&
             (!('pointsBalance' in data) || (isNonNeg(data.pointsBalance) && data.pointsBalance <= 1000000)) &&
             (!('proTier' in data) || data.proTier in ['FREE', 'PRO', 'VIP_PRO', 'ELITE_PRO']) &&
             (!('doNotDisturb' in data) || data.doNotDisturb is bool) &&
             (!('companySubAccount' in data) || data.companySubAccount is bool) &&
             (!('disableMessaging' in data) || data.disableMessaging is bool) &&
             (!('pictureUploadTimestamps' in diffKeys) || isValidPictureTimestampList(data.pictureUploadTimestamps)) &&
             (!('discoveryPhotoTimestamps' in diffKeys) || isValidDiscoveryPhotoTimestampList(data.discoveryPhotoTimestamps));
    }

    function canUpdateUserDoc(userId, newData, oldData) {
      let diffKeys = newData.diff(oldData).affectedKeys();
      return newData.updatedAt is timestamp && newData.updatedAt <= request.time && (
             (isAdmin() &&
              diffKeys.hasOnly([
                'displayName', 'handle', 'bio', 'avatarColorHex', 'photoBase64',
                'invisibleModePreferred', 'globallyBanned',
                'disableCreateRoom', 'disableEnterRoom',
                'disableMic', 'disableVideo', 'disableMessaging', 'lastDeviceId',
                'addPeopleTimestamps', 'spamViolationTimestamps', 'pointsBalance',
                'proMember', 'proExpiresAtMillis', 'proLifetime', 'proTier',
                'customDisplayName', 'customNameColorHex', 'customMembershipTier',
                'companySubAccount', 'parentCompanyOwnerId', 'companyName', 'companyThreadId', 'subAccountId', 'doNotDisturb',
                'spotlightFrameUntilMillis', 'spotlightFrameColorHex',
                'ownedPttThemes', 'selectedPttTheme',
                'ownedPttChirps', 'selectedPttChirp',
                'profileViewersUnlockedUntilMillis', 'profileBoostedUntilMillis',
                'suspendedUntilMillis', 'suspensionReason', 'updatedAt'
              ])) ||
             (request.auth.uid == userId
              ? ((('companySubAccount' in diffKeys) &&
                  diffKeys.hasOnly(['companySubAccount', 'parentCompanyOwnerId', 'companyName', 'companyThreadId', 'subAccountId', 'displayName', 'doNotDisturb', 'updatedAt']) &&
                  newData.companySubAccount == true &&
                  isValidId(newData.subAccountId) &&
                  exists(/databases/$(database)/documents/companySubAccounts/$(newData.subAccountId)) &&
                  get(/databases/$(database)/documents/companySubAccounts/$(newData.subAccountId)).data.claimedUserId == request.auth.uid &&
                  get(/databases/$(database)/documents/companySubAccounts/$(newData.subAccountId)).data.ownerId == newData.parentCompanyOwnerId &&
                  get(/databases/$(database)/documents/companySubAccounts/$(newData.subAccountId)).data.companyThreadId == newData.companyThreadId) ||
                 (('spamViolationTimestamps' in diffKeys) &&
                  diffKeys.hasOnly(['spamViolationTimestamps', 'suspendedUntilMillis', 'suspensionReason', 'updatedAt']) &&
                  newData.spamViolationTimestamps.size() >= 1 &&
                  (!('suspendedUntilMillis' in diffKeys) ||
                   newData.suspendedUntilMillis > existingInt(oldData, 'suspendedUntilMillis'))) ||
                 (('spotlightFrameUntilMillis' in diffKeys) &&
                  isValidOwnerSpotlightFramePurchase(newData, oldData, diffKeys)) ||
                 (('profileViewersUnlockedUntilMillis' in diffKeys) &&
                  isValidOwnerProfileViewersUnlock(newData, oldData, diffKeys)) ||
                 (('lastLoginDayKey' in diffKeys) &&
                  isValidOwnerDailyLoginStreakUpdate(newData, oldData, diffKeys)) ||
                 ((('referralCode' in diffKeys) || ('referredByUserId' in diffKeys) || ('referralBonusClaimed' in diffKeys)) &&
                  isValidOwnerReferralUpdate(userId, newData, oldData, diffKeys)) ||
                 (('pointsBalance' in diffKeys) && diffKeys.size() <= 2 &&
                  isValidOwnerMicroPointSpend(newData, oldData, diffKeys)) ||
                 ((('pointsBalance' in diffKeys) || ('totalSpentCents' in diffKeys) ||
                   ('proMember' in diffKeys) || ('proTier' in diffKeys) || ('profileBoostedUntilMillis' in diffKeys) ||
                   ('ownedPttThemes' in diffKeys) || ('ownedPttChirps' in diffKeys)) &&
                  isValidOwnerWalletUpdate(newData, oldData, diffKeys)) ||
                 (diffKeys.hasOnly([
                    'displayName', 'handle', 'bio', 'avatarColorHex', 'photoBase64',
                    'pushToTalkPreferred', 'darkThemePreferred', 'nightModeEnabled',
                    'invisibleModePreferred', 'dmPolicy', 'age13Verified', 'adultVerified', 'birthYear',
                    'sex', 'age', 'totalTimeSpentSec', 'appearanceStatus', 'priorityChirpOptIn',
                    'doNotDisturb',
                    'selectedPttTheme', 'selectedPttChirp', 'lastDeviceId', 'addPeopleTimestamps',
                    'blockedUserIds', 'pictureUploadTimestamps',
                    'discoveryPhotoTimestamps', 'updatedAt'
                  ]) &&
                  (!('invisibleModePreferred' in diffKeys) || !newData.invisibleModePreferred || canUseInvisibleMode()) &&
                  (!('selectedPttTheme' in diffKeys) || newData.selectedPttTheme == 'CLASSIC' || (('ownedPttThemes' in oldData) && newData.selectedPttTheme in oldData.ownedPttThemes)) &&
                  (!('selectedPttChirp' in diffKeys) || newData.selectedPttChirp == 'STANDARD' || (('ownedPttChirps' in oldData) && newData.selectedPttChirp in oldData.ownedPttChirps)) &&
                  canUpdatePictureUploadTimestamps(newData, oldData, diffKeys) &&
                  canUpdateDiscoveryPhotoTimestamps(newData, oldData, diffKeys) &&
                  (!('photoBase64' in diffKeys) || newData.photoBase64.size() == 0 || callerUnderPictureUploadLimit()) &&
                  (!('totalTimeSpentSec' in diffKeys) ||
                   (newData.totalTimeSpentSec >= existingInt(oldData, 'totalTimeSpentSec') &&
                    newData.totalTimeSpentSec <= existingInt(oldData, 'totalTimeSpentSec') + 86400))))
              : ((('creatorEarnedPoints' in diffKeys) &&
                  isValidCreatorEarningsCredit(newData, oldData, diffKeys)) ||
                 (('referralEarnedPoints' in diffKeys) &&
                  isValidInviterReferralCredit(userId, newData, oldData, diffKeys)) ||
                 (isSupport() && (
                  (!isTargetAdmin(userId) &&
                   diffKeys.hasOnly(['suspendedUntilMillis', 'suspensionReason', 'disableMessaging', 'updatedAt'])) ||
                  diffKeys.hasOnly([
                    'pointsBalance', 'proMember', 'proExpiresAtMillis', 'proLifetime', 'proTier',
                    'spotlightFrameUntilMillis', 'spotlightFrameColorHex',
                    'ownedPttThemes', 'selectedPttTheme',
                    'ownedPttChirps', 'selectedPttChirp',
                    'profileViewersUnlockedUntilMillis', 'profileBoostedUntilMillis',
                    'updatedAt'
                  ])))))
      ) && isValidUserProfileDiff(newData, diffKeys);
    }

    // --- 1. USERS COLLECTION ---
    match /users/{userId} {
      allow get: if isSignedIn() &&
                    isValidId(userId) &&
                    (request.auth.uid == userId || isAdminOrSupport());

      allow list: if isSignedIn() && isAdmin();

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       hasNoSelfRestrictionOverrides(incoming()) &&
                       (!('invisibleModePreferred' in incoming()) || !incoming().invisibleModePreferred || canUseInvisibleMode()) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       canUpdateUserDoc(userId, incoming(), existing());

      allow delete: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
    }

    // --- 1b. STAFF ROLES (Admin & Support Registry) ---
    match /staffRoles/{userId} {
      allow get: if isSignedIn() &&
                    isValidId(userId) &&
                    (request.auth.uid == userId || isAdmin());

      allow list: if isSignedIn() &&
                     (isAdmin() || resource.data.userId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       incoming().userId == userId &&
                       isValidStaffRole(incoming()) && (
                         // Admin directly assigning ADMIN or SUPPORT role (with optional canEnterInvisible)
                         isAdmin() ||
                         // Invited user claiming their ADMIN or SUPPORT role via verified email invite
                         (request.auth.uid == userId &&
                          'inviteId' in incoming() &&
                          isValidId(incoming().inviteId) &&
                          hasVerifiedEmail() &&
                          exists(/databases/$(database)/documents/staffInvites/$(incoming().inviteId)) &&
                          get(/databases/$(database)/documents/staffInvites/$(incoming().inviteId)).data.email == request.auth.token.email &&
                          incoming().staffTier == get(/databases/$(database)/documents/staffInvites/$(incoming().inviteId)).data.staffTier &&
                          (
                            incoming().staffTier == 'ADMIN' ||
                            !('canEnterInvisible' in incoming()) ||
                            incoming().canEnterInvisible == false ||
                            (('canEnterInvisible' in get(/databases/$(database)/documents/staffInvites/$(incoming().inviteId)).data) &&
                             get(/databases/$(database)/documents/staffInvites/$(incoming().inviteId)).data.canEnterInvisible == true)
                          ))
                       );

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isAdmin() &&
                       (existing().email != 'daj18801@gmail.com' || isBootstrappedAdmin()) &&
                       incoming().staffTier in ['ADMIN', 'SUPPORT'] &&
                       isStr(incoming().displayName, 1, 40) &&
                       (!('canEnterInvisible' in incoming()) || incoming().canEnterInvisible is bool) &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'email', 'displayName', 'staffTier', 'canEnterInvisible', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() &&
                       isValidId(userId) &&
                       isAdmin() &&
                       (existing().email != 'daj18801@gmail.com' || isBootstrappedAdmin());
    }

    // --- 1c. STAFF INVITES (Email-based Admin & Support Staff Invitations) ---
    match /staffInvites/{inviteId} {
      allow get: if isSignedIn() &&
                    isValidId(inviteId) &&
                    (isAdmin() ||
                     (resource != null &&
                      hasVerifiedEmail() &&
                      existing().email == request.auth.token.email));

      allow list: if isSignedIn() &&
                     (isAdmin() ||
                      (hasVerifiedEmail() &&
                       resource.data.email == request.auth.token.email));

      allow create: if isSignedIn() &&
                       isValidId(inviteId) &&
                       isAdmin() &&
                       incoming().addedByUid == request.auth.uid &&
                       isValidStaffInvite(incoming());

      allow update: if isSignedIn() &&
                       isValidId(inviteId) &&
                       isAdmin() &&
                       isStr(incoming().displayName, 1, 40) &&
                       (!('canEnterInvisible' in incoming()) || incoming().canEnterInvisible is bool) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'canEnterInvisible'
                       ]);

      allow delete: if isSignedIn() && isValidId(inviteId) && isAdmin();
    }

    // --- 1d. USER ALERTS (Admin & Support Alerts; Editable & Deletable by Admin) ---
    match /userAlerts/{alertId} {
      allow get: if isSignedIn() &&
                    isValidId(alertId) &&
                    (resource == null ||
                     existing().targetUserId == request.auth.uid ||
                     existing().senderId == request.auth.uid ||
                     isAdmin());

      allow list: if isSignedIn() &&
                     (resource.data.targetUserId == request.auth.uid ||
                      resource.data.senderId == request.auth.uid ||
                      isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(alertId) &&
                       isAdminOrSupport() &&
                       incoming().senderId == request.auth.uid &&
                       incoming().acknowledged == false &&
                       ((incoming().senderTier == 'ADMIN' && isAdmin()) ||
                        (incoming().senderTier == 'SUPPORT' && isAdminOrSupport())) &&
                       isValidUserAlert(incoming());

      allow update: if isSignedIn() &&
                       isValidId(alertId) &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time && (
                         // Recipient acknowledges unread alert
                         (existing().acknowledged == false &&
                          incoming().acknowledged == true &&
                          existing().targetUserId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['acknowledged', 'updatedAt'])) ||
                         // Admin edits alert title, message, severity, or re-opens acknowledged state
                         (isAdmin() &&
                          isStr(incoming().title, 1, 80) &&
                          isStr(incoming().message, 1, 500) &&
                          incoming().severity in ['INFO', 'WARNING', 'URGENT'] &&
                          incoming().acknowledged is bool &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'title', 'message', 'severity', 'acknowledged', 'updatedAt'
                          ]))
                       );

      allow delete: if isSignedIn() && isValidId(alertId) && isAdmin();
    }

    // --- 2. ROOMS COLLECTION ---
    match /rooms/{roomId} {
      allow get: if isValidId(roomId) && (
                    (resource != null && existing().visibility == 'PUBLIC') ||
                    (isSignedIn() &&
                     (resource == null ||
                      existing().hostId == request.auth.uid ||
                      request.auth.uid in existing().moderatorIds ||
                      isAdminOrSupport()))
                  );

      allow list: if resource.data.visibility == 'PUBLIC' ||
                     (isSignedIn() &&
                      (resource.data.hostId == request.auth.uid ||
                       isAdmin()));

      allow create: if isSignedIn() &&
                       isValidId(roomId) &&
                       incoming().hostId == request.auth.uid &&
                       incoming().status == 'LIVE' &&
                       incoming().title.size() >= 3 &&
                       (!('adminMicPriorityActive' in incoming()) || incoming().adminMicPriorityActive == false) &&
                       callerPassesProfileChecks(true, false, false, false) &&
                       (!('hostTier' in incoming()) || isAllowedStaffTierClaim(incoming().hostTier)) &&
                       isValidRoom(incoming());

      function canUpdateRoom(newData, oldData) {
        let diffKeys = newData.diff(oldData).affectedKeys();
        let isHost = oldData.hostId == request.auth.uid;
        let isAdminCaller = isAdmin();
        return oldData.status == 'LIVE' &&
               newData.updatedAt is timestamp && newData.updatedAt <= request.time &&
               (!('title' in diffKeys) || isStr(newData.title, 0, 60)) &&
               (!('topic' in diffKeys) || isStr(newData.topic, 0, 160)) &&
               (!('visibility' in diffKeys) || newData.visibility in ['PUBLIC', 'PRIVATE']) &&
               (!('slowModeSeconds' in diffKeys) || newData.slowModeSeconds in [0, 3, 10, 30]) &&
               (!('maxSpeakers' in diffKeys) || (newData.maxSpeakers is int && newData.maxSpeakers >= 2 && newData.maxSpeakers <= 12)) &&
               (!('participantCount' in diffKeys) || (newData.participantCount is int && newData.participantCount >= 0 && newData.participantCount <= 1000)) &&
               (!('pinLocked' in diffKeys) || !newData.pinLocked || (newData.get('roomPinCode', '') is string && newData.get('roomPinCode', '').matches('^[0-9]{4}$'))) &&
               (!('roomPinCode' in diffKeys) || newData.roomPinCode == '' || (newData.roomPinCode is string && newData.roomPinCode.matches('^[0-9]{4}$'))) &&
               (!('moderatorIds' in diffKeys) || (isBoundedStringList(newData.moderatorIds, 20) && oldData.hostId in newData.moderatorIds)) && (
                 ((isAdminCaller || isHost) &&
                  newData.status == 'LIVE' &&
                  (!('adminMicPriorityActive' in diffKeys) || isAdminCaller) &&
                  diffKeys.hasOnly([
                    'title', 'topic', 'category', 'coverKey', 'visibility',
                    'videoEnabled', 'autoModEnabled', 'autoModBlockMode',
                    'linksBlocked', 'roomLocked', 'pinLocked', 'roomPinCode', 'stageMicLocked',
                    'adminMicPriorityActive', 'slowModeSeconds', 'maxSpeakers',
                    'moderatorIds', 'bannedUserIds', 'bannedNamesByUserId',
                    'bouncedUntilByUserId', 'bouncedNamesByUserId', 'mutedUserIds', 'blockedWords', 'updatedAt'
                  ])) ||
                 (!isHost &&
                  (request.auth.uid in oldData.moderatorIds || isSupport()) &&
                  newData.status == 'LIVE' &&
                  diffKeys.hasOnly([
                    'topic', 'videoEnabled', 'autoModEnabled', 'autoModBlockMode',
                    'linksBlocked', 'roomLocked', 'stageMicLocked',
                    'slowModeSeconds', 'bouncedUntilByUserId', 'bouncedNamesByUserId', 'mutedUserIds',
                    'blockedWords', 'updatedAt'
                  ])) ||
                 ((isHost || isAdminCaller) &&
                  newData.status == 'CLOSED' &&
                  diffKeys.hasOnly(['status', 'updatedAt'])) ||
                 ((!(request.auth.uid in oldData.bannedUserIds) || isAdminOrSupport()) &&
                  diffKeys.hasOnly(['participantCount', 'updatedAt']) &&
                  (newData.participantCount == oldData.participantCount + 1 ||
                   newData.participantCount == oldData.participantCount - 1))
               );
      }

      allow update: if isSignedIn() && isValidId(roomId) && canUpdateRoom(incoming(), existing());

      allow delete: if isSignedIn() && isValidId(roomId) && (existing().hostId == request.auth.uid || isAdmin());

      // --- 2a. ROOM PARTICIPANTS SUBCOLLECTION ---
      match /participants/{participantId} {
        allow get: if isSignedIn() &&
                      isValidId(roomId) &&
                      isValidId(participantId) &&
                      (resource == null
                        ? (participantId == request.auth.uid || isRoomHostOrMod(roomId))
                        : existing().roomId == roomId);
        allow list: if isSignedIn() && resource.data.roomId == roomId;

        function canCreateParticipant(rId, pId, data) {
          let room = roomDoc(rId).data;
          let inv = ('invisible' in data) && data.invisible;
          return pId == request.auth.uid &&
                 data.userId == request.auth.uid &&
                 data.roomId == rId &&
                 isValidParticipant(data) &&
                 room.status == 'LIVE' &&
                 (!('staffTier' in data) || isAllowedStaffTierClaim(data.staffTier)) &&
                 (data.mutedByMod == (request.auth.uid in room.mutedUserIds)) &&
                 (isAdmin() || (
                   (!inv || canUseInvisibleMode() || room.hostId == request.auth.uid) &&
                   (!inv || !data.micActive) &&
                   (!callerProfileExists() || isProfileAllowed(callerProfile(), false, true, data.micActive, data.camActive)) &&
                   !(request.auth.uid in room.bannedUserIds) &&
                   !isBouncedFromRoom(room, request.auth.uid) &&
                   (!(room.visibility == 'PRIVATE') || inv || room.hostId == request.auth.uid || room.participantCount < privateRoomCapForHost(room.hostId)) &&
                   (!data.mutedByMod || !data.micActive) &&
                   (!data.micActive || !('adminMicPriorityActive' in room) || !room.adminMicPriorityActive) &&
                   (
                     (data.role == 'HOST' && room.hostId == request.auth.uid) ||
                     ((room.hostId == request.auth.uid || request.auth.uid in room.moderatorIds || isSupport()) &&
                      data.role in ['MODERATOR', 'SPEAKER', 'LISTENER']) ||
                     (data.role in ['SPEAKER', 'LISTENER'] &&
                      !room.roomLocked &&
                      (!('pinLocked' in room) || !room.pinLocked || (('enteredPin' in data) && data.enteredPin == room.roomPinCode)))
                   )
                 ));
        }

        function canUpdateParticipant(rId, pId, data, oldData) {
          let room = roomDoc(rId).data;
          let inv = ('invisible' in data) && data.invisible;
          return data.updatedAt is timestamp && data.updatedAt <= request.time &&
                 isStr(data.displayName, 1, 40) &&
                 data.role in ['HOST', 'MODERATOR', 'SPEAKER', 'LISTENER'] &&
                 data.micActive is bool && data.camActive is bool &&
                 data.handRaised is bool && data.mutedByMod is bool &&
                 data.speakingLevel is number && data.speakingLevel >= 0.0 && data.speakingLevel <= 1.0 && (
                   (isAdmin() &&
                    data.diff(oldData).affectedKeys().hasOnly([
                      'displayName', 'avatarColorHex', 'role', 'staffTier', 'invisible',
                      'micActive', 'camActive', 'handRaised', 'mutedByMod', 'speakingLevel', 'updatedAt'
                    ])) ||
                   ((!inv || canUseInvisibleMode() || room.hostId == request.auth.uid) &&
                    (!inv || !data.micActive) && (
                      (request.auth.uid == pId &&
                       (!oldData.mutedByMod || !data.micActive) &&
                       (!data.micActive || !('adminMicPriorityActive' in room) || !room.adminMicPriorityActive) &&
                       (!callerProfileExists() || isProfileAllowed(callerProfile(), false, false, data.micActive, data.camActive)) &&
                       (!('staffTier' in data) || isAllowedStaffTierClaim(data.staffTier)) &&
                       data.diff(oldData).affectedKeys().hasOnly([
                         'displayName', 'avatarColorHex', 'staffTier', 'invisible',
                         'micActive', 'camActive', 'handRaised', 'speakingLevel', 'updatedAt'
                       ])) ||
                      (request.auth.uid != pId &&
                       (room.hostId == request.auth.uid || request.auth.uid in room.moderatorIds || isSupport()) &&
                       !isTargetAdmin(pId) &&
                       (!data.micActive || oldData.micActive == data.micActive) &&
                       data.diff(oldData).affectedKeys().hasOnly([
                         'role', 'staffTier', 'micActive', 'camActive', 'handRaised',
                         'mutedByMod', 'updatedAt'
                       ]))
                    ))
                 );
        }

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(participantId) &&
                         roomExists(roomId) &&
                         canCreateParticipant(roomId, participantId, incoming());

        allow update: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(participantId) &&
                         roomExists(roomId) &&
                         canUpdateParticipant(roomId, participantId, incoming(), existing());

        allow delete: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(participantId) &&
                         (request.auth.uid == participantId ||
                          (isRoomHostOrMod(roomId) && (!isTargetAdmin(participantId) || isAdmin())));
      }

      // --- 2b. ROOM MESSAGES SUBCOLLECTION ---
      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(messageId) && existing().roomId == roomId;
        allow list: if isSignedIn() && resource.data.roomId == roomId;

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(messageId) &&
                         incoming().roomId == roomId &&
                         incoming().senderId == request.auth.uid &&
                         incoming().deletedByMod == false &&
                         callerCanSendMessage() &&
                         (!('senderTier' in incoming()) || isAllowedStaffTierClaim(incoming().senderTier)) &&
                         isValidMessage(incoming()) &&
                         roomExists(roomId) &&
                         roomDoc(roomId).data.status == 'LIVE' &&
                         (!(request.auth.uid in roomDoc(roomId).data.bannedUserIds) || isAdmin()) &&
                         (!isBouncedFromRoom(roomDoc(roomId).data, request.auth.uid) || isAdmin()) &&
                         (!(request.auth.uid in roomDoc(roomId).data.mutedUserIds) || isAdmin());

        allow update: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(messageId) &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time && (
                           (isRoomHostOrMod(roomId) &&
                            incoming().deletedByMod == true &&
                            isStr(incoming().text, 0, 500) &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['text', 'deletedByMod', 'updatedAt'])) ||
                           canToggleMessageReaction(roomId, incoming(), existing())
                         );

        allow delete: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(messageId) &&
                         (existing().senderId == request.auth.uid || isRoomHostOrMod(roomId));
      }

      // --- 2c. ROOM MODERATION AUDIT LOGS SUBCOLLECTION ---
      match /modLogs/{logId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(logId) && existing().roomId == roomId;
        allow list: if isSignedIn() && resource.data.roomId == roomId;

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(logId) &&
                         incoming().roomId == roomId &&
                         incoming().actorId == request.auth.uid &&
                         isValidModLog(incoming()) &&
                         roomExists(roomId) &&
                         (incoming().actionType == 'AUTO_MOD' || isRoomHostOrMod(roomId));

        allow update, delete: if false;
      }
    }

    // --- 3. SAFETY REPORTS COLLECTION ---
    match /safetyReports/{reportId} {
      allow get: if isSignedIn() &&
                    isValidId(reportId) &&
                    (existing().reporterId == request.auth.uid ||
                     existing().roomHostId == request.auth.uid ||
                     isAdminOrSupport());

      allow list: if isSignedIn() &&
                     (resource.data.reporterId == request.auth.uid ||
                      resource.data.roomHostId == request.auth.uid ||
                      isAdminOrSupport());

      allow create: if isSignedIn() &&
                       isValidId(reportId) &&
                       incoming().reporterId == request.auth.uid &&
                       incoming().status == 'OPEN' &&
                       incoming().resolutionNote == '' &&
                       isValidSafetyReport(incoming()) && (
                         (incoming().targetUserId == request.auth.uid &&
                          incoming().roomId == 'AUTOMOD_SPAM' &&
                          incoming().roomHostId == 'SYSTEM_AUTOMOD' &&
                          incoming().category == 'SPAM_SCAM') ||
                         (existsAfter(/databases/$(database)/documents/reportRateLimits/$(request.auth.uid)) &&
                          getAfter(/databases/$(database)/documents/reportRateLimits/$(request.auth.uid)).data.lastReportId == reportId &&
                          getAfter(/databases/$(database)/documents/reportRateLimits/$(request.auth.uid)).data.lastTargetUserId == incoming().targetUserId && (
                            (roomExists(incoming().roomId) &&
                             roomDoc(incoming().roomId).data.hostId == incoming().roomHostId) ||
                            (exists(/databases/$(database)/documents/directThreads/$(incoming().roomId)) &&
                             request.auth.uid in get(/databases/$(database)/documents/directThreads/$(incoming().roomId)).data.participantIds &&
                             incoming().roomHostId == request.auth.uid)
                          ))
                       );

      allow update: if isSignedIn() &&
                       isValidId(reportId) &&
                       existing().status == 'OPEN' &&
                       incoming().status in ['RESOLVED', 'DISMISSED'] &&
                       isStr(incoming().resolutionNote, 0, 300) &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       (existing().roomHostId == request.auth.uid ||
                        existing().reporterId == request.auth.uid ||
                        isAdminOrSupport()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'resolutionNote', 'updatedAt']);

      allow delete: if false;
    }

    // --- 4. PUBLIC USER DIRECTORY (Non-sensitive friend discovery & 1-day trial preview) ---
    match /userDirectory/{userId} {
      allow get, list: if true;

      allow create, update: if isSignedIn() &&
                               isValidId(userId) &&
                               incoming().userId == (resource == null ? userId : existing().userId) &&
                               isValidDirectoryEntry(incoming()) && (
                                 (request.auth.uid == userId &&
                                  isAllowedStaffTierClaim(incoming().staffTier) &&
                                  isAllowedProDirectoryClaim(incoming()) &&
                                  isAllowedBoostedProfileDirectoryClaim(incoming()) &&
                                  isAllowedSpotlightFrameDirectoryClaim(incoming())) ||
                                 isAdmin() ||
                                 (resource != null && isSupport() &&
                                  incoming().diff(existing()).affectedKeys().hasOnly([
                                    'proMember', 'proExpiresAtMillis', 'proLifetime', 'proTier',
                                    'spotlightFrameUntilMillis', 'spotlightFrameColorHex',
                                    'profileBoostedUntilMillis', 'disableMessaging', 'updatedAt'
                                  ]))
                               );

      allow delete: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
    }

    // --- 5. FRIENDSHIPS & FRIEND REQUESTS ---
    match /friendships/{friendshipId} {
      allow get: if isSignedIn() &&
                    (resource == null ||
                     request.auth.uid in existing().userIds ||
                     isAdmin());

      allow list: if isSignedIn() &&
                     request.auth.uid in resource.data.userIds;

      allow create: if isSignedIn() &&
                       !isCallerSubAccount() &&
                       incoming().requesterId == request.auth.uid &&
                       incoming().status == 'PENDING' &&
                       isAllowedStaffTierClaim(incoming().requesterTier) &&
                       isValidFriendship(incoming());

      allow update: if isSignedIn() &&
                       existing().status == 'PENDING' &&
                       incoming().status == 'ACCEPTED' &&
                       existing().recipientId == request.auth.uid &&
                       isStr(incoming().recipientName, 1, 40) &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'status', 'recipientName', 'recipientHandle',
                         'recipientColorHex', 'recipientTier', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() &&
                       (request.auth.uid in existing().userIds || isAdmin());
    }

    // --- 6. DIRECT PRIVATE MESSAGE & GROUP CHAT THREADS ---
    match /directThreads/{threadId} {
      allow get: if isSignedIn() &&
                    (resource == null ||
                     request.auth.uid in existing().participantIds ||
                     canSubAccountJoinCompanyThread(threadId, existing()) ||
                     isAdmin());

      allow list: if isSignedIn() &&
                     request.auth.uid in resource.data.participantIds;

      allow create: if isSignedIn() && canCreateDirectThread(incoming());

      allow update: if isSignedIn() &&
                       (request.auth.uid in existing().participantIds ||
                        canSubAccountJoinCompanyThread(threadId, existing()) ||
                        (isAdmin() && !isThreadGroup(existing()))) &&
                       incoming().userAId == existing().userAId &&
                       incoming().userBId == existing().userBId &&
                       incoming().createdAt == existing().createdAt &&
                       canUpdateDirectThread(threadId, incoming(), existing());

      allow delete: if isSignedIn() &&
                       (request.auth.uid in existing().participantIds || isAdmin());

      match /messages/{messageId} {
        allow get: if isSignedIn() &&
                      isValidId(messageId) &&
                      (request.auth.uid in existing().participantIds || isAdmin());

        // Single-filter rule matching client whereArrayContains("participantIds", uid) — zero composite indexes!
        allow list: if isSignedIn() &&
                       request.auth.uid in resource.data.participantIds;

        allow create: if isSignedIn() &&
                         isValidId(messageId) &&
                         incoming().threadId == threadId &&
                         incoming().senderId == request.auth.uid &&
                         isAllowedStaffTierClaim(incoming().senderTier) &&
                         callerCanSendMessage() &&
                         (!('imageBase64' in incoming()) || incoming().imageBase64.size() == 0 || callerUnderPictureUploadLimit()) &&
                         isValidDirectMessage(incoming()) &&
                         exists(/databases/$(database)/documents/directThreads/$(threadId)) && (
                           (request.auth.uid in incoming().participantIds &&
                            canSendMessageInThread(get(/databases/$(database)/documents/directThreads/$(threadId)).data, incoming())) ||
                           (isAdmin() &&
                            ('messageType' in incoming()) &&
                            incoming().messageType == 'SUPPORT_HANDOFF' &&
                            incoming().participantIds == get(/databases/$(database)/documents/directThreads/$(threadId)).data.participantIds)
                         );

        allow update: if isSignedIn() &&
                         isValidId(messageId) &&
                         request.auth.uid in existing().participantIds &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['reactionsByUserId']) &&
                         incoming().reactionsByUserId is map && incoming().reactionsByUserId.size() <= 20 &&
                         canToggleDirectMessageReaction(incoming(), existing());

        allow delete: if isSignedIn() &&
                         isValidId(messageId) &&
                         (existing().senderId == request.auth.uid || isAdmin());
      }
    }

    // --- 6b. PAID PRIVATE MESSAGE ACCESS PASSES ($5 to app owner; recipient earns +1 usable point; kickable by recipient) ---
    match /dmAccessPasses/{passId} {
      allow get: if isSignedIn() &&
                    (resource == null ||
                     existing().senderId == request.auth.uid ||
                     existing().recipientId == request.auth.uid ||
                     isAdminOrSupport());

      allow list: if isSignedIn() &&
                     (resource.data.senderId == request.auth.uid ||
                      resource.data.recipientId == request.auth.uid ||
                      isAdminOrSupport());

      allow create: if isSignedIn() &&
                       incoming().senderId == request.auth.uid &&
                       incoming().senderId != incoming().recipientId &&
                       passId == incoming().senderId + '_' + incoming().recipientId &&
                       incoming().active == true &&
                       incoming().kicked == false &&
                       isValidDmAccessPass(incoming());

      allow update: if isSignedIn() &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time && (
                         ((existing().recipientId == request.auth.uid || isAdmin()) &&
                          incoming().active == false &&
                          incoming().kicked == true &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['active', 'kicked', 'updatedAt'])) ||
                         (isAdminOrSupport() &&
                          incoming().active == false &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['active', 'updatedAt']))
                       );

      allow delete: if isSignedIn() &&
                       (existing().recipientId == request.auth.uid || isAdmin());
    }

    // --- 7. PROFILE POSTS (Public Updates, Pictures, Comments, Shares & Discovery Boosts) ---
    match /profilePosts/{postId} {
      allow get: if isSignedIn() ||
                    (resource != null && (!('locked' in resource.data) || resource.data.locked == false));

      allow list: if isSignedIn() || resource.data.locked == false;

      allow create: if isSignedIn() &&
                       isValidId(postId) &&
                       incoming().authorId == request.auth.uid &&
                       incoming().likedByUserIds.size() == 0 &&
                       (!('unlockedByUserIds' in incoming()) || incoming().unlockedByUserIds.size() == 0) &&
                       (!('commentCount' in incoming()) || incoming().commentCount == 0) &&
                       (!('shareCount' in incoming()) || incoming().shareCount == 0) &&
                       (
                         !('sharedFromPostId' in incoming()) ||
                         incoming().sharedFromPostId == '' ||
                         ((!('locked' in incoming()) || incoming().locked == false) &&
                          isOriginalPostShareable(incoming().sharedFromPostId))
                       ) &&
                       (
                         ((!('boostedAtMillis' in incoming()) || incoming().boostedAtMillis == 0) &&
                          (!('boostedUntilMillis' in incoming()) || incoming().boostedUntilMillis == 0)) ||
                         (isValidBoostWindow(incoming()) && callerPaidFivePointsInBatch())
                       ) &&
                       (!('locked' in incoming()) || incoming().locked == false || isAdultVerifiedCaller()) &&
                       (incoming().imageBase64.size() == 0 || callerCanUploadPostImage()) &&
                       isAllowedStaffTierClaim(incoming().authorTier) &&
                       callerPassesProfileChecks(false, false, false, false) &&
                       isValidProfilePost(incoming());

      allow update: if isSignedIn() &&
                       isValidId(postId) &&
                       incoming().authorId == existing().authorId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       canUpdateProfilePost(incoming(), existing());

      allow delete: if isSignedIn() &&
                       isValidId(postId) &&
                       (existing().authorId == request.auth.uid || isAdminOrSupport());

      // --- 7a. POST COMMENTS SUBCOLLECTION ---
      match /comments/{commentId} {
        allow get, list: if isSignedIn();

        allow create: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         incoming().postId == postId &&
                         incoming().authorId == request.auth.uid &&
                         isAllowedStaffTierClaim(incoming().authorTier) &&
                         callerPassesProfileChecks(false, false, false, false) &&
                         isValidPostComment(incoming()) &&
                         exists(/databases/$(database)/documents/profilePosts/$(postId));

        allow update: if false;

        allow delete: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         (existing().authorId == request.auth.uid ||
                          (exists(/databases/$(database)/documents/profilePosts/$(postId)) &&
                           get(/databases/$(database)/documents/profilePosts/$(postId)).data.authorId == request.auth.uid) ||
                          isAdminOrSupport());
      }
    }

    // --- 8. CREATOR SUBSCRIPTIONS ($15/month unlocks all locked photos by creator) ---
    match /creatorSubscriptions/{subId} {
      allow get: if isSignedIn() &&
                    (resource == null ||
                     existing().subscriberId == request.auth.uid ||
                     existing().creatorId == request.auth.uid ||
                     isAdminOrSupport());

      allow list: if isSignedIn() &&
                     (resource.data.subscriberId == request.auth.uid ||
                      resource.data.creatorId == request.auth.uid ||
                      isAdminOrSupport());

      allow create: if isSignedIn() &&
                       incoming().subscriberId == request.auth.uid &&
                       incoming().subscriberId != incoming().creatorId &&
                       subId == incoming().subscriberId + '_' + incoming().creatorId &&
                       incoming().active == true &&
                       isAdultVerifiedCaller() &&
                       isValidCreatorSubscription(incoming());

      allow update: if isSignedIn() &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time && (
                         (existing().subscriberId == request.auth.uid &&
                          incoming().active is bool &&
                          incoming().creatorName is string && incoming().creatorName.size() >= 1 && incoming().creatorName.size() <= 40 &&
                          incoming().expiresAtMillis is int && incoming().expiresAtMillis > request.time.toMillis() &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'creatorName', 'active', 'expiresAtMillis', 'updatedAt'
                          ])) ||
                         (isAdminOrSupport() &&
                          incoming().active == false &&
                          incoming().expiresAtMillis == 0 &&
                          incoming().refunded == true &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'active', 'expiresAtMillis', 'refunded', 'updatedAt'
                          ]))
                       );

      allow delete: if isSignedIn() &&
                       (existing().subscriberId == request.auth.uid || isAdmin());
    }

    // --- 9. POINT TRANSACTIONS & REVENUE SPLIT LEDGER (Append-Only; Staff Refund Marking Only) ---
    match /pointTransactions/{txId} {
      allow get: if isSignedIn() &&
                    isValidId(txId) &&
                    (resource == null ||
                     existing().buyerId == request.auth.uid ||
                     existing().creatorId == request.auth.uid ||
                     isAdminOrSupport());

      allow list: if isSignedIn() &&
                     (resource.data.buyerId == request.auth.uid ||
                      resource.data.creatorId == request.auth.uid ||
                      isAdminOrSupport());

      allow create: if isSignedIn() &&
                       isValidId(txId) &&
                       incoming().buyerId == request.auth.uid &&
                       isValidPointTransaction(incoming()) &&
                       (!(incoming().type in ['BUY_POINTS', 'PRO_MEMBERSHIP']) ||
                        !callerProfileExists() ||
                        isAge13VerifiedProfile(callerProfile()) ||
                        isAdmin());

      allow update: if isSignedIn() &&
                       isValidId(txId) &&
                       isAdminOrSupport() &&
                       (!('refunded' in existing()) || existing().refunded == false) &&
                       incoming().refunded == true &&
                       incoming().refundedById == request.auth.uid &&
                       incoming().refundedAtMillis is int && incoming().refundedAtMillis > 0 &&
                       incoming().refundedByName is string && incoming().refundedByName.size() >= 1 && incoming().refundedByName.size() <= 40 &&
                       incoming().refundReason is string && incoming().refundReason.size() >= 1 && incoming().refundReason.size() <= 300 &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'refunded', 'refundedAtMillis', 'refundedById', 'refundedByName', 'refundReason'
                       ]);

      allow delete: if false;
    }

    // --- 10. GLOBAL APP CONFIG (Login Screen News Banner & Trial Login Toggle) ---
    match /appConfig/{configId} {
      allow get: if configId == 'global';
      allow list: if false;

      allow create, update: if isSignedIn() &&
                               isAdmin() &&
                               configId == 'global' &&
                               isValidAppConfig(incoming());

      allow delete: if false;
    }

    // --- 11. ADMIN ROOM TRANSFERS (Send User to a Different Room) ---
    match /roomTransfers/{userId} {
      allow get: if isSignedIn() &&
                    isValidId(userId) &&
                    (request.auth.uid == userId || isAdmin());

      allow list: if isSignedIn() && isAdmin();

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isAdmin() &&
                       incoming().movedByAdminId == request.auth.uid &&
                       incoming().consumed == false &&
                       isValidRoomTransfer(incoming(), userId);

      allow update: if isSignedIn() &&
                       isValidId(userId) && (
                         (isAdmin() &&
                          incoming().movedByAdminId == request.auth.uid &&
                          isValidRoomTransfer(incoming(), userId)) ||
                         (request.auth.uid == userId &&
                          existing().consumed == false &&
                          incoming().consumed == true &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['consumed']))
                       );

      allow delete: if isSignedIn() &&
                       isValidId(userId) &&
                       (request.auth.uid == userId || isAdmin());
    }

    // --- 12. SUPPORT TICKETS (Created from Discovery Support Tab, managed by Admin/Support) ---
    match /supportTickets/{ticketId} {
      allow get: if isSignedIn() &&
                    isValidId(ticketId) &&
                    (resource == null ||
                     existing().requesterId == request.auth.uid ||
                     isAdminOrSupport());

      allow list: if isSignedIn() &&
                     (resource.data.requesterId == request.auth.uid ||
                      isAdminOrSupport());

      allow create: if isSignedIn() &&
                       isValidId(ticketId) &&
                       incoming().requesterId == request.auth.uid &&
                       isAllowedStaffTierClaim(incoming().requesterTier) &&
                       incoming().status == 'OPEN' &&
                       incoming().staffResponse == '' &&
                       isValidSupportTicket(incoming());

      allow update: if isSignedIn() &&
                       isValidId(ticketId) &&
                       incoming().status in ['OPEN', 'IN_PROGRESS', 'RESOLVED'] &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time && (
                         (isAdminOrSupport() &&
                          isStr(incoming().staffResponse, 0, 500) &&
                          (!('assignedStaffId' in incoming()) || isStr(incoming().assignedStaffId, 0, 128)) &&
                          (!('assignedStaffName' in incoming()) || isStr(incoming().assignedStaffName, 0, 40)) &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'staffResponse', 'assignedStaffId', 'assignedStaffName', 'updatedAt'
                          ])) ||
                         (existing().requesterId == request.auth.uid &&
                          incoming().status == 'RESOLVED' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(ticketId) && isAdmin();
    }

    // --- 13. USER FOLLOWS (Followers & Following Relationships) ---
    match /userFollows/{followId} {
      allow get, list: if true;

      allow create: if isSignedIn() &&
                       followId.size() >= 4 && followId.size() <= 260 &&
                       followId == request.auth.uid + '__' + incoming().followingId &&
                       incoming().followerId == request.auth.uid &&
                       isValidUserFollow(incoming());

      allow update: if false;

      allow delete: if isSignedIn() &&
                       (existing().followerId == request.auth.uid || isAdmin());
    }

    // --- 14. APP-WIDE ADMIN BROADCASTS (Admin Messages to All Users) ---
    match /appBroadcasts/{broadcastId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(broadcastId) &&
                       isAdmin() &&
                       incoming().senderId == request.auth.uid &&
                       isValidAppBroadcast(incoming());

      allow update: if false;

      allow delete: if isSignedIn() &&
                       isValidId(broadcastId) &&
                       isAdmin();
    }

    // --- 15. REELS (Pro-Only Vertical Short Videos up to 30s + $5 Boost + Likes/Comments/Shares) ---
    match /reels/{reelId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(reelId) &&
                       isProCaller() &&
                       incoming().authorId == request.auth.uid &&
                       isAllowedStaffTierClaim(incoming().authorTier) &&
                       incoming().likedByUserIds.size() == 0 &&
                       (!('commentCount' in incoming()) || incoming().commentCount == 0) &&
                       (!('shareCount' in incoming()) || incoming().shareCount == 0) &&
                       (!('boostedAtMillis' in incoming()) ||
                        incoming().boostedAtMillis == 0 ||
                        (isValidBoostWindow(incoming()) && callerPaidFivePointsInBatch())) &&
                       isValidReel(incoming());

      allow update: if isSignedIn() &&
                       isValidId(reelId) &&
                       incoming().authorId == existing().authorId &&
                       incoming().durationSec == existing().durationSec &&
                       incoming().chunkCount == existing().chunkCount &&
                       incoming().mimeType == existing().mimeType &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       canUpdateReel(incoming(), existing());

      allow delete: if isSignedIn() &&
                       isValidId(reelId) &&
                       (existing().authorId == request.auth.uid || isAdminOrSupport());

      match /chunks/{chunkId} {
        allow get, list: if isSignedIn();

        allow create: if isSignedIn() &&
                         isValidId(chunkId) &&
                         isProCaller() &&
                         incoming().authorId == request.auth.uid &&
                         exists(/databases/$(database)/documents/reels/$(reelId)) &&
                         get(/databases/$(database)/documents/reels/$(reelId)).data.authorId == request.auth.uid &&
                         isValidReelChunk(incoming(), reelId);

        allow update: if false;

        allow delete: if isSignedIn() &&
                         isValidId(chunkId) &&
                         (existing().authorId == request.auth.uid || isAdminOrSupport());
      }

      match /comments/{commentId} {
        allow get, list: if isSignedIn();

        allow create: if isSignedIn() &&
                         isValidId(commentId) &&
                         incoming().authorId == request.auth.uid &&
                         isAllowedStaffTierClaim(incoming().authorTier) &&
                         exists(/databases/$(database)/documents/reels/$(reelId)) &&
                         isValidReelComment(incoming(), reelId);

        allow update: if isSignedIn() &&
                         isValidId(commentId) &&
                         existing().authorId == request.auth.uid &&
                         isStr(incoming().text, 1, 300) &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['text', 'updatedAt']);

        allow delete: if isSignedIn() &&
                         isValidId(commentId) &&
                         (existing().authorId == request.auth.uid ||
                          (exists(/databases/$(database)/documents/reels/$(reelId)) &&
                           get(/databases/$(database)/documents/reels/$(reelId)).data.authorId == request.auth.uid) ||
                          isAdminOrSupport());
      }
    }

    // --- 16. INVITE-A-FRIEND REFERRALS (+2 Points Each Upon Verified Account + First PTT Clip) ---
    match /referrals/{inviteeId} {
      allow get: if isSignedIn() &&
                    isValidId(inviteeId) &&
                    (resource == null ||
                     existing().inviteeId == request.auth.uid ||
                     existing().inviterId == request.auth.uid ||
                     isAdmin());

      allow list: if isSignedIn() &&
                     (resource.data.inviteeId == request.auth.uid ||
                      resource.data.inviterId == request.auth.uid ||
                      isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(inviteeId) &&
                       inviteeId == request.auth.uid &&
                       incoming().inviteeId == request.auth.uid &&
                       incoming().inviterId != request.auth.uid &&
                       incoming().bonusClaimed == false &&
                       exists(/databases/$(database)/documents/userDirectory/$(incoming().inviterId)) &&
                       isValidReferralRecord(incoming(), inviteeId);

      allow update: if isSignedIn() &&
                       isValidId(inviteeId) &&
                       inviteeId == request.auth.uid &&
                       existing().bonusClaimed == false &&
                       incoming().accountVerified is bool &&
                       incoming().firstPttSent is bool &&
                       incoming().bonusClaimed is bool &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'accountVerified', 'firstPttSent', 'bonusClaimed', 'updatedAt'
                       ]) &&
                       (!incoming().bonusClaimed ||
                        (hasVerifiedEmail() &&
                         incoming().accountVerified == true &&
                         incoming().firstPttSent == true));

      allow delete: if isSignedIn() && isValidId(inviteeId) && isAdmin();
    }

    // --- 17. WHO VIEWED MY PROFILE (/profileViews/{targetUserId}_{viewerId}) ---
    match /profileViews/{viewId} {
      allow get: if isSignedIn() &&
                    (resource == null ||
                     existing().targetUserId == request.auth.uid ||
                     existing().viewerId == request.auth.uid ||
                     isAdmin());

      allow list: if isSignedIn() &&
                     (resource.data.targetUserId == request.auth.uid ||
                      resource.data.viewerId == request.auth.uid ||
                      isAdmin());

      allow create, update: if isSignedIn() &&
                               incoming().viewerId == request.auth.uid &&
                               incoming().targetUserId != request.auth.uid &&
                               isAllowedStaffTierClaim(incoming().viewerTier) &&
                               isValidProfileView(incoming(), viewId);

      allow delete: if isSignedIn() &&
                       (existing().targetUserId == request.auth.uid ||
                        existing().viewerId == request.auth.uid ||
                        isAdmin());
    }

    // --- 18. AUTOMATED 5-STRIKE USER MODERATION FILES & PRIVATE FILE NOTES ---
    function isValidUserModerationFile(data, userId) {
      return data.keys().hasAll([
               'userId', 'targetName', 'reportCount', 'warningCount',
               'investigationActive', 'investigationStatus',
               'suspendedUntilMillis', 'suspendedUntilInvestigationResolved',
               'suspensionReason', 'lastWarningMessage',
               'lastWarningAtMillis', 'lastWarningAcknowledgedAtMillis',
               'lastReportId', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'targetName', 'reportCount', 'warningCount',
               'investigationActive', 'investigationStatus',
               'suspendedUntilMillis', 'suspendedUntilInvestigationResolved',
               'pendingAdminReview', 'pendingSuspensionRequestId',
               'suspensionReason', 'lastWarningMessage',
               'lastWarningAtMillis', 'lastWarningAcknowledgedAtMillis',
               'lastReportId', 'lastResolvedById', 'lastResolvedByName',
               'lastResolutionNote', 'updatedAt'
             ]) &&
             data.userId == userId && isStr(data.targetName, 1, 40) &&
             isNonNeg(data.reportCount) && data.reportCount <= 10000 &&
             isNonNeg(data.warningCount) && data.warningCount <= 10000 &&
             data.investigationActive is bool &&
             data.investigationStatus in ['NONE', 'INVESTIGATING', 'WARNING_ISSUED', 'SUSPENDED_1H', 'SUSPENDED_2H', 'SUSPENDED_PENDING_REVIEW', 'SUSPENDED_PENDING_ADMIN_REVIEW', 'RESOLVED'] &&
             isNonNeg(data.suspendedUntilMillis) && data.suspendedUntilInvestigationResolved is bool &&
             (!('pendingAdminReview' in data) || data.pendingAdminReview is bool) &&
             (!('pendingSuspensionRequestId' in data) || isStr(data.pendingSuspensionRequestId, 0, 128)) &&
             isStr(data.suspensionReason, 0, 240) && isStr(data.lastWarningMessage, 0, 300) &&
             isNonNeg(data.lastWarningAtMillis) && isNonNeg(data.lastWarningAcknowledgedAtMillis) &&
             isStr(data.lastReportId, 0, 128) &&
             (!('lastResolvedById' in data) || isStr(data.lastResolvedById, 0, 128)) &&
             (!('lastResolvedByName' in data) || isStr(data.lastResolvedByName, 0, 40)) &&
             (!('lastResolutionNote' in data) || isStr(data.lastResolutionNote, 0, 300)) &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidUserFileNote(data, userId) {
      let k = ['targetUserId', 'reportId', 'strikeNumber', 'actionTaken', 'category', 'reason', 'reporterId', 'reporterName', 'actorRole', 'createdAt'];
      return data.keys().hasAll(k) && data.keys().hasOnly(k) &&
             data.targetUserId == userId && isStr(data.reportId, 0, 128) &&
             isNonNeg(data.strikeNumber) && data.strikeNumber <= 10000 &&
             data.actionTaken in ['INVESTIGATION_STARTED', 'WARNING_ISSUED', 'SUSPENDED_1H', 'SUSPENDED_2H', 'SUSPENDED_PENDING_REVIEW', 'INVESTIGATION_RESOLVED', 'SUPPORT_SUSPENSION_REQUESTED', 'ADMIN_REVIEW_COMPLETED'] &&
             isStr(data.category, 1, 40) && isStr(data.reason, 1, 450) &&
             isStr(data.reporterId, 1, 128) && isStr(data.reporterName, 1, 40) &&
             data.actorRole in ['REPORTER', 'SUPPORT', 'ADMIN'] &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidReporterStrikeEscalation(newData, oldData, userId) {
      let newCount = newData.reportCount;
      let oldCount = oldData.reportCount;
      let reportPath = /databases/$(database)/documents/safetyReports/$(newData.lastReportId);
      let oldPendingAdmin = ('pendingAdminReview' in oldData) && oldData.pendingAdminReview == true;
      let newPendingAdmin = ('pendingAdminReview' in newData) && newData.pendingAdminReview == true;
      return request.auth.uid != userId &&
             !isTargetAdmin(userId) &&
             newCount == oldCount + 1 &&
             newPendingAdmin == oldPendingAdmin &&
             newData.lastReportId.size() >= 1 &&
             newData.lastReportId != oldData.lastReportId &&
             !exists(reportPath) &&
             existsAfter(reportPath) &&
             getAfter(reportPath).data.reporterId == request.auth.uid &&
             getAfter(reportPath).data.targetUserId == userId &&
             newData.lastWarningAcknowledgedAtMillis == oldData.lastWarningAcknowledgedAtMillis && (
               (newCount == 1 &&
                newData.investigationActive == true &&
                newData.investigationStatus == 'INVESTIGATING' &&
                newData.suspendedUntilMillis == oldData.suspendedUntilMillis &&
                newData.suspendedUntilInvestigationResolved == oldData.suspendedUntilInvestigationResolved) ||
               (newCount == 2 &&
                newData.warningCount == oldData.warningCount + 1 &&
                newData.investigationActive == true &&
                newData.investigationStatus == 'WARNING_ISSUED' &&
                newData.lastWarningAtMillis > 0 &&
                newData.lastWarningMessage.size() >= 1 &&
                newData.suspendedUntilMillis == oldData.suspendedUntilMillis &&
                newData.suspendedUntilInvestigationResolved == oldData.suspendedUntilInvestigationResolved) ||
               (newCount == 3 &&
                newData.investigationActive == true &&
                newData.investigationStatus == 'SUSPENDED_1H' &&
                newData.suspendedUntilMillis >= request.time.toMillis() + 3480000 &&
                newData.suspendedUntilMillis <= request.time.toMillis() + 3720000 &&
                newData.suspendedUntilInvestigationResolved == oldData.suspendedUntilInvestigationResolved) ||
               (newCount == 4 &&
                newData.investigationActive == true &&
                newData.investigationStatus == 'SUSPENDED_2H' &&
                newData.suspendedUntilMillis >= request.time.toMillis() + 7080000 &&
                newData.suspendedUntilMillis <= request.time.toMillis() + 7320000 &&
                newData.suspendedUntilInvestigationResolved == oldData.suspendedUntilInvestigationResolved) ||
               (newCount >= 5 &&
                newData.investigationActive == true &&
                newData.investigationStatus == 'SUSPENDED_PENDING_REVIEW' &&
                newData.suspendedUntilInvestigationResolved == true)
             );
    }

    match /userModerationFiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId);

      allow list: if isSignedIn() && isAdminOrSupport();

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserModerationFile(incoming(), userId) && (
                         (isAdminOrSupport() && (!isTargetAdmin(userId) || isAdmin())) ||
                         (request.auth.uid != userId &&
                          !isTargetAdmin(userId) &&
                          incoming().reportCount == 1 &&
                          incoming().warningCount == 0 &&
                          incoming().investigationActive == true &&
                          incoming().investigationStatus == 'INVESTIGATING' &&
                          incoming().suspendedUntilMillis == 0 &&
                          incoming().suspendedUntilInvestigationResolved == false &&
                          (!('pendingAdminReview' in incoming()) || incoming().pendingAdminReview == false) &&
                          incoming().lastReportId.size() >= 1 &&
                          existsAfter(/databases/$(database)/documents/safetyReports/$(incoming().lastReportId)) &&
                          getAfter(/databases/$(database)/documents/safetyReports/$(incoming().lastReportId)).data.reporterId == request.auth.uid &&
                          getAfter(/databases/$(database)/documents/safetyReports/$(incoming().lastReportId)).data.targetUserId == userId)
                       );

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time && (
                         ((isAdmin() ||
                           (isSupport() && !isTargetAdmin(userId) &&
                            (!('pendingAdminReview' in existing()) || existing().pendingAdminReview == false))) &&
                          isStr(incoming().targetName, 1, 40) &&
                          isNonNeg(incoming().reportCount) && isNonNeg(incoming().warningCount) &&
                          incoming().investigationActive is bool &&
                          incoming().investigationStatus in ['NONE', 'INVESTIGATING', 'WARNING_ISSUED', 'SUSPENDED_1H', 'SUSPENDED_2H', 'SUSPENDED_PENDING_REVIEW', 'SUSPENDED_PENDING_ADMIN_REVIEW', 'RESOLVED'] &&
                          isNonNeg(incoming().suspendedUntilMillis) &&
                          incoming().suspendedUntilInvestigationResolved is bool) ||
                         (request.auth.uid == userId &&
                          isNonNeg(incoming().lastWarningAcknowledgedAtMillis) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['lastWarningAcknowledgedAtMillis', 'updatedAt'])) ||
                         (isValidReporterStrikeEscalation(incoming(), existing(), userId) &&
                          isStr(incoming().targetName, 1, 40) &&
                          isNonNeg(incoming().suspendedUntilMillis) &&
                          isStr(incoming().suspensionReason, 0, 240) &&
                          isStr(incoming().lastWarningMessage, 0, 300) &&
                          isNonNeg(incoming().lastWarningAtMillis) &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'targetName', 'reportCount', 'warningCount', 'investigationActive',
                            'investigationStatus', 'suspendedUntilMillis', 'suspendedUntilInvestigationResolved',
                            'suspensionReason', 'lastWarningMessage', 'lastWarningAtMillis',
                            'lastReportId', 'updatedAt'
                          ]))
                       );

      allow delete: if false;

      match /notes/{noteId} {
        allow get, list: if isSignedIn() && isValidId(userId) && isAdminOrSupport();

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(noteId) &&
                         isValidUserFileNote(incoming(), userId) && (
                           (isAdminOrSupport() &&
                            incoming().actorRole in ['ADMIN', 'SUPPORT'] &&
                            incoming().reporterId == request.auth.uid) ||
                           (request.auth.uid != userId &&
                            !isTargetAdmin(userId) &&
                            incoming().actorRole == 'REPORTER' &&
                            incoming().reporterId == request.auth.uid &&
                            incoming().reportId == noteId &&
                            existsAfter(/databases/$(database)/documents/safetyReports/$(noteId)) &&
                            getAfter(/databases/$(database)/documents/safetyReports/$(noteId)).data.reporterId == request.auth.uid &&
                            getAfter(/databases/$(database)/documents/safetyReports/$(noteId)).data.targetUserId == userId)
                         );

        allow update, delete: if false;
      }
    }

    // --- 19. ROLLING 1-HOUR REPORT RATE LIMITER (MAX 3 DIFFERENT TARGETS, 1 REPORT EACH PER HOUR) ---
    function isValidReportRateLimit(data, userId) {
      let k = ['userId', 'recentTargetTimestamps', 'lastTargetUserId', 'lastReportId', 'updatedAt'];
      return data.keys().hasAll(k) && data.keys().hasOnly(k) &&
             data.userId == userId &&
             data.recentTargetTimestamps is map &&
             data.recentTargetTimestamps.size() >= 1 && data.recentTargetTimestamps.size() <= 3 &&
             isStr(data.lastTargetUserId, 1, 128) && isStr(data.lastReportId, 1, 128) &&
             (data.lastTargetUserId in data.recentTargetTimestamps) &&
             data.recentTargetTimestamps[data.lastTargetUserId] is int &&
             data.recentTargetTimestamps[data.lastTargetUserId] >= request.time.toMillis() - 120000 &&
             data.recentTargetTimestamps[data.lastTargetUserId] <= request.time.toMillis() + 120000 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isActiveOldReportEntryPreserved(oldMap, newMap, keys, idx, cutoff) {
      return keys.size() <= idx ||
             !(oldMap[keys[idx]] is int) ||
             oldMap[keys[idx]] <= cutoff ||
             ((keys[idx] in newMap) && newMap[keys[idx]] == oldMap[keys[idx]]);
    }

    match /reportRateLimits/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdminOrSupport());
      allow list: if isSignedIn() && isAdminOrSupport();

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidReportRateLimit(incoming(), userId) &&
                       incoming().recentTargetTimestamps.size() == 1 &&
                       existsAfter(/databases/$(database)/documents/safetyReports/$(incoming().lastReportId)) &&
                       getAfter(/databases/$(database)/documents/safetyReports/$(incoming().lastReportId)).data.reporterId == userId &&
                       getAfter(/databases/$(database)/documents/safetyReports/$(incoming().lastReportId)).data.targetUserId == incoming().lastTargetUserId;

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidReportRateLimit(incoming(), userId) &&
                       incoming().lastReportId != existing().lastReportId &&
                       existsAfter(/databases/$(database)/documents/safetyReports/$(incoming().lastReportId)) &&
                       getAfter(/databases/$(database)/documents/safetyReports/$(incoming().lastReportId)).data.reporterId == userId &&
                       getAfter(/databases/$(database)/documents/safetyReports/$(incoming().lastReportId)).data.targetUserId == incoming().lastTargetUserId &&
                       (!(incoming().lastTargetUserId in existing().recentTargetTimestamps) ||
                        existing().recentTargetTimestamps[incoming().lastTargetUserId] <= request.time.toMillis() - 3600000) &&
                       isActiveOldReportEntryPreserved(existing().recentTargetTimestamps, incoming().recentTargetTimestamps, existing().recentTargetTimestamps.keys(), 0, request.time.toMillis() - 3600000) &&
                       isActiveOldReportEntryPreserved(existing().recentTargetTimestamps, incoming().recentTargetTimestamps, existing().recentTargetTimestamps.keys(), 1, request.time.toMillis() - 3600000) &&
                       isActiveOldReportEntryPreserved(existing().recentTargetTimestamps, incoming().recentTargetTimestamps, existing().recentTargetTimestamps.keys(), 2, request.time.toMillis() - 3600000);

      allow delete: if false;
    }

    // --- 20. SUPPORT SUSPENSION REQUESTS PENDING ADMIN REVIEW ---
    function isValidSuspensionRequest(data) {
      let k = ['targetUserId', 'targetName', 'requestedById', 'requestedByName', 'reason', 'roomId', 'status', 'reviewedByAdminId', 'reviewedByAdminName', 'adminDecisionNote', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(k) && data.keys().hasOnly(k) &&
             isStr(data.targetUserId, 1, 128) && isStr(data.targetName, 1, 40) &&
             isStr(data.requestedById, 1, 128) && isStr(data.requestedByName, 1, 40) &&
             isStr(data.reason, 1, 400) && isStr(data.roomId, 0, 260) &&
             data.status in ['PENDING', 'APPROVED_BAN', 'APPROVED_TIMED', 'DISMISSED_LIFTED'] &&
             isStr(data.reviewedByAdminId, 0, 128) && isStr(data.reviewedByAdminName, 0, 40) &&
             isStr(data.adminDecisionNote, 0, 300) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /suspensionRequests/{requestId} {
      allow get, list: if isSignedIn() && isAdminOrSupport();

      allow create: if isSignedIn() &&
                       isValidId(requestId) &&
                       isAdminOrSupport() &&
                       incoming().requestedById == request.auth.uid &&
                       !isTargetAdmin(incoming().targetUserId) &&
                       incoming().status == 'PENDING' &&
                       incoming().reviewedByAdminId == '' &&
                       incoming().reviewedByAdminName == '' &&
                       incoming().adminDecisionNote == '' &&
                       isValidSuspensionRequest(incoming());

      allow update: if isSignedIn() &&
                       isValidId(requestId) &&
                       isAdmin() &&
                       existing().status == 'PENDING' &&
                       incoming().status in ['APPROVED_BAN', 'APPROVED_TIMED', 'DISMISSED_LIFTED'] &&
                       incoming().reviewedByAdminId == request.auth.uid &&
                       incoming().reviewedByAdminName is string && incoming().reviewedByAdminName.size() <= 40 &&
                       incoming().adminDecisionNote is string && incoming().adminDecisionNote.size() <= 300 &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'status', 'reviewedByAdminId', 'reviewedByAdminName', 'adminDecisionNote', 'updatedAt'
                       ]);

      allow delete: if false;
    }

    // --- 22. REFUND REPORTS (Admins & Support Refunds; Support Refunds Reported to App Admins) ---
    function isValidRefundReport(data) {
      let keys = [
        'targetUserId', 'targetName', 'refundType', 'itemLabel', 'amountCents',
        'transactionId', 'subscriptionId', 'membershipRevoked', 'reason',
        'issuedById', 'issuedByName', 'issuedByTier', 'reportedToAdmins',
        'acknowledgedByAdmin', 'acknowledgedByAdminName', 'createdAt', 'updatedAt'
      ];
      return data.keys().hasAll(keys) && data.keys().hasOnly(keys) &&
             isStr(data.targetUserId, 1, 128) && isStr(data.targetName, 1, 40) &&
             data.refundType in ['VOX_PRO', 'CREATOR_SUBSCRIPTION', 'PAID_DM', 'POINTS_TRANSACTION'] &&
             isStr(data.itemLabel, 1, 100) &&
             data.amountCents is int && data.amountCents >= 0 && data.amountCents <= 100000000 &&
             isStr(data.transactionId, 0, 128) && isStr(data.subscriptionId, 0, 260) &&
             data.membershipRevoked is bool && isStr(data.reason, 1, 300) &&
             isStr(data.issuedById, 1, 128) && isStr(data.issuedByName, 1, 40) &&
             data.issuedByTier in ['ADMIN', 'SUPPORT'] &&
             data.reportedToAdmins is bool && data.acknowledgedByAdmin is bool &&
             isStr(data.acknowledgedByAdminName, 0, 40) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /refundReports/{reportId} {
      allow get, list: if isSignedIn() && isAdminOrSupport();

      allow create: if isSignedIn() && isValidId(reportId) && isAdminOrSupport() &&
                       incoming().issuedById == request.auth.uid &&
                       ((incoming().issuedByTier == 'ADMIN' && isAdmin()) ||
                        (incoming().issuedByTier == 'SUPPORT' && isSupport())) &&
                       isValidRefundReport(incoming());

      allow update: if isSignedIn() && isValidId(reportId) && isAdmin() &&
                       incoming().acknowledgedByAdmin == true &&
                       isStr(incoming().acknowledgedByAdminName, 1, 40) &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'acknowledgedByAdmin', 'acknowledgedByAdminName', 'updatedAt'
                       ]);

      allow delete: if false;
    }

    // --- 23. APP PERK GRANTS (Admin & Support Perk Grants + 30-in-5-Days Tracking) ---
    function isValidPerkGrant(data) {
      let keys = [
        'targetUserId', 'targetName', 'perkType', 'perkLabel', 'perkDetail',
        'reason', 'grantedById', 'grantedByName', 'grantedByTier', 'createdAtMillis', 'createdAt'
      ];
      return data.keys().hasAll(keys) && data.keys().hasOnly(keys) &&
             isStr(data.targetUserId, 1, 128) && isStr(data.targetName, 1, 40) &&
             data.perkType in ['VOX_PRO_30D', 'VOX_PRO_LIFETIME', 'VIP_PRO_30D', 'ELITE_PRO_30D', 'SPOTLIGHT_FRAME_24H', 'PTT_THEME', 'PTT_CHIRP', 'BONUS_POINTS', 'PROFILE_VIEWERS_24H', 'PROFILE_BOOST_24H'] &&
             isStr(data.perkLabel, 1, 80) && isStr(data.perkDetail, 0, 120) && isStr(data.reason, 0, 300) &&
             isStr(data.grantedById, 1, 128) && isStr(data.grantedByName, 1, 40) &&
             data.grantedByTier in ['ADMIN', 'SUPPORT'] &&
             data.createdAtMillis is int && data.createdAtMillis > 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    match /perkGrants/{grantId} {
      allow get: if isSignedIn() && isValidId(grantId) &&
                    (resource == null || isAdminOrSupport() || existing().targetUserId == request.auth.uid);

      allow list: if isSignedIn() && (isAdminOrSupport() || resource.data.targetUserId == request.auth.uid);

      allow create: if isSignedIn() && isValidId(grantId) && isAdminOrSupport() &&
                       incoming().grantedById == request.auth.uid &&
                       ((incoming().grantedByTier == 'ADMIN' && isAdmin()) ||
                        (incoming().grantedByTier == 'SUPPORT' && isSupport())) &&
                       isValidPerkGrant(incoming());

      allow update, delete: if false;
    }

    // --- 24. ADMIN NOTIFICATIONS (Support Refund Record-Keeping & 30-Perks-in-5-Days Alerts) ---
    function isValidAdminNotification(data) {
      let keys = [
        'type', 'title', 'message', 'createdById', 'createdByName',
        'targetUserId', 'targetName', 'referenceId', 'countValue',
        'read', 'createdAt', 'updatedAt'
      ];
      return data.keys().hasAll(keys) && data.keys().hasOnly(keys) &&
             data.type in ['SUPPORT_REFUND_REPORT', 'SUPPORT_PERK_THRESHOLD_30_IN_5D'] &&
             isStr(data.title, 1, 120) && isStr(data.message, 1, 500) &&
             isStr(data.createdById, 1, 128) && isStr(data.createdByName, 1, 40) &&
             isStr(data.targetUserId, 0, 128) && isStr(data.targetName, 0, 40) &&
             isStr(data.referenceId, 0, 260) &&
             data.countValue is int && data.countValue >= 0 && data.countValue <= 100000 &&
             data.read is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /adminNotifications/{notifId} {
      allow get, list: if isSignedIn() && isAdmin();

      allow create: if isSignedIn() && isValidId(notifId) && isAdminOrSupport() &&
                       incoming().createdById == request.auth.uid &&
                       incoming().read == false &&
                       isValidAdminNotification(incoming());

      allow update: if isSignedIn() && isValidId(notifId) && isAdmin() &&
                       incoming().read is bool &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(notifId) && isAdmin();
    }

    // --- 25. BANNED DEVICES REGISTRY (Device-Level Ban Blocking Alternate Emails) ---
    function isValidBannedDevice(data, deviceHash) {
      let keys = [
        'deviceHash', 'bannedUserId', 'bannedUserName', 'reason',
        'bannedByUid', 'bannedByName', 'active', 'createdAt', 'updatedAt'
      ];
      return data.keys().hasAll(keys) && data.keys().hasOnly(keys) &&
             data.deviceHash == deviceHash &&
             isStr(data.deviceHash, 16, 128) &&
             isStr(data.bannedUserId, 1, 128) &&
             isStr(data.bannedUserName, 1, 40) &&
             isStr(data.reason, 0, 240) &&
             isStr(data.bannedByUid, 1, 128) &&
             isStr(data.bannedByName, 1, 40) &&
             data.active is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /bannedDevices/{deviceHash} {
      allow get: if isSignedIn() && isValidId(deviceHash);

      allow list: if isSignedIn() && isAdminOrSupport();

      allow create, update: if isSignedIn() &&
                               isValidId(deviceHash) &&
                               isValidBannedDevice(incoming(), deviceHash) &&
                               (resource == null || incoming().createdAt == existing().createdAt) && (
                                 isAdminOrSupport() ||
                                 (incoming().bannedUserId == request.auth.uid &&
                                  (resource != null || incoming().bannedByUid == request.auth.uid) &&
                                  incoming().active == true &&
                                  isCallerGloballyBanned())
                               );

      allow delete: if isSignedIn() && isValidId(deviceHash) && isAdmin();
    }

    // --- 26. COMPANY SUB-ACCOUNTS (VIP Pro Employee Sub-Names) ---
    function isValidCompanySubAccount(data, subId) {
      let k = [
        'ownerId', 'ownerName', 'companyName', 'companyThreadId', 'subName', 'roleTitle',
        'accessCode', 'claimedUserId', 'claimedEmail', 'supervisor', 'supervisorUids',
        'doNotDisturb', 'active', 'claimedAtMillis', 'createdAt', 'updatedAt'
      ];
      return data.keys().hasAll(k) && data.keys().hasOnly(k) &&
             isStr(data.ownerId, 1, 128) && isStr(data.ownerName, 1, 40) &&
             isStr(data.companyName, 1, 60) && isStr(data.companyThreadId, 1, 260) &&
             isStr(data.subName, 1, 40) && isStr(data.roleTitle, 0, 60) &&
             data.accessCode == subId && isStr(data.accessCode, 4, 32) &&
             isStr(data.claimedUserId, 0, 128) && isStr(data.claimedEmail, 0, 120) &&
             data.supervisor is bool && isBoundedStringList(data.supervisorUids, 50) &&
             data.doNotDisturb is bool && data.active is bool &&
             isNonNeg(data.claimedAtMillis) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isAuthorizedCompanyManager(threadId, ownerId) {
      let tp = /databases/$(database)/documents/directThreads/$(threadId);
      return isAdmin() ||
             ownerId == request.auth.uid ||
             (exists(tp) &&
              ('groupSupervisorIds' in get(tp).data) &&
              request.auth.uid in get(tp).data.groupSupervisorIds);
    }

    match /companySubAccounts/{subId} {
      allow get: if isSignedIn() && isValidId(subId);

      allow list: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.claimedUserId == request.auth.uid ||
        request.auth.uid in resource.data.supervisorUids ||
        isAdmin()
      );

      allow create: if isSignedIn() && isValidId(subId) &&
                       incoming().ownerId == request.auth.uid &&
                       isVipProOrAdminCaller() &&
                       incoming().claimedUserId == '' &&
                       incoming().active == true &&
                       isValidCompanySubAccount(incoming(), subId);

      allow update: if isSignedIn() && isValidId(subId) &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time && (
                         ((existing().ownerId == request.auth.uid || isAdmin()) &&
                          isStr(incoming().subName, 1, 40) && isStr(incoming().roleTitle, 0, 60) &&
                          isStr(incoming().companyName, 1, 60) && incoming().supervisor is bool &&
                          isBoundedStringList(incoming().supervisorUids, 50) && incoming().active is bool &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['subName', 'roleTitle', 'companyName', 'supervisor', 'supervisorUids', 'active', 'updatedAt'])) ||
                         (existing().active == true && existing().claimedUserId == '' &&
                          incoming().claimedUserId == request.auth.uid &&
                          isStr(incoming().claimedEmail, 0, 120) && isNonNeg(incoming().claimedAtMillis) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['claimedUserId', 'claimedEmail', 'claimedAtMillis', 'updatedAt'])) ||
                         (existing().claimedUserId == request.auth.uid &&
                          isStr(incoming().subName, 1, 40) && incoming().doNotDisturb is bool &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['subName', 'doNotDisturb', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(subId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // --- 27. WORK ORDERS & NOTES (Owner/Supervisor -> Employee Sub-Account) ---
    function isValidWorkOrder(data) {
      let k = [
        'companyOwnerId', 'threadId', 'supervisorUids', 'senderId', 'senderName', 'senderRole',
        'targetUserId', 'targetName', 'orderType', 'priority', 'title', 'body', 'status',
        'acknowledged', 'acknowledgedAtMillis', 'completedAtMillis', 'createdAt', 'updatedAt'
      ];
      return data.keys().hasAll(k) && data.keys().hasOnly(k) &&
             isStr(data.companyOwnerId, 1, 128) && isStr(data.threadId, 1, 260) &&
             isBoundedStringList(data.supervisorUids, 50) &&
             isStr(data.senderId, 1, 128) && isStr(data.senderName, 1, 40) && isStr(data.senderRole, 1, 30) &&
             isStr(data.targetUserId, 1, 128) && isStr(data.targetName, 1, 40) &&
             data.orderType in ['WORK_ORDER', 'NOTE'] &&
             data.priority in ['NORMAL', 'URGENT'] &&
             isStr(data.title, 1, 80) && isStr(data.body, 1, 500) &&
             data.status in ['OPEN', 'ACKNOWLEDGED', 'COMPLETED'] &&
             data.acknowledged is bool && isNonNeg(data.acknowledgedAtMillis) && isNonNeg(data.completedAtMillis) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /workOrders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (
        resource == null ||
        existing().companyOwnerId == request.auth.uid ||
        existing().targetUserId == request.auth.uid ||
        existing().senderId == request.auth.uid ||
        request.auth.uid in existing().supervisorUids ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        resource.data.companyOwnerId == request.auth.uid ||
        resource.data.targetUserId == request.auth.uid ||
        resource.data.senderId == request.auth.uid ||
        request.auth.uid in resource.data.supervisorUids ||
        isAdmin()
      );

      allow create: if isSignedIn() && isValidId(orderId) &&
                       incoming().senderId == request.auth.uid &&
                       incoming().status == 'OPEN' &&
                       incoming().acknowledged == false &&
                       isValidWorkOrder(incoming()) &&
                       isAuthorizedCompanyManager(incoming().threadId, incoming().companyOwnerId);

      allow update: if isSignedIn() && isValidId(orderId) &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time && (
                         (existing().targetUserId == request.auth.uid &&
                          incoming().status in ['ACKNOWLEDGED', 'COMPLETED'] &&
                          incoming().acknowledged == true &&
                          isNonNeg(incoming().acknowledgedAtMillis) && isNonNeg(incoming().completedAtMillis) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acknowledged', 'acknowledgedAtMillis', 'completedAtMillis', 'updatedAt'])) ||
                         (isAuthorizedCompanyManager(existing().threadId, existing().companyOwnerId) &&
                          isStr(incoming().title, 1, 80) && isStr(incoming().body, 1, 500) &&
                          incoming().priority in ['NORMAL', 'URGENT'] &&
                          incoming().status in ['OPEN', 'ACKNOWLEDGED', 'COMPLETED'] &&
                          isBoundedStringList(incoming().supervisorUids, 50) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'body', 'priority', 'status', 'supervisorUids', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(orderId) &&
                       (existing().companyOwnerId == request.auth.uid || existing().senderId == request.auth.uid || isAdmin());
    }

    // --- 28. EMPLOYEE REQUESTS (Employee Sub-Account -> Owner/Supervisors) ---
    function isValidEmployeeRequest(data) {
      let k = [
        'companyOwnerId', 'threadId', 'supervisorUids', 'requesterId', 'requesterName',
        'category', 'subject', 'details', 'urgent', 'status',
        'reviewedById', 'reviewedByName', 'reviewerNote', 'createdAt', 'updatedAt'
      ];
      return data.keys().hasAll(k) && data.keys().hasOnly(k) &&
             isStr(data.companyOwnerId, 1, 128) && isStr(data.threadId, 1, 260) &&
             isBoundedStringList(data.supervisorUids, 50) &&
             isStr(data.requesterId, 1, 128) && isStr(data.requesterName, 1, 40) &&
             data.category in ['SCHEDULE', 'SUPPLIES', 'DISPATCH', 'OTHER'] &&
             isStr(data.subject, 1, 80) && isStr(data.details, 1, 500) &&
             data.urgent is bool &&
             data.status in ['PENDING', 'APPROVED', 'DENIED', 'COMPLETED', 'CANCELLED'] &&
             isStr(data.reviewedById, 0, 128) && isStr(data.reviewedByName, 0, 40) && isStr(data.reviewerNote, 0, 300) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /employeeRequests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) && (
        resource == null ||
        existing().requesterId == request.auth.uid ||
        existing().companyOwnerId == request.auth.uid ||
        request.auth.uid in existing().supervisorUids ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.companyOwnerId == request.auth.uid ||
        request.auth.uid in resource.data.supervisorUids ||
        isAdmin()
      );

      allow create: if isSignedIn() && isValidId(requestId) &&
                       incoming().requesterId == request.auth.uid &&
                       incoming().status == 'PENDING' &&
                       isValidEmployeeRequest(incoming()) &&
                       exists(/databases/$(database)/documents/directThreads/$(incoming().threadId)) &&
                       request.auth.uid in get(/databases/$(database)/documents/directThreads/$(incoming().threadId)).data.participantIds;

      allow update: if isSignedIn() && isValidId(requestId) &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time && (
                         (existing().requesterId == request.auth.uid &&
                          incoming().status == 'CANCELLED' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
                         (isAuthorizedCompanyManager(existing().threadId, existing().companyOwnerId) &&
                          incoming().status in ['APPROVED', 'DENIED', 'COMPLETED'] &&
                          incoming().reviewedById == request.auth.uid &&
                          isStr(incoming().reviewedByName, 0, 40) && isStr(incoming().reviewerNote, 0, 300) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedById', 'reviewedByName', 'reviewerNote', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(requestId) &&
                       (existing().companyOwnerId == request.auth.uid || existing().requesterId == request.auth.uid || isAdmin());
    }
  }
}
