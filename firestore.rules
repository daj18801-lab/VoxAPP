rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL PRIMITIVE HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBoundedStringList(arr, maxLen) {
      return arr is list && arr.size() <= maxLen && (arr.size() == 0 || arr[0] is string);
    }

    function isValidHexColor(c) {
      return c is string && c.size() == 7 && c.matches('^#[0-9A-Fa-f]{6}$');
    }

    // Bootstrapped primary administrator (strictly requires verified email)
    function isBootstrappedAdmin() {
      return isSignedIn() &&
             ('email' in request.auth.token) &&
             ('email_verified' in request.auth.token) &&
             request.auth.token.email == 'daj18801@gmail.com' &&
             request.auth.token.email_verified == true;
    }

    function hasVerifiedEmail() {
      return isSignedIn() &&
             ('email' in request.auth.token) &&
             ('email_verified' in request.auth.token) &&
             request.auth.token.email_verified == true;
    }

    function hasStaffRoleDoc(uid) {
      return exists(/databases/$(database)/documents/staffRoles/$(uid));
    }

    function staffRoleData(uid) {
      return get(/databases/$(database)/documents/staffRoles/$(uid)).data;
    }

    function isAdmin() {
      return isBootstrappedAdmin() ||
             (isSignedIn() &&
              hasStaffRoleDoc(request.auth.uid) &&
              staffRoleData(request.auth.uid).staffTier == 'ADMIN');
    }

    function isSupport() {
      return isSignedIn() &&
             hasStaffRoleDoc(request.auth.uid) &&
             staffRoleData(request.auth.uid).staffTier == 'SUPPORT';
    }

    function isAdminOrSupport() {
      return isBootstrappedAdmin() ||
             (isSignedIn() &&
              hasStaffRoleDoc(request.auth.uid) &&
              staffRoleData(request.auth.uid).staffTier in ['ADMIN', 'SUPPORT']);
    }

    function isTargetAdmin(uid) {
      return hasStaffRoleDoc(uid) && staffRoleData(uid).staffTier == 'ADMIN';
    }

    // Admin always allowed invisible mode; Support allowed ONLY if Admin granted canEnterInvisible == true
    function canUseInvisibleMode() {
      return isBootstrappedAdmin() ||
             (isSignedIn() && hasStaffRoleDoc(request.auth.uid) && (
               staffRoleData(request.auth.uid).staffTier == 'ADMIN' ||
               (staffRoleData(request.auth.uid).staffTier == 'SUPPORT' &&
                ('canEnterInvisible' in staffRoleData(request.auth.uid)) &&
                staffRoleData(request.auth.uid).canEnterInvisible == true)
             ));
    }

    function isAllowedStaffTierClaim(tier) {
      return tier == 'USER' ||
             (tier == 'SUPPORT' && isAdminOrSupport()) ||
             (tier == 'ADMIN' && isAdmin());
    }

    // --- CALLER PROFILE RESTRICTION & SUSPENSION ENFORCEMENT ---
    function callerProfileExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isProfileAllowed(p, checkCreate, checkEnter, checkMic, checkVideo) {
      return (!('globallyBanned' in p) || p.globallyBanned == false) &&
             (!('suspendedUntilMillis' in p) || p.suspendedUntilMillis <= request.time.toMillis()) &&
             (!checkCreate || !('disableCreateRoom' in p) || p.disableCreateRoom == false) &&
             (!checkEnter || !('disableEnterRoom' in p) || p.disableEnterRoom == false) &&
             (!checkMic || !('disableMic' in p) || p.disableMic == false) &&
             (!checkVideo || !('disableVideo' in p) || p.disableVideo == false);
    }

    function callerPassesProfileChecks(checkCreate, checkEnter, checkMic, checkVideo) {
      return !callerProfileExists() ||
             isProfileAllowed(callerProfile(), checkCreate, checkEnter, checkMic, checkVideo) ||
             isAdmin();
    }

    function isAdultVerifiedProfile(p) {
      return ('adultVerified' in p) &&
             p.adultVerified == true &&
             ('birthYear' in p) &&
             p.birthYear is int &&
             p.birthYear >= 1900 &&
             p.birthYear <= request.time.year() - 18;
    }

    function isAdultVerifiedCaller() {
      return callerProfileExists() && isAdultVerifiedProfile(callerProfile());
    }

    function roomDoc(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId));
    }

    function roomExists(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId));
    }

    function isRoomHostOrMod(roomId) {
      let room = roomDoc(roomId).data;
      return room.hostId == request.auth.uid ||
             request.auth.uid in room.moderatorIds ||
             isAdminOrSupport();
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---
    function existingInt(doc, field) {
      return (field in doc && doc[field] is int) ? doc[field] : 0;
    }

    function isBouncedFromRoom(roomData, uid) {
      return ('bouncedUntilByUserId' in roomData) &&
             (roomData.bouncedUntilByUserId is map) &&
             (uid in roomData.bouncedUntilByUserId) &&
             (roomData.bouncedUntilByUserId[uid] is int) &&
             (roomData.bouncedUntilByUserId[uid] > request.time.toMillis());
    }

    function isValidPictureTimestampList(arr) {
      return arr is list &&
             arr.size() <= 10 &&
             (arr.size() == 0 || (arr[0] is int && arr[0] > 0 && arr[0] <= request.time.toMillis() + 60000)) &&
             (arr.size() < 2 || (arr[arr.size() - 1] is int && arr[arr.size() - 1] >= arr[0] && arr[arr.size() - 1] <= request.time.toMillis() + 60000));
    }

    function canUpdatePictureUploadTimestamps(newData, oldData) {
      let diffKeys = newData.diff(oldData).affectedKeys();
      return !('pictureUploadTimestamps' in diffKeys) ||
             !('pictureUploadTimestamps' in oldData) ||
             oldData.pictureUploadTimestamps.size() == 0 ||
             oldData.pictureUploadTimestamps[0] <= request.time.toMillis() - 600000 ||
             (newData.pictureUploadTimestamps.size() >= oldData.pictureUploadTimestamps.size() &&
              newData.pictureUploadTimestamps[0] == oldData.pictureUploadTimestamps[0]);
    }

    function callerUnderPictureUploadLimit() {
      return !callerProfileExists() || isUnderPicLimit(callerProfile());
    }

    function isUnderPicLimit(p) {
      return !('pictureUploadTimestamps' in p) ||
             p.pictureUploadTimestamps.size() < 10 ||
             p.pictureUploadTimestamps[0] <= request.time.toMillis() - 600000;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
               'userId', 'displayName', 'handle', 'bio', 'avatarColorHex',
               'pushToTalkPreferred', 'darkThemePreferred', 'blockedUserIds',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'displayName', 'handle', 'bio', 'avatarColorHex', 'photoBase64',
               'pushToTalkPreferred', 'darkThemePreferred', 'nightModeEnabled', 'invisibleModePreferred',
               'globallyBanned', 'disableCreateRoom', 'disableEnterRoom',
               'disableMic', 'disableVideo', 'suspendedUntilMillis', 'suspensionReason',
               'pointsBalance', 'creatorEarningsCents', 'totalSpentCents', 'dmPolicy',
               'adultVerified', 'birthYear',
               'blockedUserIds', 'pictureUploadTimestamps', 'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40 &&
             data.handle is string && data.handle.size() >= 2 && data.handle.size() <= 30 &&
             data.bio is string && data.bio.size() <= 200 &&
             isValidHexColor(data.avatarColorHex) &&
             (!('photoBase64' in data) || (data.photoBase64 is string && data.photoBase64.size() <= 140000)) &&
             data.pushToTalkPreferred is bool &&
             data.darkThemePreferred is bool &&
             (!('nightModeEnabled' in data) || data.nightModeEnabled is bool) &&
             (!('invisibleModePreferred' in data) || data.invisibleModePreferred is bool) &&
             (!('globallyBanned' in data) || data.globallyBanned is bool) &&
             (!('disableCreateRoom' in data) || data.disableCreateRoom is bool) &&
             (!('disableEnterRoom' in data) || data.disableEnterRoom is bool) &&
             (!('disableMic' in data) || data.disableMic is bool) &&
             (!('disableVideo' in data) || data.disableVideo is bool) &&
             (!('suspendedUntilMillis' in data) || (data.suspendedUntilMillis is int && data.suspendedUntilMillis >= 0)) &&
             (!('suspensionReason' in data) || (data.suspensionReason is string && data.suspensionReason.size() <= 200)) &&
             (!('pointsBalance' in data) || (data.pointsBalance is int && data.pointsBalance >= 0 && data.pointsBalance <= 1000000)) &&
             (!('creatorEarningsCents' in data) || (data.creatorEarningsCents is int && data.creatorEarningsCents >= 0 && data.creatorEarningsCents <= 1000000000)) &&
             (!('totalSpentCents' in data) || (data.totalSpentCents is int && data.totalSpentCents >= 0 && data.totalSpentCents <= 1000000000)) &&
             (!('dmPolicy' in data) || data.dmPolicy in ['OPEN', 'PAID', 'DISABLED']) &&
             (!('adultVerified' in data) || data.adultVerified is bool) &&
             (!('birthYear' in data) || (data.birthYear is int && (data.birthYear == 0 || (data.birthYear >= 1900 && data.birthYear <= request.time.year())))) &&
             (!('adultVerified' in data) || !data.adultVerified || isAdultVerifiedProfile(data)) &&
             isBoundedStringList(data.blockedUserIds, 100) &&
             (!('pictureUploadTimestamps' in data) || isValidPictureTimestampList(data.pictureUploadTimestamps)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function hasNoSelfRestrictionOverrides(data) {
      return (!('globallyBanned' in data) || data.globallyBanned == false) &&
             (!('disableCreateRoom' in data) || data.disableCreateRoom == false) &&
             (!('disableEnterRoom' in data) || data.disableEnterRoom == false) &&
             (!('disableMic' in data) || data.disableMic == false) &&
             (!('disableVideo' in data) || data.disableVideo == false) &&
             (!('suspendedUntilMillis' in data) || data.suspendedUntilMillis == 0) &&
             (!('suspensionReason' in data) || data.suspensionReason == '') &&
             (!('pointsBalance' in data) || data.pointsBalance == 0) &&
             (!('creatorEarningsCents' in data) || data.creatorEarningsCents == 0) &&
             (!('totalSpentCents' in data) || data.totalSpentCents == 0) &&
             (!('pictureUploadTimestamps' in data) || data.pictureUploadTimestamps.size() == 0);
    }

    function isValidStaffRole(data) {
      return data.keys().hasAll([
               'userId', 'email', 'displayName', 'staffTier',
               'addedByUid', 'addedByName', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'email', 'displayName', 'staffTier', 'canEnterInvisible',
               'addedByUid', 'addedByName', 'inviteId', 'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 120 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40 &&
             data.staffTier in ['ADMIN', 'SUPPORT'] &&
             (!('canEnterInvisible' in data) || data.canEnterInvisible is bool) &&
             data.addedByUid is string && data.addedByUid.size() >= 1 && data.addedByUid.size() <= 128 &&
             data.addedByName is string && data.addedByName.size() >= 1 && data.addedByName.size() <= 40 &&
             (!('inviteId' in data) || (data.inviteId is string && data.inviteId.size() <= 128)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidStaffInvite(data) {
      return data.keys().hasAll([
               'email', 'displayName', 'staffTier', 'addedByUid', 'addedByName', 'createdAt'
             ]) &&
             data.keys().hasOnly([
               'email', 'displayName', 'staffTier', 'canEnterInvisible',
               'addedByUid', 'addedByName', 'createdAt'
             ]) &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40 &&
             data.staffTier in ['ADMIN', 'SUPPORT'] &&
             (!('canEnterInvisible' in data) || data.canEnterInvisible is bool) &&
             data.addedByUid is string && data.addedByUid.size() >= 1 && data.addedByUid.size() <= 128 &&
             data.addedByName is string && data.addedByName.size() >= 1 && data.addedByName.size() <= 40 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidUserAlert(data) {
      return data.keys().hasAll([
               'targetUserId', 'targetName', 'senderId', 'senderName', 'senderTier',
               'roomId', 'title', 'message', 'severity', 'acknowledged',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'targetUserId', 'targetName', 'senderId', 'senderName', 'senderTier',
               'roomId', 'title', 'message', 'severity', 'acknowledged',
               'createdAt', 'updatedAt'
             ]) &&
             data.targetUserId is string && data.targetUserId.size() >= 1 && data.targetUserId.size() <= 128 &&
             data.targetName is string && data.targetName.size() >= 1 && data.targetName.size() <= 40 &&
             data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 40 &&
             data.senderTier in ['ADMIN', 'SUPPORT'] &&
             data.roomId is string && data.roomId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 60 &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 300 &&
             data.severity in ['INFO', 'WARNING', 'URGENT'] &&
             data.acknowledged is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidRoom(data) {
      return data.keys().hasAll([
               'hostId', 'hostName', 'title', 'topic', 'category', 'coverKey',
               'visibility', 'status', 'videoEnabled', 'autoModEnabled',
               'autoModBlockMode', 'linksBlocked', 'roomLocked', 'stageMicLocked',
               'slowModeSeconds', 'maxSpeakers', 'participantCount',
               'moderatorIds', 'bannedUserIds', 'mutedUserIds', 'blockedWords',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'hostId', 'hostName', 'hostTier', 'title', 'topic', 'category', 'coverKey',
               'visibility', 'status', 'videoEnabled', 'autoModEnabled',
               'autoModBlockMode', 'linksBlocked', 'roomLocked', 'stageMicLocked',
               'adminMicPriorityActive', 'slowModeSeconds', 'maxSpeakers', 'participantCount',
               'moderatorIds', 'bannedUserIds', 'bouncedUntilByUserId', 'mutedUserIds', 'blockedWords',
               'createdAt', 'updatedAt'
             ]) &&
             data.hostId is string && data.hostId.size() >= 1 && data.hostId.size() <= 128 &&
             data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 40 &&
             (!('hostTier' in data) || data.hostTier in ['USER', 'SUPPORT', 'ADMIN']) &&
             data.title is string && data.title.size() <= 60 &&
             data.topic is string && data.topic.size() <= 160 &&
             data.category in ['VOICE_VIDEO', 'MUSIC', 'TECH', 'LOUNGE', 'GAMING', 'LANGUAGE', 'SAFE_SPACE'] &&
             data.coverKey in ['HERO', 'MUSIC', 'TECH', 'DEBATE'] &&
             data.visibility in ['PUBLIC', 'PRIVATE'] &&
             data.status in ['LIVE', 'CLOSED'] &&
             data.videoEnabled is bool &&
             data.autoModEnabled is bool &&
             data.autoModBlockMode is bool &&
             data.linksBlocked is bool &&
             data.roomLocked is bool &&
             data.stageMicLocked is bool &&
             (!('adminMicPriorityActive' in data) || data.adminMicPriorityActive is bool) &&
             data.slowModeSeconds is int && data.slowModeSeconds in [0, 3, 10, 30] &&
             data.maxSpeakers is int && data.maxSpeakers >= 2 && data.maxSpeakers <= 12 &&
             data.participantCount is int && data.participantCount >= 0 && data.participantCount <= 1000 &&
             isBoundedStringList(data.moderatorIds, 20) &&
             data.hostId in data.moderatorIds &&
             isBoundedStringList(data.bannedUserIds, 100) &&
             (!('bouncedUntilByUserId' in data) || (data.bouncedUntilByUserId is map && data.bouncedUntilByUserId.size() <= 100)) &&
             isBoundedStringList(data.mutedUserIds, 100) &&
             isBoundedStringList(data.blockedWords, 50) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidParticipant(data) {
      return data.keys().hasAll([
               'userId', 'roomId', 'displayName', 'avatarColorHex', 'role',
               'micActive', 'camActive', 'handRaised', 'mutedByMod',
               'speakingLevel', 'joinedAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'roomId', 'displayName', 'avatarColorHex', 'role',
               'staffTier', 'invisible', 'micActive', 'camActive', 'handRaised',
               'mutedByMod', 'speakingLevel', 'joinedAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40 &&
             isValidHexColor(data.avatarColorHex) &&
             data.role in ['HOST', 'MODERATOR', 'SPEAKER', 'LISTENER'] &&
             (!('staffTier' in data) || data.staffTier in ['USER', 'SUPPORT', 'ADMIN']) &&
             (!('invisible' in data) || data.invisible is bool) &&
             data.micActive is bool &&
             data.camActive is bool &&
             data.handRaised is bool &&
             data.mutedByMod is bool &&
             (data.speakingLevel is number) && data.speakingLevel >= 0.0 && data.speakingLevel <= 1.0 &&
             data.joinedAt is timestamp && data.joinedAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMessage(data) {
      return data.keys().hasAll([
               'roomId', 'senderId', 'senderName', 'senderRole', 'text',
               'messageType', 'flaggedByAutoMod', 'deletedByMod',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'roomId', 'senderId', 'senderName', 'senderRole', 'senderTier',
               'text', 'messageType', 'flaggedByAutoMod', 'deletedByMod',
               'reactionsByEmoji', 'createdAt', 'updatedAt'
             ]) &&
             data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 128 &&
             data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 40 &&
             data.senderRole in ['HOST', 'MODERATOR', 'SPEAKER', 'LISTENER', 'SYSTEM'] &&
             (!('senderTier' in data) || data.senderTier in ['USER', 'SUPPORT', 'ADMIN']) &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 500 &&
             data.messageType in ['TEXT', 'REACTION', 'MOD_NOTICE', 'JOIN_LEAVE'] &&
             data.flaggedByAutoMod is bool &&
             data.deletedByMod is bool &&
             (!('reactionsByEmoji' in data) ||
              (data.reactionsByEmoji is map &&
               data.reactionsByEmoji.size() <= 8 &&
               data.reactionsByEmoji.keys().hasOnly(['❤️', '😂', '🔥', '👏', '😮', '👍', '🎉', '🙌']))) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidModLog(data) {
      return data.keys().hasAll([
               'roomId', 'actorId', 'actorName', 'targetUserId', 'targetName',
               'actionType', 'reason', 'createdAt'
             ]) &&
             data.keys().hasOnly([
               'roomId', 'actorId', 'actorName', 'targetUserId', 'targetName',
               'actionType', 'reason', 'createdAt'
             ]) &&
             data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 128 &&
             data.actorId is string && data.actorId.size() >= 1 && data.actorId.size() <= 128 &&
             data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 40 &&
             data.targetUserId is string && data.targetUserId.size() <= 128 &&
             data.targetName is string && data.targetName.size() <= 40 &&
             data.actionType in [
               'MUTE', 'UNMUTE', 'BOUNCE', 'KICK', 'SUSPEND', 'BAN', 'UNBAN',
               'DELETE_MSG', 'AUTO_MOD', 'LOCK_ROOM', 'STAGE_MUTE',
               'PROMOTE_MOD', 'DEMOTE_MOD', 'SEND_ALERT', 'STAFF_ROLE',
               'EDIT_USER', 'EDIT_ROOM', 'CLOSE_ROOM', 'SETTINGS'
             ] &&
             data.reason is string && data.reason.size() <= 200 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidSafetyReport(data) {
      return data.keys().hasAll([
               'reporterId', 'reporterName', 'roomId', 'roomTitle', 'roomHostId',
               'targetUserId', 'targetName', 'category', 'details', 'status',
               'resolutionNote', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'reporterId', 'reporterName', 'roomId', 'roomTitle', 'roomHostId',
               'targetUserId', 'targetName', 'category', 'details', 'status',
               'resolutionNote', 'createdAt', 'updatedAt'
             ]) &&
             data.reporterId is string && data.reporterId.size() >= 1 && data.reporterId.size() <= 128 &&
             data.reporterName is string && data.reporterName.size() >= 1 && data.reporterName.size() <= 40 &&
             data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 128 &&
             data.roomTitle is string && data.roomTitle.size() >= 1 && data.roomTitle.size() <= 60 &&
             data.roomHostId is string && data.roomHostId.size() >= 1 && data.roomHostId.size() <= 128 &&
             data.targetUserId is string && data.targetUserId.size() >= 1 && data.targetUserId.size() <= 128 &&
             data.targetName is string && data.targetName.size() >= 1 && data.targetName.size() <= 40 &&
             data.category in ['HARASSMENT', 'HATE_SPEECH', 'SPAM_SCAM', 'INAPPROPRIATE_MEDIA', 'IMPERSONATION', 'OTHER'] &&
             data.details is string && data.details.size() >= 1 && data.details.size() <= 400 &&
             data.status in ['OPEN', 'RESOLVED', 'DISMISSED'] &&
             data.resolutionNote is string && data.resolutionNote.size() <= 200 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidDirectoryEntry(data) {
      return data.keys().hasAll([
               'userId', 'displayName', 'handle', 'avatarColorHex', 'staffTier', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'displayName', 'handle', 'bio', 'avatarColorHex', 'photoBase64',
               'staffTier', 'postCount', 'dmPolicy', 'online', 'lastActiveAt',
               'acceptedFriendIds', 'updatedAt'
             ]) &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40 &&
             data.handle is string && data.handle.size() >= 2 && data.handle.size() <= 30 &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 200)) &&
             isValidHexColor(data.avatarColorHex) &&
             (!('photoBase64' in data) || (data.photoBase64 is string && data.photoBase64.size() <= 140000)) &&
             data.staffTier in ['USER', 'SUPPORT', 'ADMIN'] &&
             (!('postCount' in data) || (data.postCount is int && data.postCount >= 0 && data.postCount <= 100000)) &&
             (!('acceptedFriendIds' in data) || isBoundedStringList(data.acceptedFriendIds, 200)) &&
             (!('dmPolicy' in data) || data.dmPolicy in ['OPEN', 'PAID', 'DISABLED']) &&
             (!('online' in data) || data.online is bool) &&
             (!('lastActiveAt' in data) || (data.lastActiveAt is timestamp && data.lastActiveAt <= request.time)) &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidProfilePost(data) {
      return data.keys().hasAll([
               'authorId', 'authorName', 'authorHandle', 'authorColorHex', 'authorTier',
               'text', 'imageBase64', 'likedByUserIds', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'authorId', 'authorName', 'authorHandle', 'authorColorHex', 'authorPhotoBase64',
               'authorTier', 'text', 'imageBase64', 'locked', 'unlockPricePoints', 'unlockedByUserIds',
               'boostedAtMillis', 'boostedUntilMillis', 'likedByUserIds',
               'commentCount', 'shareCount',
               'sharedFromPostId', 'sharedFromAuthorId', 'sharedFromAuthorName', 'sharedFromAuthorHandle',
               'createdAt', 'updatedAt'
             ]) &&
             data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 40 &&
             data.authorHandle is string && data.authorHandle.size() >= 2 && data.authorHandle.size() <= 30 &&
             isValidHexColor(data.authorColorHex) &&
             (!('authorPhotoBase64' in data) || (data.authorPhotoBase64 is string && data.authorPhotoBase64.size() <= 140000)) &&
             data.authorTier in ['USER', 'SUPPORT', 'ADMIN'] &&
             data.text is string && data.text.size() <= 1000 &&
             data.imageBase64 is string && data.imageBase64.size() <= 460000 &&
             (data.text.size() >= 1 || data.imageBase64.size() >= 1) &&
             (!('locked' in data) || data.locked is bool) &&
             (!('locked' in data) || !data.locked || data.imageBase64.size() >= 1) &&
             (!('unlockPricePoints' in data) || (data.unlockPricePoints is int && data.unlockPricePoints == 2)) &&
             (!('unlockedByUserIds' in data) || isBoundedStringList(data.unlockedByUserIds, 500)) &&
             (!('boostedAtMillis' in data) || (data.boostedAtMillis is int && data.boostedAtMillis >= 0)) &&
             (!('boostedUntilMillis' in data) || (data.boostedUntilMillis is int && data.boostedUntilMillis >= 0)) &&
             (!('commentCount' in data) || (data.commentCount is int && data.commentCount >= 0 && data.commentCount <= 100000)) &&
             (!('shareCount' in data) || (data.shareCount is int && data.shareCount >= 0 && data.shareCount <= 100000)) &&
             (!('sharedFromPostId' in data) || (data.sharedFromPostId is string && data.sharedFromPostId.size() <= 128)) &&
             (!('sharedFromAuthorId' in data) || (data.sharedFromAuthorId is string && data.sharedFromAuthorId.size() <= 128)) &&
             (!('sharedFromAuthorName' in data) || (data.sharedFromAuthorName is string && data.sharedFromAuthorName.size() <= 40)) &&
             (!('sharedFromAuthorHandle' in data) || (data.sharedFromAuthorHandle is string && data.sharedFromAuthorHandle.size() <= 30)) &&
             isBoundedStringList(data.likedByUserIds, 500) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPostComment(data) {
      return data.keys().hasAll([
               'postId', 'authorId', 'authorName', 'authorHandle', 'authorColorHex',
               'authorTier', 'text', 'createdAt'
             ]) &&
             data.keys().hasOnly([
               'postId', 'authorId', 'authorName', 'authorHandle', 'authorColorHex',
               'authorPhotoBase64', 'authorTier', 'text', 'createdAt'
             ]) &&
             data.postId is string && data.postId.size() >= 1 && data.postId.size() <= 128 &&
             data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 40 &&
             data.authorHandle is string && data.authorHandle.size() >= 2 && data.authorHandle.size() <= 30 &&
             isValidHexColor(data.authorColorHex) &&
             (!('authorPhotoBase64' in data) || (data.authorPhotoBase64 is string && data.authorPhotoBase64.size() <= 140000)) &&
             data.authorTier in ['USER', 'SUPPORT', 'ADMIN'] &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 500 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isOriginalPostShareable(origPostId) {
      return exists(/databases/$(database)/documents/profilePosts/$(origPostId)) &&
             !(('locked' in get(/databases/$(database)/documents/profilePosts/$(origPostId)).data) &&
               get(/databases/$(database)/documents/profilePosts/$(origPostId)).data.locked == true);
    }

    function isValidFriendship(data) {
      return data.keys().hasAll([
               'userIds', 'requesterId', 'requesterName', 'requesterHandle', 'requesterColorHex', 'requesterTier',
               'recipientId', 'recipientName', 'recipientHandle', 'recipientColorHex', 'recipientTier',
               'status', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userIds', 'requesterId', 'requesterName', 'requesterHandle', 'requesterColorHex', 'requesterTier',
               'recipientId', 'recipientName', 'recipientHandle', 'recipientColorHex', 'recipientTier',
               'status', 'createdAt', 'updatedAt'
             ]) &&
             data.userIds is list && data.userIds.size() == 2 &&
             data.requesterId is string && data.requesterId.size() >= 1 && data.requesterId.size() <= 128 &&
             data.recipientId is string && data.recipientId.size() >= 1 && data.recipientId.size() <= 128 &&
             data.requesterId != data.recipientId &&
             data.requesterId in data.userIds && data.recipientId in data.userIds &&
             data.requesterName is string && data.requesterName.size() >= 1 && data.requesterName.size() <= 40 &&
             data.requesterHandle is string && data.requesterHandle.size() >= 2 && data.requesterHandle.size() <= 30 &&
             isValidHexColor(data.requesterColorHex) &&
             data.requesterTier in ['USER', 'SUPPORT', 'ADMIN'] &&
             data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 40 &&
             data.recipientHandle is string && data.recipientHandle.size() >= 2 && data.recipientHandle.size() <= 30 &&
             isValidHexColor(data.recipientColorHex) &&
             data.recipientTier in ['USER', 'SUPPORT', 'ADMIN'] &&
             data.status in ['PENDING', 'ACCEPTED'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidDirectThread(data) {
      return data.keys().hasAll([
               'participantIds', 'userAId', 'userAName', 'userAColorHex', 'userATier',
               'userBId', 'userBName', 'userBColorHex', 'userBTier',
               'lastMessageText', 'lastMessageSenderId', 'unreadByUserIds',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'participantIds', 'isGroup', 'groupName', 'participantNamesById', 'kickedUserIds',
               'blockedByUserIds', 'pttEnabledUserIds',
               'disappearingDurationSec', 'readReceiptsDisabledByUserIds', 'readTimestampsByUserId',
               'lastAlertSenderId', 'lastAlertSenderName', 'lastAlertAtMillis',
               'userAId', 'userAName', 'userAColorHex', 'userATier',
               'userBId', 'userBName', 'userBColorHex', 'userBTier',
               'lastMessageText', 'lastMessageSenderId', 'unreadByUserIds',
               'createdAt', 'updatedAt'
             ]) &&
             data.participantIds is list && data.participantIds.size() >= 2 && data.participantIds.size() <= 15 &&
             (!('isGroup' in data) || data.isGroup is bool) &&
             (!('groupName' in data) || (data.groupName is string && data.groupName.size() <= 60)) &&
             (!('participantNamesById' in data) || (data.participantNamesById is map && data.participantNamesById.size() <= 15)) &&
             (!('kickedUserIds' in data) || isBoundedStringList(data.kickedUserIds, 20)) &&
             (!('blockedByUserIds' in data) || isBoundedStringList(data.blockedByUserIds, 15)) &&
             (!('pttEnabledUserIds' in data) || isBoundedStringList(data.pttEnabledUserIds, 15)) &&
             (!('disappearingDurationSec' in data) || (data.disappearingDurationSec is int && data.disappearingDurationSec in [0, 30, 300, 3600, 86400])) &&
             (!('readReceiptsDisabledByUserIds' in data) || isBoundedStringList(data.readReceiptsDisabledByUserIds, 15)) &&
             (!('readTimestampsByUserId' in data) || (data.readTimestampsByUserId is map && data.readTimestampsByUserId.size() <= 15)) &&
             (!('lastAlertSenderId' in data) || (data.lastAlertSenderId is string && data.lastAlertSenderId.size() <= 128)) &&
             (!('lastAlertSenderName' in data) || (data.lastAlertSenderName is string && data.lastAlertSenderName.size() <= 40)) &&
             (!('lastAlertAtMillis' in data) || (data.lastAlertAtMillis is int && data.lastAlertAtMillis >= 0)) &&
             data.userAId is string && data.userAId.size() >= 1 && data.userAId.size() <= 128 &&
             data.userBId is string && data.userBId.size() >= 1 && data.userBId.size() <= 128 &&
             data.userAId != data.userBId &&
             data.userAId in data.participantIds && data.userBId in data.participantIds &&
             data.userAName is string && data.userAName.size() >= 1 && data.userAName.size() <= 40 &&
             isValidHexColor(data.userAColorHex) &&
             data.userATier in ['USER', 'SUPPORT', 'ADMIN'] &&
             data.userBName is string && data.userBName.size() >= 1 && data.userBName.size() <= 40 &&
             isValidHexColor(data.userBColorHex) &&
             data.userBTier in ['USER', 'SUPPORT', 'ADMIN'] &&
             data.lastMessageText is string && data.lastMessageText.size() <= 300 &&
             data.lastMessageSenderId is string && data.lastMessageSenderId.size() <= 128 &&
             isBoundedStringList(data.unreadByUserIds, 15) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidDirectMessage(data) {
      return data.keys().hasAll([
               'threadId', 'participantIds', 'senderId', 'senderName', 'senderTier', 'text', 'createdAt'
             ]) &&
             data.keys().hasOnly([
               'threadId', 'participantIds', 'senderId', 'senderName', 'senderTier',
               'text', 'imageBase64', 'audioBase64', 'audioDurationSec', 'expiresAtMillis', 'createdAt'
             ]) &&
             data.threadId is string && data.threadId.size() >= 1 && data.threadId.size() <= 260 &&
             data.participantIds is list && data.participantIds.size() >= 2 && data.participantIds.size() <= 15 &&
             data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
             data.senderId in data.participantIds &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 40 &&
             data.senderTier in ['USER', 'SUPPORT', 'ADMIN'] &&
             data.text is string && data.text.size() <= 500 &&
             (!('imageBase64' in data) || (data.imageBase64 is string && data.imageBase64.size() <= 460000)) &&
             (!('audioBase64' in data) || (data.audioBase64 is string && data.audioBase64.size() <= 300000)) &&
             (!('audioDurationSec' in data) || (data.audioDurationSec is int && data.audioDurationSec >= 0 && data.audioDurationSec <= 60)) &&
             (!('expiresAtMillis' in data) || (data.expiresAtMillis is int && data.expiresAtMillis >= 0)) &&
             (data.text.size() >= 1 ||
              ('imageBase64' in data && data.imageBase64.size() >= 1) ||
              ('audioBase64' in data && data.audioBase64.size() >= 1)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidSupportTicket(data) {
      return data.keys().hasAll([
               'requesterId', 'requesterName', 'requesterTier',
               'category', 'subject', 'message', 'status', 'staffResponse',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'requesterId', 'requesterName', 'requesterTier',
               'assignedStaffId', 'assignedStaffName',
               'category', 'subject', 'message', 'status', 'staffResponse',
               'createdAt', 'updatedAt'
             ]) &&
             data.requesterId is string && data.requesterId.size() >= 1 && data.requesterId.size() <= 128 &&
             data.requesterName is string && data.requesterName.size() >= 1 && data.requesterName.size() <= 40 &&
             data.requesterTier in ['USER', 'SUPPORT', 'ADMIN'] &&
             (!('assignedStaffId' in data) || (data.assignedStaffId is string && data.assignedStaffId.size() <= 128)) &&
             (!('assignedStaffName' in data) || (data.assignedStaffName is string && data.assignedStaffName.size() <= 40)) &&
             data.category in ['ACCOUNT', 'BILLING', 'SAFETY', 'BUG', 'OTHER'] &&
             data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 100 &&
             data.message is string && data.message.size() >= 4 && data.message.size() <= 600 &&
             data.status in ['OPEN', 'IN_PROGRESS', 'RESOLVED'] &&
             data.staffResponse is string && data.staffResponse.size() <= 600 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidDmAccessPass(data) {
      return data.keys().hasAll([
               'senderId', 'senderName', 'recipientId', 'recipientName',
               'priceCents', 'creatorShareCents', 'platformShareCents',
               'active', 'kicked', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'senderId', 'senderName', 'recipientId', 'recipientName',
               'priceCents', 'creatorShareCents', 'platformShareCents',
               'active', 'kicked', 'createdAt', 'updatedAt'
             ]) &&
             data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 40 &&
             data.recipientId is string && data.recipientId.size() >= 1 && data.recipientId.size() <= 128 &&
             data.recipientName is string && data.recipientName.size() >= 1 && data.recipientName.size() <= 40 &&
             data.senderId != data.recipientId &&
             data.priceCents is int && data.priceCents == 1000 &&
             data.creatorShareCents is int && data.creatorShareCents == 500 &&
             data.platformShareCents is int && data.platformShareCents == 500 &&
             data.active is bool &&
             data.kicked is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function hasActiveDmPass(targetUid) {
      let passId = request.auth.uid + '_' + targetUid;
      return exists(/databases/$(database)/documents/dmAccessPasses/$(passId)) &&
             isPassActive(get(/databases/$(database)/documents/dmAccessPasses/$(passId)).data);
    }

    function isPassActive(passData) {
      return passData.active == true && passData.kicked == false;
    }

    function canMessageWithDirectory(dirData, targetUid) {
      let policy = ('dmPolicy' in dirData) ? dirData.dmPolicy : 'OPEN';
      return policy == 'OPEN' || (policy == 'PAID' && hasActiveDmPass(targetUid));
    }

    function hasBlockedUid(profileData, otherUid) {
      return ('blockedUserIds' in profileData) && (otherUid in profileData.blockedUserIds);
    }

    function isBlockedBetween(uidA, uidB) {
      return (exists(/databases/$(database)/documents/users/$(uidA)) &&
              hasBlockedUid(get(/databases/$(database)/documents/users/$(uidA)).data, uidB)) ||
             (exists(/databases/$(database)/documents/users/$(uidB)) &&
              hasBlockedUid(get(/databases/$(database)/documents/users/$(uidB)).data, uidA));
    }

    function canMessageUser(targetUid) {
      return isAdmin() ||
             targetUid == request.auth.uid ||
             !exists(/databases/$(database)/documents/userDirectory/$(targetUid)) ||
             canMessageWithDirectory(get(/databases/$(database)/documents/userDirectory/$(targetUid)).data, targetUid);
    }

    function otherOneOnOneUid(threadData) {
      return threadData.userAId == request.auth.uid ? threadData.userBId : threadData.userAId;
    }

    function isThreadGroup(threadData) {
      return ('isGroup' in threadData) && threadData.isGroup == true;
    }

    function isKickedFromThread(threadData, uid) {
      return ('kickedUserIds' in threadData) && (uid in threadData.kickedUserIds);
    }

    function hasAnyThreadBlock(threadData) {
      return ('blockedByUserIds' in threadData) && threadData.blockedByUserIds.size() > 0;
    }

    function isValidCreatorSubscription(data) {
      return data.keys().hasAll([
               'subscriberId', 'creatorId', 'creatorName', 'priceCents',
               'creatorShareCents', 'platformShareCents', 'active', 'expiresAtMillis',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'subscriberId', 'creatorId', 'creatorName', 'priceCents',
               'creatorShareCents', 'platformShareCents', 'active', 'expiresAtMillis',
               'createdAt', 'updatedAt'
             ]) &&
             data.subscriberId is string && data.subscriberId.size() >= 1 && data.subscriberId.size() <= 128 &&
             data.creatorId is string && data.creatorId.size() >= 1 && data.creatorId.size() <= 128 &&
             data.subscriberId != data.creatorId &&
             data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 40 &&
             data.priceCents is int && data.priceCents == 1500 &&
             data.creatorShareCents is int && data.creatorShareCents == 750 &&
             data.platformShareCents is int && data.platformShareCents == 750 &&
             data.active is bool &&
             data.expiresAtMillis is int && data.expiresAtMillis > request.time.toMillis() &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPointTransaction(data) {
      return data.keys().hasAll([
               'type', 'buyerId', 'buyerName', 'creatorId', 'creatorName', 'postId',
               'pointsDelta', 'grossCents', 'creatorShareCents', 'platformShareCents', 'createdAt'
             ]) &&
             data.keys().hasOnly([
               'type', 'buyerId', 'buyerName', 'creatorId', 'creatorName', 'postId',
               'pointsDelta', 'grossCents', 'creatorShareCents', 'platformShareCents',
               'playOrderId', 'playProductId', 'createdAt'
             ]) &&
             data.type in ['BUY_POINTS', 'UNLOCK_PHOTO', 'SUBSCRIBE_CREATOR', 'BOOST_POST', 'UNLOCK_DM'] &&
             data.buyerId is string && data.buyerId.size() >= 1 && data.buyerId.size() <= 128 &&
             data.buyerName is string && data.buyerName.size() >= 1 && data.buyerName.size() <= 40 &&
             data.creatorId is string && data.creatorId.size() <= 128 &&
             data.creatorName is string && data.creatorName.size() <= 40 &&
             data.postId is string && data.postId.size() <= 128 &&
             data.pointsDelta is int &&
             data.grossCents is int &&
             data.creatorShareCents is int &&
             data.platformShareCents is int &&
             (!('playOrderId' in data) || (data.playOrderId is string && data.playOrderId.size() <= 128)) &&
             (!('playProductId' in data) || (data.playProductId is string && data.playProductId.size() <= 64)) &&
             data.createdAt is timestamp && data.createdAt <= request.time && (
               (data.type == 'BUY_POINTS' &&
                data.pointsDelta >= 2 && data.pointsDelta <= 500 &&
                data.grossCents == data.pointsDelta * 100 &&
                data.creatorShareCents == 0 &&
                data.platformShareCents == 0 &&
                data.creatorId == '' &&
                data.postId == '') ||
               (data.type == 'UNLOCK_PHOTO' &&
                data.pointsDelta == -2 &&
                data.grossCents == 200 &&
                data.creatorShareCents == 100 &&
                data.platformShareCents == 100 &&
                data.creatorId.size() >= 1 &&
                data.creatorId != data.buyerId &&
                data.postId.size() >= 1) ||
               (data.type == 'SUBSCRIBE_CREATOR' &&
                data.pointsDelta == 0 &&
                data.grossCents == 1500 &&
                data.creatorShareCents == 750 &&
                data.platformShareCents == 750 &&
                data.creatorId.size() >= 1 &&
                data.creatorId != data.buyerId &&
                data.postId == '') ||
               (data.type == 'BOOST_POST' &&
                data.pointsDelta == -5 &&
                data.grossCents == 500 &&
                data.creatorShareCents == 0 &&
                data.platformShareCents == 500 &&
                data.creatorId == '' &&
                data.creatorName == '' &&
                data.postId.size() >= 1) ||
               (data.type == 'UNLOCK_DM' &&
                data.pointsDelta == 0 &&
                data.grossCents == 1000 &&
                data.creatorShareCents == 500 &&
                data.platformShareCents == 500 &&
                data.creatorId.size() >= 1 &&
                data.creatorId != data.buyerId &&
                data.postId == '')
             );
    }

    function isValidAppConfig(data) {
      return data.keys().hasAll([
               'bannerTitle', 'bannerMessage', 'bannerEnabled', 'trialLoginsEnabled',
               'updatedByName', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'bannerTitle', 'bannerMessage', 'bannerEnabled', 'trialLoginsEnabled',
               'updatedByName', 'updatedAt'
             ]) &&
             data.bannerTitle is string && data.bannerTitle.size() <= 80 &&
             data.bannerMessage is string && data.bannerMessage.size() <= 400 &&
             data.bannerEnabled is bool &&
             data.trialLoginsEnabled is bool &&
             data.updatedByName is string && data.updatedByName.size() <= 40 &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidRoomTransfer(data, targetUid) {
      return data.keys().hasAll([
               'userId', 'targetRoomId', 'targetRoomTitle', 'fromRoomId',
               'movedByAdminId', 'movedByAdminName', 'reason', 'consumed', 'createdAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'targetRoomId', 'targetRoomTitle', 'fromRoomId',
               'movedByAdminId', 'movedByAdminName', 'reason', 'consumed', 'createdAt'
             ]) &&
             data.userId is string && data.userId == targetUid &&
             data.targetRoomId is string && data.targetRoomId.size() >= 1 && data.targetRoomId.size() <= 128 &&
             data.targetRoomTitle is string && data.targetRoomTitle.size() >= 1 && data.targetRoomTitle.size() <= 60 &&
             data.fromRoomId is string && data.fromRoomId.size() <= 128 &&
             data.movedByAdminId is string && data.movedByAdminId.size() >= 1 && data.movedByAdminId.size() <= 128 &&
             data.movedByAdminName is string && data.movedByAdminName.size() >= 1 && data.movedByAdminName.size() <= 40 &&
             data.reason is string && data.reason.size() <= 200 &&
             data.consumed is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidOwnerWalletUpdate(newData, oldData) {
      let oldPts = existingInt(oldData, 'pointsBalance');
      let newPts = existingInt(newData, 'pointsBalance');
      let oldSpent = existingInt(oldData, 'totalSpentCents');
      let newSpent = existingInt(newData, 'totalSpentCents');
      let ptsDelta = newPts - oldPts;
      return newPts >= 0 &&
             canUpdatePictureUploadTimestamps(newData, oldData) &&
             newData.diff(oldData).affectedKeys().hasOnly(['pointsBalance', 'totalSpentCents', 'pictureUploadTimestamps', 'updatedAt']) && (
        (ptsDelta >= 2 && ptsDelta <= 500 && newSpent == oldSpent + (ptsDelta * 100)) ||
        (ptsDelta == -2 && newSpent == oldSpent) ||
        (ptsDelta == -5 && newSpent == oldSpent) ||
        (ptsDelta == 0 && (newSpent == oldSpent + 1500 || newSpent == oldSpent + 1000))
      );
    }

    function callerPaidFivePointsInBatch() {
      let beforeProfile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let afterProfile = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let oldPts = existingInt(beforeProfile, 'pointsBalance');
      let newPts = existingInt(afterProfile, 'pointsBalance');
      return newPts >= 0 && newPts == oldPts - 5;
    }

    function isValidBoostWindow(data) {
      return ('boostedAtMillis' in data) && ('boostedUntilMillis' in data) &&
             data.boostedAtMillis is int && data.boostedAtMillis > 0 &&
             data.boostedUntilMillis is int &&
             data.boostedUntilMillis > request.time.toMillis() &&
             data.boostedUntilMillis <= request.time.toMillis() + 86700000;
    }

    function isValidCreatorEarningsCredit(newData, oldData) {
      let oldEarn = existingInt(oldData, 'creatorEarningsCents');
      let newEarn = existingInt(newData, 'creatorEarningsCents');
      return newData.diff(oldData).affectedKeys().hasOnly(['creatorEarningsCents', 'updatedAt']) &&
             (newEarn == oldEarn + 100 || newEarn == oldEarn + 500 || newEarn == oldEarn + 750);
    }

    function canUpdateProfilePost(newData, oldData) {
      let diffKeys = newData.diff(oldData).affectedKeys();
      let isAuthor = oldData.authorId == request.auth.uid;
      let isLocked = ('locked' in oldData) && oldData.locked == true;
      let nextLocked = ('locked' in newData) && newData.locked == true;
      return (isAuthor &&
              (!nextLocked || isAdultVerifiedCaller()) &&
              diffKeys.hasOnly([
                'text', 'imageBase64', 'locked', 'authorName', 'authorHandle',
                'authorColorHex', 'authorPhotoBase64', 'updatedAt'
              ])) ||
             (diffKeys.hasOnly(['likedByUserIds', 'updatedAt']) && (
               (request.auth.uid in newData.likedByUserIds &&
                !(request.auth.uid in oldData.likedByUserIds) &&
                newData.likedByUserIds.size() == oldData.likedByUserIds.size() + 1) ||
               (!(request.auth.uid in newData.likedByUserIds) &&
                request.auth.uid in oldData.likedByUserIds &&
                newData.likedByUserIds.size() == oldData.likedByUserIds.size() - 1)
             )) ||
             (isAdmin() && diffKeys.hasOnly(['authorName', 'authorHandle', 'updatedAt'])) ||
             (!isAuthor && isLocked && isAdultVerifiedCaller() &&
              diffKeys.hasOnly(['unlockedByUserIds', 'updatedAt']) &&
              request.auth.uid in newData.unlockedByUserIds &&
              (!('unlockedByUserIds' in oldData)
                ? newData.unlockedByUserIds.size() == 1
                : (!(request.auth.uid in oldData.unlockedByUserIds) &&
                   newData.unlockedByUserIds.size() == oldData.unlockedByUserIds.size() + 1))) ||
             (isAuthor && diffKeys.hasOnly(['boostedAtMillis', 'boostedUntilMillis', 'updatedAt']) &&
              isValidBoostWindow(newData) && callerPaidFivePointsInBatch()) ||
             (diffKeys.hasOnly(['commentCount', 'updatedAt']) &&
              (newData.commentCount == existingInt(oldData, 'commentCount') + 1 ||
               (existingInt(oldData, 'commentCount') > 0 &&
                newData.commentCount == existingInt(oldData, 'commentCount') - 1))) ||
             (!isLocked && diffKeys.hasOnly(['shareCount', 'updatedAt']) &&
              newData.shareCount == existingInt(oldData, 'shareCount') + 1);
    }

    function canToggleMessageReaction(rId, newData, oldData) {
      let room = roomDoc(rId).data;
      return oldData.deletedByMod == false &&
             roomExists(rId) &&
             room.status == 'LIVE' &&
             callerPassesProfileChecks(false, false, false, false) &&
             (!(request.auth.uid in room.bannedUserIds) || isAdmin()) &&
             (!isBouncedFromRoom(room, request.auth.uid) || isAdmin()) &&
             newData.diff(oldData).affectedKeys().hasOnly(['reactionsByEmoji', 'updatedAt']);
    }

    function canUpdateDirectThread(threadId, newData, oldData) {
      let diffKeys = newData.diff(oldData).affectedKeys();
      let wasGroup = isThreadGroup(oldData);
      let nowGroup = isThreadGroup(newData);
      return wasGroup == nowGroup && (
        // Action 1: Normal messaging preview / unread / participant display updates (disallowed for new messages if blocked)
        (newData.participantIds == oldData.participantIds &&
         !isKickedFromThread(oldData, request.auth.uid) &&
         (
           (!hasAnyThreadBlock(oldData) &&
            diffKeys.hasOnly([
              'userAName', 'userAColorHex', 'userATier',
              'userBName', 'userBColorHex', 'userBTier',
              'lastMessageText', 'lastMessageSenderId',
              'unreadByUserIds', 'readTimestampsByUserId', 'updatedAt'
            ])) ||
           (hasAnyThreadBlock(oldData) &&
            diffKeys.hasOnly(['unreadByUserIds', 'updatedAt']))
         )) ||
        // Action 2: Add new members or update group name in an existing group chat
        (wasGroup &&
         !isKickedFromThread(oldData, request.auth.uid) &&
         newData.participantIds.hasAll(oldData.participantIds) &&
         newData.participantIds.size() <= 15 &&
         diffKeys.hasOnly([
           'participantIds', 'participantNamesById', 'groupName',
           'lastMessageText', 'lastMessageSenderId', 'unreadByUserIds', 'updatedAt'
         ])) ||
        // Action 3: Recipient kicks a paid DM member from messaging them
        (!wasGroup &&
         newData.participantIds == oldData.participantIds &&
         !isKickedFromThread(newData, request.auth.uid) &&
         diffKeys.hasOnly([
           'kickedUserIds', 'lastMessageText', 'lastMessageSenderId', 'updatedAt'
         ])) ||
        // Action 4: 1-on-1 participant blocks or unblocks contact in this chat (stops incoming messages)
        (!wasGroup &&
         newData.participantIds == oldData.participantIds &&
         diffKeys.hasOnly(['blockedByUserIds', 'unreadByUserIds', 'updatedAt']) &&
         (
           (request.auth.uid in newData.blockedByUserIds &&
            (!('blockedByUserIds' in oldData)
              ? newData.blockedByUserIds.size() == 1
              : (!(request.auth.uid in oldData.blockedByUserIds) &&
                 newData.blockedByUserIds.size() == oldData.blockedByUserIds.size() + 1 &&
                 newData.blockedByUserIds.hasAll(oldData.blockedByUserIds)))) ||
           (!(request.auth.uid in newData.blockedByUserIds) &&
            ('blockedByUserIds' in oldData) &&
            (request.auth.uid in oldData.blockedByUserIds) &&
            newData.blockedByUserIds.size() == oldData.blockedByUserIds.size() - 1 &&
            oldData.blockedByUserIds.hasAll(newData.blockedByUserIds))
         )) ||
        // Action 5: Friend Attention Alert (1-on-1 accepted friends only, max 1 alert every 5 minutes)
        (!wasGroup &&
         newData.participantIds == oldData.participantIds &&
         !hasAnyThreadBlock(oldData) &&
         !isKickedFromThread(oldData, request.auth.uid) &&
         diffKeys.hasOnly(['lastAlertSenderId', 'lastAlertSenderName', 'lastAlertAtMillis', 'updatedAt']) &&
         newData.lastAlertSenderId == request.auth.uid &&
         newData.lastAlertAtMillis > 0 &&
         newData.lastAlertAtMillis <= request.time.toMillis() + 60000 &&
         exists(/databases/$(database)/documents/friendships/$(threadId)) &&
         get(/databases/$(database)/documents/friendships/$(threadId)).data.status == 'ACCEPTED' &&
         (!('lastAlertAtMillis' in oldData) ||
          oldData.lastAlertAtMillis == 0 ||
          oldData.lastAlertSenderId != request.auth.uid ||
          (request.time.toMillis() - oldData.lastAlertAtMillis) >= 300000)) ||
        // Action 6: Participant toggles their own UID in pttEnabledUserIds for live walkie-talkie PTT
        (newData.participantIds == oldData.participantIds &&
         !hasAnyThreadBlock(oldData) &&
         !isKickedFromThread(oldData, request.auth.uid) &&
         diffKeys.hasOnly(['pttEnabledUserIds', 'updatedAt']) &&
         (
           (request.auth.uid in newData.pttEnabledUserIds &&
            (!('pttEnabledUserIds' in oldData)
              ? newData.pttEnabledUserIds.size() == 1
              : (!(request.auth.uid in oldData.pttEnabledUserIds) &&
                 newData.pttEnabledUserIds.size() == oldData.pttEnabledUserIds.size() + 1 &&
                 newData.pttEnabledUserIds.hasAll(oldData.pttEnabledUserIds)))) ||
           (!(request.auth.uid in newData.pttEnabledUserIds) &&
            ('pttEnabledUserIds' in oldData) &&
            (request.auth.uid in oldData.pttEnabledUserIds) &&
            newData.pttEnabledUserIds.size() == oldData.pttEnabledUserIds.size() - 1 &&
            oldData.pttEnabledUserIds.hasAll(newData.pttEnabledUserIds))
         )) ||
        // Action 7: Participant updates disappearing messages timer for this chat
        (newData.participantIds == oldData.participantIds &&
         !hasAnyThreadBlock(oldData) &&
         !isKickedFromThread(oldData, request.auth.uid) &&
         diffKeys.hasOnly(['disappearingDurationSec', 'updatedAt'])) ||
        // Action 8: Participant toggles their own UID in readReceiptsDisabledByUserIds
        (newData.participantIds == oldData.participantIds &&
         !hasAnyThreadBlock(oldData) &&
         !isKickedFromThread(oldData, request.auth.uid) &&
         diffKeys.hasOnly(['readReceiptsDisabledByUserIds', 'updatedAt']) &&
         (
           (request.auth.uid in newData.readReceiptsDisabledByUserIds &&
            (!('readReceiptsDisabledByUserIds' in oldData)
              ? newData.readReceiptsDisabledByUserIds.size() == 1
              : (!(request.auth.uid in oldData.readReceiptsDisabledByUserIds) &&
                 newData.readReceiptsDisabledByUserIds.size() == oldData.readReceiptsDisabledByUserIds.size() + 1 &&
                 newData.readReceiptsDisabledByUserIds.hasAll(oldData.readReceiptsDisabledByUserIds)))) ||
           (!(request.auth.uid in newData.readReceiptsDisabledByUserIds) &&
            ('readReceiptsDisabledByUserIds' in oldData) &&
            (request.auth.uid in oldData.readReceiptsDisabledByUserIds) &&
            newData.readReceiptsDisabledByUserIds.size() == oldData.readReceiptsDisabledByUserIds.size() - 1 &&
            oldData.readReceiptsDisabledByUserIds.hasAll(newData.readReceiptsDisabledByUserIds))
         ))
      );
    }

    function canSendMessageInThread(threadData) {
      return request.auth.uid in threadData.participantIds &&
             !isKickedFromThread(threadData, request.auth.uid) &&
             (isThreadGroup(threadData) || (!hasAnyThreadBlock(threadData) && canMessageUser(otherOneOnOneUid(threadData))));
    }

    // --- 1. USERS COLLECTION ---
    match /users/{userId} {
      allow get: if isSignedIn() &&
                    isValidId(userId) &&
                    (request.auth.uid == userId || isAdminOrSupport());

      allow list: if isSignedIn() && isAdmin();

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       hasNoSelfRestrictionOverrides(incoming()) &&
                       (!('invisibleModePreferred' in incoming()) || !incoming().invisibleModePreferred || canUseInvisibleMode()) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                          // Action 1: Owner updates their own preferences/profile (cannot bypass bans/suspensions/restrictions or picture upload rate limit)
                         (request.auth.uid == userId &&
                          (!('invisibleModePreferred' in incoming()) || !incoming().invisibleModePreferred || canUseInvisibleMode()) &&
                          canUpdatePictureUploadTimestamps(incoming(), existing()) &&
                          (!('photoBase64' in incoming().diff(existing()).affectedKeys()) ||
                           incoming().photoBase64.size() == 0 ||
                           callerUnderPictureUploadLimit()) &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'displayName', 'handle', 'bio', 'avatarColorHex', 'photoBase64',
                            'pushToTalkPreferred', 'darkThemePreferred', 'nightModeEnabled',
                            'invisibleModePreferred', 'dmPolicy', 'adultVerified', 'birthYear',
                            'blockedUserIds', 'pictureUploadTimestamps', 'updatedAt'
                          ])) ||
                         // Action 1b: Owner buys points (2..500 pts at $1/pt), spends 2 pts to unlock photo, or pays $15/mo subscription
                         (request.auth.uid == userId &&
                          isValidOwnerWalletUpdate(incoming(), existing())) ||
                         // Action 2: Admin edits any user's profile, restrictions, global ban, or suspension
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'displayName', 'handle', 'bio', 'avatarColorHex', 'photoBase64',
                            'invisibleModePreferred', 'globallyBanned',
                            'disableCreateRoom', 'disableEnterRoom',
                            'disableMic', 'disableVideo',
                            'suspendedUntilMillis', 'suspensionReason', 'updatedAt'
                          ])) ||
                         // Action 3: Support staff applies or updates timed suspension on non-admin users
                         (isSupport() &&
                          !isTargetAdmin(userId) &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'suspendedUntilMillis', 'suspensionReason', 'updatedAt'
                          ])) ||
                         // Action 4: Buyer credits creator's earnings share ($1.00 = 100c for 2-pt photo unlock, or $7.50 = 750c for $15 subscription)
                         (request.auth.uid != userId &&
                          isValidCreatorEarningsCredit(incoming(), existing()))
                       );

      allow delete: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
    }

    // --- 1b. STAFF ROLES (Admin & Support Registry) ---
    match /staffRoles/{userId} {
      allow get: if isSignedIn() &&
                    isValidId(userId) &&
                    (request.auth.uid == userId || isAdmin());

      allow list: if isSignedIn() &&
                     (isAdmin() || resource.data.userId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       incoming().userId == userId &&
                       isValidStaffRole(incoming()) && (
                         // Admin directly assigning ADMIN or SUPPORT role (with optional canEnterInvisible)
                         isAdmin() ||
                         // Invited user claiming their ADMIN or SUPPORT role via verified email invite
                         (request.auth.uid == userId &&
                          'inviteId' in incoming() &&
                          isValidId(incoming().inviteId) &&
                          hasVerifiedEmail() &&
                          exists(/databases/$(database)/documents/staffInvites/$(incoming().inviteId)) &&
                          get(/databases/$(database)/documents/staffInvites/$(incoming().inviteId)).data.email == request.auth.token.email &&
                          incoming().staffTier == get(/databases/$(database)/documents/staffInvites/$(incoming().inviteId)).data.staffTier &&
                          (
                            incoming().staffTier == 'ADMIN' ||
                            !('canEnterInvisible' in incoming()) ||
                            incoming().canEnterInvisible == false ||
                            (('canEnterInvisible' in get(/databases/$(database)/documents/staffInvites/$(incoming().inviteId)).data) &&
                             get(/databases/$(database)/documents/staffInvites/$(incoming().inviteId)).data.canEnterInvisible == true)
                          ))
                       );

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidStaffRole(incoming()) &&
                       isAdmin() &&
                       (existing().email != 'daj18801@gmail.com' || isBootstrappedAdmin()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'email', 'displayName', 'staffTier', 'canEnterInvisible', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() &&
                       isValidId(userId) &&
                       isAdmin() &&
                       (existing().email != 'daj18801@gmail.com' || isBootstrappedAdmin());
    }

    // --- 1c. STAFF INVITES (Email-based Admin & Support Staff Invitations) ---
    match /staffInvites/{inviteId} {
      allow get: if isSignedIn() &&
                    isValidId(inviteId) &&
                    (isAdmin() ||
                     (resource != null &&
                      hasVerifiedEmail() &&
                      existing().email == request.auth.token.email));

      allow list: if isSignedIn() &&
                     (isAdmin() ||
                      (hasVerifiedEmail() &&
                       resource.data.email == request.auth.token.email));

      allow create: if isSignedIn() &&
                       isValidId(inviteId) &&
                       isAdmin() &&
                       incoming().addedByUid == request.auth.uid &&
                       isValidStaffInvite(incoming());

      allow update: if isSignedIn() &&
                       isValidId(inviteId) &&
                       isAdmin() &&
                       isValidStaffInvite(incoming()) &&
                       incoming().email == existing().email &&
                       incoming().addedByUid == existing().addedByUid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'canEnterInvisible'
                       ]);

      allow delete: if isSignedIn() && isValidId(inviteId) && isAdmin();
    }

    // --- 1d. USER ALERTS (Admin & Support Alerts; Editable & Deletable by Admin) ---
    match /userAlerts/{alertId} {
      allow get: if isSignedIn() &&
                    isValidId(alertId) &&
                    (resource == null ||
                     existing().targetUserId == request.auth.uid ||
                     existing().senderId == request.auth.uid ||
                     isAdmin());

      allow list: if isSignedIn() &&
                     (resource.data.targetUserId == request.auth.uid ||
                      resource.data.senderId == request.auth.uid ||
                      isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(alertId) &&
                       isAdminOrSupport() &&
                       incoming().senderId == request.auth.uid &&
                       incoming().acknowledged == false &&
                       ((incoming().senderTier == 'ADMIN' && isAdmin()) ||
                        (incoming().senderTier == 'SUPPORT' && isAdminOrSupport())) &&
                       isValidUserAlert(incoming());

      allow update: if isSignedIn() &&
                       isValidId(alertId) &&
                       isValidUserAlert(incoming()) &&
                       incoming().targetUserId == existing().targetUserId &&
                       incoming().senderId == existing().senderId &&
                       incoming().createdAt == existing().createdAt && (
                         // Recipient acknowledges unread alert
                         (existing().acknowledged == false &&
                          incoming().acknowledged == true &&
                          existing().targetUserId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['acknowledged', 'updatedAt'])) ||
                         // Admin edits alert title, message, severity, or re-opens acknowledged state
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'title', 'message', 'severity', 'acknowledged', 'updatedAt'
                          ]))
                       );

      allow delete: if isSignedIn() && isValidId(alertId) && isAdmin();
    }

    // --- 2. ROOMS COLLECTION ---
    match /rooms/{roomId} {
      allow get: if isValidId(roomId) && (
                    (resource != null && existing().visibility == 'PUBLIC') ||
                    (isSignedIn() &&
                     (resource == null ||
                      existing().hostId == request.auth.uid ||
                      request.auth.uid in existing().moderatorIds ||
                      isAdminOrSupport()))
                  );

      allow list: if resource.data.visibility == 'PUBLIC' ||
                     (isSignedIn() &&
                      (resource.data.hostId == request.auth.uid ||
                       isAdmin()));

      allow create: if isSignedIn() &&
                       isValidId(roomId) &&
                       incoming().hostId == request.auth.uid &&
                       incoming().status == 'LIVE' &&
                       incoming().title.size() >= 3 &&
                       (!('adminMicPriorityActive' in incoming()) || incoming().adminMicPriorityActive == false) &&
                       callerPassesProfileChecks(true, false, false, false) &&
                       (!('hostTier' in incoming()) || isAllowedStaffTierClaim(incoming().hostTier)) &&
                       isValidRoom(incoming());

      allow update: if isSignedIn() &&
                       isValidId(roomId) &&
                       isValidRoom(incoming()) &&
                       existing().status == 'LIVE' &&
                       incoming().hostId == existing().hostId &&
                       incoming().createdAt == existing().createdAt && (
                          // Action 1a: Global App Owner Admin full control (including exclusive adminMicPriorityActive & 24h bounces)
                         (isAdmin() &&
                          incoming().status == 'LIVE' &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'title', 'topic', 'category', 'coverKey', 'visibility',
                            'videoEnabled', 'autoModEnabled', 'autoModBlockMode',
                            'linksBlocked', 'roomLocked', 'stageMicLocked',
                            'adminMicPriorityActive', 'slowModeSeconds', 'maxSpeakers',
                            'moderatorIds', 'bannedUserIds', 'bouncedUntilByUserId', 'mutedUserIds', 'blockedWords', 'updatedAt'
                          ])) ||
                         // Action 1b: Room Administrator (Creator) — change/delete room name, add co-admins, ban, kick, mute
                         (existing().hostId == request.auth.uid &&
                          incoming().status == 'LIVE' &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'title', 'topic', 'category', 'coverKey', 'visibility',
                            'videoEnabled', 'autoModEnabled', 'autoModBlockMode',
                            'linksBlocked', 'roomLocked', 'stageMicLocked',
                            'slowModeSeconds', 'maxSpeakers', 'moderatorIds',
                            'bannedUserIds', 'bouncedUntilByUserId', 'mutedUserIds', 'blockedWords', 'updatedAt'
                          ])) ||
                         // Action 2: Room Co-Admin or Global Support — mute, kick/24h bounce, safety toggles (NO ban, NO rename, NO close)
                         ((request.auth.uid in existing().moderatorIds || isSupport()) &&
                          existing().hostId != request.auth.uid &&
                          incoming().status == 'LIVE' &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'topic', 'videoEnabled', 'autoModEnabled', 'autoModBlockMode',
                            'linksBlocked', 'roomLocked', 'stageMicLocked',
                            'slowModeSeconds', 'bouncedUntilByUserId', 'mutedUserIds',
                            'blockedWords', 'updatedAt'
                          ])) ||
                         // Action 3: Room Admin or Global App Admin closes room (terminal transition)
                         ((existing().hostId == request.auth.uid || isAdmin()) &&
                          incoming().status == 'CLOSED' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
                         // Action 4: Non-banned participant count increment/decrement on join/leave/bounce/kick
                         ((!(request.auth.uid in existing().bannedUserIds) || isAdminOrSupport()) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['participantCount', 'updatedAt']) &&
                          (incoming().participantCount == existing().participantCount + 1 ||
                           incoming().participantCount == existing().participantCount - 1))
                       );

      allow delete: if isSignedIn() && isValidId(roomId) && (existing().hostId == request.auth.uid || isAdmin());

      // --- 2a. ROOM PARTICIPANTS SUBCOLLECTION ---
      match /participants/{participantId} {
        allow get: if isSignedIn() &&
                      isValidId(roomId) &&
                      isValidId(participantId) &&
                      (resource == null
                        ? (participantId == request.auth.uid || isRoomHostOrMod(roomId))
                        : existing().roomId == roomId);
        allow list: if isSignedIn() && resource.data.roomId == roomId;

        function canCreateParticipant(rId, pId, data) {
          let adminCaller = isAdmin();
          let room = roomDoc(rId).data;
          let isRoomStaff = room.hostId == request.auth.uid || request.auth.uid in room.moderatorIds || adminCaller || isSupport();
          let inv = ('invisible' in data) && data.invisible;
          return pId == request.auth.uid &&
                 data.userId == request.auth.uid &&
                 data.roomId == rId &&
                 isValidParticipant(data) &&
                 (!inv || adminCaller || canUseInvisibleMode()) &&
                 (!inv || !data.micActive || adminCaller) &&
                 (!('staffTier' in data) || isAllowedStaffTierClaim(data.staffTier)) &&
                 (adminCaller || !callerProfileExists() || isProfileAllowed(callerProfile(), false, true, data.micActive, data.camActive)) &&
                 room.status == 'LIVE' &&
                 (!(request.auth.uid in room.bannedUserIds) || adminCaller) &&
                 (!isBouncedFromRoom(room, request.auth.uid) || adminCaller) &&
                 (!room.roomLocked || isRoomStaff) &&
                 (
                   (data.role == 'HOST' && room.hostId == request.auth.uid) ||
                   (data.role == 'MODERATOR' && isRoomStaff) ||
                   (data.role in ['SPEAKER', 'LISTENER'])
                 ) &&
                 (data.mutedByMod == (request.auth.uid in room.mutedUserIds)) &&
                 (!data.mutedByMod || !data.micActive || adminCaller) &&
                 (!data.micActive || adminCaller || !('adminMicPriorityActive' in room) || !room.adminMicPriorityActive);
        }

        function canUpdateParticipant(rId, pId, data, oldData) {
          let adminCaller = isAdmin();
          let room = roomDoc(rId).data;
          let inv = ('invisible' in data) && data.invisible;
          let adminMicLock = ('adminMicPriorityActive' in room) && room.adminMicPriorityActive == true;
          return isValidParticipant(data) &&
                 data.userId == oldData.userId &&
                 data.roomId == oldData.roomId &&
                 data.joinedAt == oldData.joinedAt &&
                 (!inv || adminCaller || canUseInvisibleMode()) &&
                 (!inv || !data.micActive || adminCaller) && (
                   // Action 1: Self media/presence controls (and authorized invisible toggle)
                   (request.auth.uid == pId &&
                    (!oldData.mutedByMod || !data.micActive || adminCaller) &&
                    (!data.micActive || adminCaller || !adminMicLock) &&
                    (adminCaller || !callerProfileExists() || isProfileAllowed(callerProfile(), false, false, data.micActive, data.camActive)) &&
                    (!('staffTier' in data) || isAllowedStaffTierClaim(data.staffTier)) &&
                    data.diff(oldData).affectedKeys().hasOnly([
                      'displayName', 'avatarColorHex', 'staffTier', 'invisible',
                      'micActive', 'camActive', 'handRaised', 'speakingLevel', 'updatedAt'
                    ])) ||
                   // Action 2: Room Admin/Co-Admin/Admin/Support moderating OTHER participants (can mute/demote; Admin can also update displayName)
                   (request.auth.uid != pId &&
                    (room.hostId == request.auth.uid || request.auth.uid in room.moderatorIds || adminCaller || isSupport()) &&
                    (!isTargetAdmin(pId) || adminCaller) &&
                    (!data.micActive || oldData.micActive == data.micActive) &&
                    (!('displayName' in data.diff(oldData).affectedKeys()) || adminCaller) &&
                    data.diff(oldData).affectedKeys().hasOnly([
                      'displayName', 'role', 'staffTier', 'micActive', 'camActive', 'handRaised',
                      'mutedByMod', 'updatedAt'
                    ]))
                 );
        }

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(participantId) &&
                         roomExists(roomId) &&
                         canCreateParticipant(roomId, participantId, incoming());

        allow update: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(participantId) &&
                         roomExists(roomId) &&
                         canUpdateParticipant(roomId, participantId, incoming(), existing());

        allow delete: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(participantId) &&
                         (request.auth.uid == participantId ||
                          (isRoomHostOrMod(roomId) && (!isTargetAdmin(participantId) || isAdmin())));
      }

      // --- 2b. ROOM MESSAGES SUBCOLLECTION ---
      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(messageId) && existing().roomId == roomId;
        allow list: if isSignedIn() && resource.data.roomId == roomId;

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(messageId) &&
                         incoming().roomId == roomId &&
                         incoming().senderId == request.auth.uid &&
                         incoming().deletedByMod == false &&
                         callerPassesProfileChecks(false, false, false, false) &&
                         (!('senderTier' in incoming()) || isAllowedStaffTierClaim(incoming().senderTier)) &&
                         isValidMessage(incoming()) &&
                         roomExists(roomId) &&
                         roomDoc(roomId).data.status == 'LIVE' &&
                         (!(request.auth.uid in roomDoc(roomId).data.bannedUserIds) || isAdmin()) &&
                         (!isBouncedFromRoom(roomDoc(roomId).data, request.auth.uid) || isAdmin()) &&
                         (!(request.auth.uid in roomDoc(roomId).data.mutedUserIds) || isAdmin());

        allow update: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(messageId) &&
                         isValidMessage(incoming()) &&
                         incoming().roomId == existing().roomId &&
                         incoming().senderId == existing().senderId &&
                         incoming().createdAt == existing().createdAt && (
                           (isRoomHostOrMod(roomId) &&
                            incoming().deletedByMod == true &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['text', 'deletedByMod', 'updatedAt'])) ||
                           canToggleMessageReaction(roomId, incoming(), existing())
                         );

        allow delete: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(messageId) &&
                         (existing().senderId == request.auth.uid || isRoomHostOrMod(roomId));
      }

      // --- 2c. ROOM MODERATION AUDIT LOGS SUBCOLLECTION ---
      match /modLogs/{logId} {
        allow get: if isSignedIn() && isValidId(roomId) && isValidId(logId) && existing().roomId == roomId;
        allow list: if isSignedIn() && resource.data.roomId == roomId;

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(logId) &&
                         incoming().roomId == roomId &&
                         incoming().actorId == request.auth.uid &&
                         isValidModLog(incoming()) &&
                         roomExists(roomId) &&
                         (incoming().actionType == 'AUTO_MOD' || isRoomHostOrMod(roomId));

        allow update, delete: if false;
      }
    }

    // --- 3. SAFETY REPORTS COLLECTION ---
    match /safetyReports/{reportId} {
      allow get: if isSignedIn() &&
                    isValidId(reportId) &&
                    (existing().reporterId == request.auth.uid ||
                     existing().roomHostId == request.auth.uid ||
                     isAdminOrSupport());

      allow list: if isSignedIn() &&
                     (resource.data.reporterId == request.auth.uid ||
                      resource.data.roomHostId == request.auth.uid ||
                      isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(reportId) &&
                       incoming().reporterId == request.auth.uid &&
                       incoming().status == 'OPEN' &&
                       incoming().resolutionNote == '' &&
                       isValidSafetyReport(incoming()) &&
                       roomExists(incoming().roomId) &&
                       roomDoc(incoming().roomId).data.hostId == incoming().roomHostId;

      allow update: if isSignedIn() &&
                       isValidId(reportId) &&
                       isValidSafetyReport(incoming()) &&
                       existing().status == 'OPEN' &&
                       incoming().status in ['RESOLVED', 'DISMISSED'] &&
                       incoming().reporterId == existing().reporterId &&
                       incoming().roomId == existing().roomId &&
                       incoming().roomHostId == existing().roomHostId &&
                       incoming().createdAt == existing().createdAt &&
                       (existing().roomHostId == request.auth.uid ||
                        existing().reporterId == request.auth.uid ||
                        isAdminOrSupport()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'resolutionNote', 'updatedAt']);

      allow delete: if false;
    }

    // --- 4. PUBLIC USER DIRECTORY (Non-sensitive friend discovery & 1-day trial preview) ---
    match /userDirectory/{userId} {
      allow get, list: if true;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       incoming().userId == userId &&
                       isValidDirectoryEntry(incoming()) && (
                         (request.auth.uid == userId &&
                          isAllowedStaffTierClaim(incoming().staffTier)) ||
                         isAdmin()
                       );

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       isValidDirectoryEntry(incoming()) && (
                         (request.auth.uid == userId &&
                          isAllowedStaffTierClaim(incoming().staffTier)) ||
                         isAdmin()
                       );

      allow delete: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
    }

    // --- 5. FRIENDSHIPS & FRIEND REQUESTS ---
    match /friendships/{friendshipId} {
      allow get: if isSignedIn() &&
                    (resource == null ||
                     request.auth.uid in existing().userIds ||
                     isAdmin());

      allow list: if isSignedIn() &&
                     request.auth.uid in resource.data.userIds;

      allow create: if isSignedIn() &&
                       incoming().requesterId == request.auth.uid &&
                       incoming().status == 'PENDING' &&
                       isAllowedStaffTierClaim(incoming().requesterTier) &&
                       isValidFriendship(incoming());

      allow update: if isSignedIn() &&
                       isValidFriendship(incoming()) &&
                       incoming().userIds == existing().userIds &&
                       incoming().requesterId == existing().requesterId &&
                       incoming().recipientId == existing().recipientId &&
                       incoming().createdAt == existing().createdAt &&
                       existing().status == 'PENDING' &&
                       incoming().status == 'ACCEPTED' &&
                       existing().recipientId == request.auth.uid &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'status', 'recipientName', 'recipientHandle',
                         'recipientColorHex', 'recipientTier', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() &&
                       (request.auth.uid in existing().userIds || isAdmin());
    }

    // --- 6. DIRECT PRIVATE MESSAGE & GROUP CHAT THREADS ---
    match /directThreads/{threadId} {
      allow get: if isSignedIn() &&
                    (resource == null ||
                     request.auth.uid in existing().participantIds ||
                     isAdmin());

      allow list: if isSignedIn() &&
                     request.auth.uid in resource.data.participantIds;

      allow create: if isSignedIn() &&
                       request.auth.uid in incoming().participantIds &&
                       callerPassesProfileChecks(false, false, false, false) &&
                       isValidDirectThread(incoming()) &&
                       (isThreadGroup(incoming()) ||
                        (!isBlockedBetween(request.auth.uid, otherOneOnOneUid(incoming())) &&
                         canMessageUser(otherOneOnOneUid(incoming()))));

      allow update: if isSignedIn() &&
                       request.auth.uid in existing().participantIds &&
                       isValidDirectThread(incoming()) &&
                       incoming().userAId == existing().userAId &&
                       incoming().userBId == existing().userBId &&
                       incoming().createdAt == existing().createdAt &&
                       canUpdateDirectThread(threadId, incoming(), existing());

      allow delete: if isSignedIn() &&
                       (request.auth.uid in existing().participantIds || isAdmin());

      match /messages/{messageId} {
        allow get: if isSignedIn() &&
                      isValidId(messageId) &&
                      request.auth.uid in existing().participantIds;

        // Single-filter rule matching client whereArrayContains("participantIds", uid) — zero composite indexes!
        allow list: if isSignedIn() &&
                       request.auth.uid in resource.data.participantIds;

        allow create: if isSignedIn() &&
                         isValidId(messageId) &&
                         incoming().threadId == threadId &&
                         incoming().senderId == request.auth.uid &&
                         request.auth.uid in incoming().participantIds &&
                         isAllowedStaffTierClaim(incoming().senderTier) &&
                         callerPassesProfileChecks(false, false, false, false) &&
                         (!('imageBase64' in incoming()) || incoming().imageBase64.size() == 0 || callerUnderPictureUploadLimit()) &&
                         isValidDirectMessage(incoming()) &&
                         exists(/databases/$(database)/documents/directThreads/$(threadId)) &&
                         canSendMessageInThread(get(/databases/$(database)/documents/directThreads/$(threadId)).data);

        allow update: if false;

        allow delete: if isSignedIn() &&
                         isValidId(messageId) &&
                         (existing().senderId == request.auth.uid || isAdmin());
      }
    }

    // --- 6b. PAID PRIVATE MESSAGE ACCESS PASSES ($10 = $5 user / $5 app owner, kickable by recipient) ---
    match /dmAccessPasses/{passId} {
      allow get: if isSignedIn() &&
                    (resource == null ||
                     existing().senderId == request.auth.uid ||
                     existing().recipientId == request.auth.uid ||
                     isAdmin());

      allow list: if isSignedIn() &&
                     (resource.data.senderId == request.auth.uid ||
                      resource.data.recipientId == request.auth.uid ||
                      isAdmin());

      allow create: if isSignedIn() &&
                       incoming().senderId == request.auth.uid &&
                       incoming().senderId != incoming().recipientId &&
                       passId == incoming().senderId + '_' + incoming().recipientId &&
                       incoming().active == true &&
                       incoming().kicked == false &&
                       isValidDmAccessPass(incoming());

      allow update: if isSignedIn() &&
                       isValidDmAccessPass(incoming()) &&
                       incoming().senderId == existing().senderId &&
                       incoming().recipientId == existing().recipientId &&
                       incoming().priceCents == existing().priceCents &&
                       incoming().creatorShareCents == existing().creatorShareCents &&
                       incoming().platformShareCents == existing().platformShareCents &&
                       incoming().createdAt == existing().createdAt &&
                       (existing().recipientId == request.auth.uid || isAdmin()) &&
                       incoming().active == false &&
                       incoming().kicked == true &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['active', 'kicked', 'updatedAt']);

      allow delete: if isSignedIn() &&
                       (existing().recipientId == request.auth.uid || isAdmin());
    }

    // --- 7. PROFILE POSTS (Public Updates, Pictures, Comments, Shares & Discovery Boosts) ---
    match /profilePosts/{postId} {
      allow get: if isSignedIn() ||
                    (resource != null && (!('locked' in resource.data) || resource.data.locked == false));

      allow list: if isSignedIn() || resource.data.locked == false;

      allow create: if isSignedIn() &&
                       isValidId(postId) &&
                       incoming().authorId == request.auth.uid &&
                       incoming().likedByUserIds.size() == 0 &&
                       (!('unlockedByUserIds' in incoming()) || incoming().unlockedByUserIds.size() == 0) &&
                       (!('commentCount' in incoming()) || incoming().commentCount == 0) &&
                       (!('shareCount' in incoming()) || incoming().shareCount == 0) &&
                       (
                         !('sharedFromPostId' in incoming()) ||
                         incoming().sharedFromPostId == '' ||
                         ((!('locked' in incoming()) || incoming().locked == false) &&
                          isOriginalPostShareable(incoming().sharedFromPostId))
                       ) &&
                       (
                         ((!('boostedAtMillis' in incoming()) || incoming().boostedAtMillis == 0) &&
                          (!('boostedUntilMillis' in incoming()) || incoming().boostedUntilMillis == 0)) ||
                         (isValidBoostWindow(incoming()) && callerPaidFivePointsInBatch())
                       ) &&
                       (!('locked' in incoming()) || incoming().locked == false || isAdultVerifiedCaller()) &&
                       (incoming().imageBase64.size() == 0 || callerUnderPictureUploadLimit()) &&
                       isAllowedStaffTierClaim(incoming().authorTier) &&
                       callerPassesProfileChecks(false, false, false, false) &&
                       isValidProfilePost(incoming());

      allow update: if isSignedIn() &&
                       isValidId(postId) &&
                       incoming().authorId == existing().authorId &&
                       incoming().createdAt == existing().createdAt &&
                       canUpdateProfilePost(incoming(), existing()) &&
                       isValidProfilePost(incoming());

      allow delete: if isSignedIn() &&
                       isValidId(postId) &&
                       (existing().authorId == request.auth.uid || isAdminOrSupport());

      // --- 7a. POST COMMENTS SUBCOLLECTION ---
      match /comments/{commentId} {
        allow get, list: if isSignedIn();

        allow create: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         incoming().postId == postId &&
                         incoming().authorId == request.auth.uid &&
                         isAllowedStaffTierClaim(incoming().authorTier) &&
                         callerPassesProfileChecks(false, false, false, false) &&
                         isValidPostComment(incoming()) &&
                         exists(/databases/$(database)/documents/profilePosts/$(postId));

        allow update: if false;

        allow delete: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         (existing().authorId == request.auth.uid ||
                          (exists(/databases/$(database)/documents/profilePosts/$(postId)) &&
                           get(/databases/$(database)/documents/profilePosts/$(postId)).data.authorId == request.auth.uid) ||
                          isAdminOrSupport());
      }
    }

    // --- 8. CREATOR SUBSCRIPTIONS ($15/month unlocks all locked photos by creator) ---
    match /creatorSubscriptions/{subId} {
      allow get: if isSignedIn() &&
                    (resource == null ||
                     existing().subscriberId == request.auth.uid ||
                     existing().creatorId == request.auth.uid ||
                     isAdmin());

      allow list: if isSignedIn() &&
                     (resource.data.subscriberId == request.auth.uid ||
                      resource.data.creatorId == request.auth.uid ||
                      isAdmin());

      allow create: if isSignedIn() &&
                       incoming().subscriberId == request.auth.uid &&
                       incoming().subscriberId != incoming().creatorId &&
                       subId == incoming().subscriberId + '_' + incoming().creatorId &&
                       incoming().active == true &&
                       isAdultVerifiedCaller() &&
                       isValidCreatorSubscription(incoming());

      allow update: if isSignedIn() &&
                       existing().subscriberId == request.auth.uid &&
                       incoming().subscriberId == existing().subscriberId &&
                       incoming().creatorId == existing().creatorId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidCreatorSubscription(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'creatorName', 'active', 'expiresAtMillis', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() &&
                       (existing().subscriberId == request.auth.uid || isAdmin());
    }

    // --- 9. POINT TRANSACTIONS & REVENUE SPLIT LEDGER (Append-Only) ---
    match /pointTransactions/{txId} {
      allow get: if isSignedIn() &&
                    isValidId(txId) &&
                    (resource == null ||
                     existing().buyerId == request.auth.uid ||
                     existing().creatorId == request.auth.uid ||
                     isAdmin());

      allow list: if isSignedIn() &&
                     (resource.data.buyerId == request.auth.uid ||
                      resource.data.creatorId == request.auth.uid ||
                      isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(txId) &&
                       incoming().buyerId == request.auth.uid &&
                       isValidPointTransaction(incoming());

      allow update, delete: if false;
    }

    // --- 10. GLOBAL APP CONFIG (Login Screen News Banner & Trial Login Toggle) ---
    match /appConfig/{configId} {
      allow get: if configId == 'global';
      allow list: if false;

      allow create, update: if isSignedIn() &&
                               isAdmin() &&
                               configId == 'global' &&
                               isValidAppConfig(incoming());

      allow delete: if false;
    }

    // --- 11. ADMIN ROOM TRANSFERS (Send User to a Different Room) ---
    match /roomTransfers/{userId} {
      allow get: if isSignedIn() &&
                    isValidId(userId) &&
                    (request.auth.uid == userId || isAdmin());

      allow list: if isSignedIn() && isAdmin();

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       isAdmin() &&
                       incoming().movedByAdminId == request.auth.uid &&
                       incoming().consumed == false &&
                       isValidRoomTransfer(incoming(), userId);

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidRoomTransfer(incoming(), userId) && (
                         (isAdmin() &&
                          incoming().movedByAdminId == request.auth.uid) ||
                         (request.auth.uid == userId &&
                          existing().consumed == false &&
                          incoming().consumed == true &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['consumed']))
                       );

      allow delete: if isSignedIn() &&
                       isValidId(userId) &&
                       (request.auth.uid == userId || isAdmin());
    }

    // --- 12. SUPPORT TICKETS (Created from Discovery Support Tab, managed by Admin/Support) ---
    match /supportTickets/{ticketId} {
      allow get: if isSignedIn() &&
                    isValidId(ticketId) &&
                    (resource == null ||
                     existing().requesterId == request.auth.uid ||
                     isAdminOrSupport());

      allow list: if isSignedIn() &&
                     (resource.data.requesterId == request.auth.uid ||
                      isAdminOrSupport());

      allow create: if isSignedIn() &&
                       isValidId(ticketId) &&
                       incoming().requesterId == request.auth.uid &&
                       isAllowedStaffTierClaim(incoming().requesterTier) &&
                       incoming().status == 'OPEN' &&
                       incoming().staffResponse == '' &&
                       isValidSupportTicket(incoming());

      allow update: if isSignedIn() &&
                       isValidId(ticketId) &&
                       isValidSupportTicket(incoming()) &&
                       incoming().requesterId == existing().requesterId &&
                       incoming().createdAt == existing().createdAt && (
                         (isAdminOrSupport() &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'staffResponse', 'assignedStaffId', 'assignedStaffName', 'updatedAt'
                          ])) ||
                         (existing().requesterId == request.auth.uid &&
                          incoming().status == 'RESOLVED' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(ticketId) && isAdmin();
    }
  }
}
